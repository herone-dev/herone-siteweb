---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerTheme?: 'dark' | 'light';
  noindex?: boolean;
  /** Nœuds JSON-LD propres à la page (pages villes : service, fil d'Ariane,
      FAQ), publiés dans un second graphe à côté de celui du site. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, headerTheme = 'light', noindex = false, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Mesure d'audience Google Analytics 4, en mode de consentement avancé
         (Consent Mode v2). Avant tout choix, et après un refus, GA4 ne dépose
         aucun cookie : il n'envoie que des signaux sans identifiant, à partir
         desquels Google modélise les visites. Après « Accepter », les cookies
         de mesure sont autorisés. Les cookies publicitaires restent refusés
         dans tous les cas, le site ne fait pas de publicité.
         send_page_view est coupé : avec les transitions de page d'Astro, GA4
         ne voyait que la première page de chaque visite. Les pages vues et
         tous les événements du plan de marquage sont envoyés par
         src/scripts/suivi.ts. Détail dans docs/plan-de-marquage.md. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var hrnChoix = null;
      try { hrnChoix = window.localStorage.getItem('hrn-cookie'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: hrnChoix === 'accepted' ? 'granted' : 'denied',
        wait_for_update: 500
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('js', new Date());
      gtag('config', 'G-GT6JCYY2SF', { send_page_view: false });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GT6JCYY2SF"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preconnect pour améliorer le LCP / TBT des ressources tierces -->
    <link rel="preconnect" href="https://assets.calendly.com" crossorigin />
    <link rel="dns-prefetch" href="https://assets.calendly.com" />
    <link rel="preconnect" href="https://calendly.com" crossorigin />

    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="icon" type="image/jpg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Blog Hérone" href="https://herone.fr/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://framerusercontent.com/assets/GfaJExWm66OTZNYZXcbpxcY3o.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://framerusercontent.com/assets/GfaJExWm66OTZNYZXcbpxcY3o.jpg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LocalBusiness",
          "@id": "https://herone.fr/#organization",
          "name": "Hérone",
          "url": "https://herone.fr",
          "logo": "https://herone.fr/favicon.png",
          "image": "https://herone.fr/favicon.png",
          "description": description,
          "telephone": "+33663710598",
          "email": "contact@herone.fr",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "37 rue Édouard Branly",
            "addressLocality": "Les Herbiers",
            "postalCode": "85500",
            "addressRegion": "Vendée",
            "addressCountry": "FR"
          },
          "areaServed": [
            { "@type": "City", "name": "Les Herbiers" },
            { "@type": "City", "name": "Montaigu" },
            { "@type": "City", "name": "Chantonnay" },
            { "@type": "City", "name": "Pouzauges" },
            { "@type": "City", "name": "Mortagne-sur-Sèvre" },
            { "@type": "City", "name": "La Roche-sur-Yon" },
            { "@type": "City", "name": "Cholet" },
            { "@type": "AdministrativeArea", "name": "Vendée" },
            { "@type": "AdministrativeArea", "name": "Choletais" }
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://herone.fr/#website",
          "url": "https://herone.fr",
          "name": "Hérone",
          "publisher": {
            "@id": "https://herone.fr/#organization"
          },
          "inLanguage": "fr-FR",
          "hasPart": [
            {
              "@type": "WebPage",
              "name": "Formation IA en entreprise",
              "url": "https://herone.fr/formation"
            },
            {
              "@type": "WebPage",
              "name": "Automatisation IA",
              "url": "https://herone.fr/automatisation"
            },
            {
              "@type": "WebPage",
              "name": "Blog",
              "url": "https://herone.fr/blog"
            },
            {
              "@type": "WebPage",
              "name": "Réserver un appel",
              "url": "https://herone.fr/#reserver"
            }
          ]
        },
        {
          "@type": "ItemList",
          "@id": "https://herone.fr/#sitenavigation",
          "name": "Navigation principale",
          "itemListElement": [
            {
              "@type": "SiteNavigationElement",
              "position": 1,
              "name": "Formation IA",
              "description": "Une journée de formation à l'intelligence artificielle, dans votre entreprise.",
              "url": "https://herone.fr/formation"
            },
            {
              "@type": "SiteNavigationElement",
              "position": 2,
              "name": "Automatisation IA",
              "description": "Nous relions les logiciels que vous utilisez déjà pour supprimer les ressaisies.",
              "url": "https://herone.fr/automatisation"
            },
            {
              "@type": "SiteNavigationElement",
              "position": 3,
              "name": "Blog",
              "description": "Conseils, guides et retours d'expérience sur l'automatisation et l'IA.",
              "url": "https://herone.fr/blog"
            },
            {
              "@type": "SiteNavigationElement",
              "position": 4,
              "name": "Réserver un appel",
              "description": "Réservez un échange découverte gratuit de 30 minutes avec notre équipe.",
              "url": "https://herone.fr/#reserver"
            }
          ]
        },
        {
          "@type": "Service",
          "@id": "https://herone.fr/#formation",
          "name": "Formation IA en entreprise",
          "serviceType": "Formation a l'intelligence artificielle en entreprise",
          "url": "https://herone.fr/formation",
          "description": "Une journee de formation a l'intelligence artificielle, animee a deux dans les locaux de l'entreprise, sans prerequis technique.",
          "provider": { "@id": "https://herone.fr/#organization" },
          "areaServed": { "@id": "https://herone.fr/#organization" },
          "offers": {
            "@type": "Offer",
            "price": "1500",
            "priceCurrency": "EUR",
            "valueAddedTaxIncluded": false,
            "description": "La journee, jusqu'a 3 personnes. Puis 500 EUR HT par personne.",
            "url": "https://herone.fr/formation"
          }
        },
        {
          "@type": "Service",
          "@id": "https://herone.fr/#automatisation",
          "name": "Automatisation IA",
          "serviceType": "Automatisation de processus et integration de logiciels",
          "url": "https://herone.fr/automatisation",
          "description": "Connexion des logiciels deja en place pour supprimer les ressaisies, avec un suivi mensuel.",
          "provider": { "@id": "https://herone.fr/#organization" },
          "areaServed": { "@id": "https://herone.fr/#organization" },
          "offers": {
            "@type": "Offer",
            "price": "2000",
            "priceCurrency": "EUR",
            "valueAddedTaxIncluded": false,
            "description": "A partir de 2000 EUR HT. Le suivi mensuel est chiffre lors du rendez-vous.",
            "url": "https://herone.fr/automatisation"
          }
        }
      ]
    })} />

    {jsonLd && jsonLd.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    )}

    <ClientRouter />
  </head>
  <body>
    <Header theme={headerTheme} />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Plan de marquage GA4 : pages vues, clics, défilement, lecture, rendez-vous.
      import '../scripts/suivi.ts';
    </script>

    <script>
      // Défilement des ancres de la même page, pris en charge à un seul
      // endroit pour que tous les liens y menant se comportent exactement
      // pareil : le bouton « Réserver 30 minutes » de l'en-tête, celui des
      // cartes d'offres, la phrase sous les offres, les entrées du menu.
      //
      // Le navigateur seul ne suffisait pas : un lien vers une ancre déjà
      // active ne déclenche aucun défilement, il estime qu'il n'y a rien à
      // faire. Après un premier clic vers #reserver, les suivants semblaient
      // donc morts. scrollIntoView respecte scroll-margin-top, l'arrivée est
      // donc la même que celle du navigateur : sous le header.
      let ancres: AbortController | undefined;

      function teardownAncres() {
        ancres?.abort();
        ancres = undefined;
      }

      function initAncres() {
        teardownAncres();
        ancres = new AbortController();

        const doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const lien = (event.target as Element | null)?.closest?.('a[href]');
          if (!(lien instanceof HTMLAnchorElement)) return;
          if (lien.target && lien.target !== '_self') return;

          // Même page ? On compare chemin et origine, pour laisser passer les
          // liens vers une autre page qui portent une ancre.
          const url = new URL(lien.href, location.href);
          if (url.origin !== location.origin || url.pathname !== location.pathname) return;
          if (!url.hash || url.hash === '#') return;

          const cible = document.querySelector(url.hash);
          if (!cible) return;

          event.preventDefault();
          cible.scrollIntoView({ behavior: doux ? 'smooth' : 'auto', block: 'start' });
          // L'adresse suit, sans ajouter d'entrée dans l'historique à chaque clic.
          history.replaceState(history.state, '', url.hash);
        }, { signal: ancres.signal });
      }

      document.addEventListener('astro:page-load', initAncres);
      document.addEventListener('astro:before-swap', teardownAncres);

      // Retour en haut à chaque changement de page.
      //
      // Mesuré, pas supposé : depuis /formation défilée à 757px, un clic sur
      // « Automatisation IA » dans le menu atterrissait à 416px. Le routeur
      // client remet bien le défilement à zéro, mais il le fait AVANT
      // d'échanger le document ; la page suivante étant plus longue, le
      // navigateur restaure ensuite une position intermédiaire.
      //
      // astro:after-swap se déclenche une fois le nouveau document en place :
      // c'est le seul moment où remettre le défilement à zéro tient.
      //
      // L'ancre est respectée : si l'adresse en porte une, on ne touche à
      // rien, c'est le gestionnaire ci-dessus ou le navigateur qui décide.
      // Retour en haut à chaque changement de page. Deux gestes distincts,
      // parce qu'ils ne s'appliquent pas aux mêmes moments.

      // 1. Le document lui-même. Le routeur client remet bien le défilement à
      //    zéro, mais AVANT d'échanger le document : la page suivante étant
      //    plus longue, le navigateur restaure ensuite une position
      //    intermédiaire. after-swap est le seul moment où la remise à zéro
      //    tient.
      function remonterDocument() {
        if (location.hash) return;
        window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
      }

      // 2. Le CADRE parent, quand la page est affichée dans un cadre. C'est la
      //    situation de l'aperçu artefact : selon la visionneuse, c'est le
      //    cadre qui tient la position, et remettre le document à zéro ne se
      //    voit alors pas du tout.
      //
      //    Un document ne peut pas piloter le défilement de son parent, c'est
      //    une protection du navigateur. Il peut en revanche lui DEMANDER de
      //    mettre un élément en vue : cette demande traverse la frontière du
      //    cadre. Vérifié dans les deux géométries possibles, cadre de hauteur
      //    fixe et cadre de la hauteur du contenu.
      function remonterCadre() {
        if (location.hash) return;
        if (window.self === window.top) return;
        document.documentElement.scrollIntoView({ block: 'start', behavior: 'instant' });
      }

      document.addEventListener('astro:after-swap', () => {
        remonterDocument();
        remonterCadre();
      });

      // page-load couvre le cadre quand la navigation a été un chargement
      // complet et non un échange piloté par le routeur. On n'y remet
      // volontairement PAS le document à zéro : cela écraserait la position
      // que le navigateur restaure quand on recharge une page en cours de
      // lecture, ce qui serait une régression pour un vrai visiteur.
      document.addEventListener('astro:page-load', remonterCadre);

      // 3. Rattrapage, UNIQUEMENT quand la page est affichée dans un cadre.
      //    Signalé de nouveau le 22 septembre 2026 dans l'aperçu : un clic sur
      //    une offre de l'accueil n'arrivait pas en haut de la page d'offre,
      //    alors que le vrai site et un cadre de test arrivaient à 0px.
      //    Le geste n°2 part au tout début du chargement ; une visionneuse qui
      //    redimensionne son cadre ou restaure sa propre position APRÈS ce
      //    moment l'annule. On le rejoue donc une fois la page chargée, puis
      //    deux fois encore peu après, sauf si le visiteur a déjà commencé à
      //    défiler : on ne lui reprend jamais la main.
      //    Seulement après une navigation fraîche (pas un rechargement ni un
      //    retour arrière), et jamais hors cadre : le vrai site n'est pas
      //    concerné par ce bloc.
      if (window.self !== window.top) {
        const nav = performance.getEntriesByType('navigation')[0];
        if (!nav || nav.type === 'navigate') {
          let laMain = false;
          const prendre = () => { laMain = true; };
          for (const t of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
            window.addEventListener(t, prendre, { once: true, passive: true });
          }
          const rattraper = () => {
            if (laMain || location.hash) return;
            window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
            remonterCadre();
          };
          window.addEventListener('load', () => {
            rattraper();
            setTimeout(rattraper, 250);
            setTimeout(rattraper, 800);
          }, { once: true });
        }
      }
    </script>
  </body>
</html>
