---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerTheme?: 'dark' | 'light';
  noindex?: boolean;
}

const { title, description, headerTheme = 'light', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GT6JCYY2SF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GT6JCYY2SF');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="icon" type="image/jpg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://framerusercontent.com/assets/GfaJExWm66OTZNYZXcbpxcY3o.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://framerusercontent.com/assets/GfaJExWm66OTZNYZXcbpxcY3o.jpg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LocalBusiness",
          "@id": "https://herone.fr/#organization",
          "name": "Hérone",
          "url": "https://herone.fr",
          "logo": "https://herone.fr/favicon.png",
          "image": "https://herone.fr/favicon.png",
          "description": description,
          "telephone": "+33663710598",
          "email": "contact@herone.fr",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "37 rue Édouard Branly",
            "addressLocality": "Les Herbiers",
            "postalCode": "85500",
            "addressRegion": "Vendée",
            "addressCountry": "FR"
          },
          "areaServed": [
            { "@type": "City", "name": "Les Herbiers" },
            { "@type": "City", "name": "Montaigu" },
            { "@type": "City", "name": "Chantonnay" },
            { "@type": "City", "name": "Pouzauges" },
            { "@type": "City", "name": "Mortagne-sur-Sèvre" },
            { "@type": "City", "name": "La Roche-sur-Yon" },
            { "@type": "City", "name": "Cholet" },
            { "@type": "AdministrativeArea", "name": "Vendée" },
            { "@type": "AdministrativeArea", "name": "Choletais" }
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://herone.fr/#website",
          "url": "https://herone.fr",
          "name": "Hérone",
          "publisher": {
            "@id": "https://herone.fr/#organization"
          },
          "inLanguage": "fr-FR",
          "hasPart": [
            {
              "@type": "WebPage",
              "name": "Systèmes",
              "url": "https://herone.fr/systemes"
            },
            {
              "@type": "WebPage",
              "name": "Blog",
              "url": "https://herone.fr/blog"
            },
            {
              "@type": "WebPage",
              "name": "Réserver un appel",
              "url": "https://herone.fr/#reserver"
            }
          ]
        },
        {
          "@type": "ItemList",
          "@id": "https://herone.fr/#sitenavigation",
          "name": "Navigation principale",
          "itemListElement": [
            {
              "@type": "SiteNavigationElement",
              "position": 1,
              "name": "Systèmes",
              "description": "Découvrez nos systèmes automatisés pour les TPE et PME.",
              "url": "https://herone.fr/systemes"
            },
            {
              "@type": "SiteNavigationElement",
              "position": 2,
              "name": "Blog",
              "description": "Conseils, guides et retours d'expérience sur l'automatisation et l'IA.",
              "url": "https://herone.fr/blog"
            },
            {
              "@type": "SiteNavigationElement",
              "position": 3,
              "name": "Réserver un appel",
              "description": "Réservez un échange découverte gratuit de 30 minutes avec notre équipe.",
              "url": "https://herone.fr/#reserver"
            }
          ]
        }
      ]
    })} />

    <ClientRouter />
  </head>
  <body>
    <Header theme={headerTheme} />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
