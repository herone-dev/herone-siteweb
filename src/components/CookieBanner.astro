---
import Button from './Button.astro';
---

<div id="hrn-cookie-banner" class="hrn-cookie" hidden>
  <p>Les contenus intégrés au site (vidéo de témoignage, prise de rendez-vous) déposent des cookies tiers. Vous pouvez les accepter ou les refuser.</p>
  <div class="hrn-cookie__actions">
    <Button variant="primary" size="sm" class="hrn-cookie__accept">Accepter</Button>
    <Button variant="secondary" size="sm" class="hrn-cookie__refuse">Refuser</Button>
    <a href="/cookies" class="hrn-cookie__more">En savoir plus</a>
  </div>
</div>

<style>
  .hrn-cookie {
    position: fixed;
    z-index: 65;
    left: 16px;
    right: 16px;
    bottom: 20px;
    max-width: 440px;
    margin-left: auto;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 20px;
  }

  .hrn-cookie[hidden] { display: none; }

  .hrn-cookie p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-primary);
  }

  .hrn-cookie__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
    align-items: center;
  }

  .hrn-cookie__more {
    font-size: 13px;
    color: var(--text-secondary);
    margin-left: 2px;
    text-decoration: none;
  }

  .hrn-cookie__more:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 819px) {
    .hrn-cookie {
      bottom: 92px;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'hrn-cookie';
  let ac: AbortController | undefined;

  function initCookieBanner() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const banner = document.querySelector<HTMLElement>('#hrn-cookie-banner');
    if (!banner) return;

    const choice = window.localStorage.getItem(STORAGE_KEY);
    if (!choice) banner.hidden = false;

    banner.querySelector('.hrn-cookie__accept')?.addEventListener('click', () => {
      window.localStorage.setItem(STORAGE_KEY, 'accepted');
      banner.hidden = true;
    }, { signal });

    banner.querySelector('.hrn-cookie__refuse')?.addEventListener('click', () => {
      window.localStorage.setItem(STORAGE_KEY, 'refused');
      banner.hidden = true;
    }, { signal });
  }

  document.addEventListener('astro:page-load', initCookieBanner);
</script>
