---
// L'adresse renvoie vers LA FICHE Hérone sur Google Maps, et non plus vers une
// simple recherche d'adresse : c'est le lien fourni par l'utilisateur, celui
// qui ouvre l'établissement avec ses avis et ses horaires.
// L'URL est posée dans une constante plutôt qu'en dur dans l'attribut : elle
// contient des `&`, qui devraient être échappés dans du markup.
import { DEPARTEMENTS, villesDuDepartement } from '../data/villes';

const ADRESSE = '37 rue Édouard Branly, Les Herbiers 85500, France';
const ADRESSE_MAPS =
  'https://www.google.com/maps/place/H%C3%A9rone/@46.8583076,-1.0387592,17z/' +
  'data=!3m1!4b1!4m6!3m5!1s0x480661339d6958db:0xc2ce55afb78a1bee!8m2!' +
  '3d46.858304!4d-1.0361843!16s%2Fg%2F11zbl1zvql';

// Menu « Nos zones d'intervention » (25 septembre 2026) : les 15 pages villes,
// par département puis par ordre alphabétique. Un <details> natif, fermé par
// défaut : les liens sont dans le HTML dès le chargement, menu fermé compris,
// pour que les moteurs de recherche les lisent. Aucun JavaScript. Rangé dans
// la colonne « Ressources », sous « Blog », à la même taille que ce lien
// (demande de l'utilisateur). La liste de villes écrite en texte dans la
// colonne de marque a été retirée : ce menu la remplace.
const pageCourante = Astro.url.pathname.replace(/\/$/, '');
---

<footer class="hrn-footer hrn-zone-bleue">
  <div class="hrn-footer__inner">
    <div class="hrn-footer__grid">
      <div class="hrn-footer__brand">
        <a href="/" class="hrn-footer__logo hrn-sweep">HÉRONE</a>
        <p>Formation à l'IA et systèmes automatisés pour les TPE et PME de Vendée et du Choletais.</p>
        <a class="hrn-footer__address hrn-sweep" href={ADRESSE_MAPS} target="_blank" rel="noopener noreferrer">{ADRESSE}</a>
      </div>

      <div class="hrn-footer__col">
        <span class="hrn-footer__heading">Section</span>
        <a href="/formation" class="hrn-sweep">Formation IA</a>
        <a href="/automatisation" class="hrn-sweep">Automatisation IA</a>
        <a href="/#offres" class="hrn-sweep">Nos offres</a>
        <a href="/#temoignage" class="hrn-sweep">Témoignages</a>
        <a href="/#fondateurs" class="hrn-sweep">À propos</a>
        <a href="/#reserver" class="hrn-sweep">Réserver un appel</a>
      </div>

      <div class="hrn-footer__col">
        <span class="hrn-footer__heading">Ressources</span>
        <a href="/blog" class="hrn-sweep">Blog</a>
        <details class="hrn-footer__zones">
          <summary class="hrn-footer__zones-titre">
            Nos zones d'intervention
            <svg class="hrn-footer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </summary>
          <nav class="hrn-footer__zones-liste" aria-label="Zones d'intervention">
            {DEPARTEMENTS.map((d) => (
              <div class="hrn-footer__zone">
                <span class="hrn-footer__zone-dep">{d}</span>
                <ul role="list">
                  {villesDuDepartement(d).map((v) => {
                    const href = `/ia-entreprise/${v.slug}`;
                    return (
                      <li>
                        <a href={href} class="hrn-sweep" aria-current={pageCourante === href ? 'page' : undefined}>{v.nom}</a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </nav>
        </details>
        <a href="mailto:contact@herone.fr" class="hrn-sweep">contact@herone.fr</a>
        <a href="tel:+33663710598" class="hrn-sweep">06 63 71 05 98</a>
      </div>

      <div class="hrn-footer__col">
        <span class="hrn-footer__heading">Légal</span>
        <a href="/mentions-legales" class="hrn-sweep">Mentions légales</a>
        <a href="/confidentialite" class="hrn-sweep">Confidentialité</a>
        <a href="/cookies" class="hrn-sweep">Cookies</a>
      </div>
    </div>

    <div class="hrn-footer__bottom">
      <span>© 2026 Hérone · Les Herbiers, Vendée</span>
      <span class="hrn-footer__signature">L'IA sort l'humain des tâches mécaniques</span>
    </div>
  </div>
</footer>

<style>
  .hrn-footer {
    background: var(--nuit-profonde);
    color: var(--text-secondary);
    padding: var(--section-y-sm) 0 32px;
  }

  .hrn-footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  .hrn-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
  }

  /* Sur téléphone, auto-fit ne tenait qu'une seule colonne : les trois listes
     de liens s'empilaient sur trois rangées et le pied de page dépassait 840px.
     On force deux colonnes, la marque occupe toute la largeur (son texte est
     bien plus long que des libellés de liens) et « Légal », qui se retrouverait
     seul sur sa rangée avec une demi-rangée vide à côté, se déplie à
     l'horizontale.

     Le seuil est volontairement bas : au-delà, auto-fit donne déjà deux
     colonnes et place la marque à côté d'une liste, ce qui est plus compact
     que cette disposition. */
  @media (max-width: 479px) {
    .hrn-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }

    .hrn-footer__brand {
      grid-column: 1 / -1;
    }

    .hrn-footer__col:last-child {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 18px;
    }

    .hrn-footer__col:last-child .hrn-footer__heading {
      flex-basis: 100%;
      margin-bottom: 0;
    }
  }

  /* Le texte de marque (zone d'intervention + communes) est plus long que les
     colonnes de liens : on lui donne une colonne plus large à partir du desktop
     pour garder 4 colonnes sur une seule ligne. */
  @media (min-width: 900px) {
    .hrn-footer__grid {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }

  .hrn-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 42ch;
  }

  .hrn-footer__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    color: var(--ink-50);
    align-self: flex-start; /* la zone cliquable s'arrête au mot, pas à la colonne */
    text-decoration: none;
  }

  .hrn-footer__logo:hover {
    color: var(--amber-400);
  }

  .hrn-footer__brand p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* L'adresse est un lien : la zone cliquable s'arrête au texte, comme le
     logo, et non sur toute la largeur de la colonne. Même couleur que les
     liens des colonnes (demande du 23 septembre 2026), un cran plus clair que
     le texte de marque au-dessus. */
  .hrn-footer__address {
    align-self: flex-start;
    font-size: 14px;
    color: var(--text-primary);
    text-decoration: none;
  }

  .hrn-footer__address.hrn-sweep {
    --sweep-from: var(--text-primary);
  }

  .hrn-footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hrn-footer__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .hrn-footer__col a {
    font-size: 14px;
    color: var(--text-primary);
  }

  .hrn-footer__col a.hrn-sweep,
  .hrn-footer__logo.hrn-sweep {
    --sweep-from: var(--text-primary);
  }

  .hrn-footer__logo.hrn-sweep {
    --sweep-from: var(--ink-50);
  }

  /* Conservé pour le contraste forcé et les navigateurs sans background-clip,
     où le balayage laisse la main à `color`. */
  .hrn-footer__col a:hover {
    color: var(--amber-400);
  }

  /* ============ Nos zones d'intervention (colonne Ressources) ============
     Le résumé a la taille et la couleur des liens de la colonne ; le chevron
     pivote à l'ouverture. La liste dépliée reste dans la colonne. */

  .hrn-footer__zones-titre {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    color: var(--text-primary);
  }

  .hrn-footer__zones-titre::-webkit-details-marker {
    display: none;
  }

  .hrn-footer__zones-titre:hover {
    color: var(--amber-400);
  }

  .hrn-footer__zones-titre:focus-visible {
    outline: 2px solid var(--amber-300);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .hrn-footer__chevron {
    flex: none;
    color: var(--accent-texte);
    transition: transform var(--dur) var(--ease-standard);
  }

  .hrn-footer__zones[open] .hrn-footer__chevron {
    transform: rotate(180deg);
  }

  .hrn-footer__zones-liste {
    display: grid;
    gap: 16px;
    margin-top: 14px;
    padding-left: 12px;
    border-left: 1px solid var(--border-inverse);
  }

  .hrn-footer__zone-dep {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hrn-footer__zone ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .hrn-footer__zone a {
    font-size: 14px;
    color: var(--text-primary);
    text-decoration: none;
  }

  .hrn-footer__zone a.hrn-sweep {
    --sweep-from: var(--text-primary);
  }

  .hrn-footer__zone a:hover {
    color: var(--amber-400);
  }

  .hrn-footer__zone a[aria-current='page'] {
    --sweep-from: var(--accent-texte);
    color: var(--accent-texte);
  }

  .hrn-footer__zone a:focus-visible {
    outline: 2px solid var(--amber-300);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Téléphone : cibles de 44px pour le résumé et chaque ville. */
  @media (max-width: 759px) {
    .hrn-footer__zones-titre,
    .hrn-footer__zone a {
      min-height: 44px;
    }

    .hrn-footer__zone a {
      display: flex;
      align-items: center;
    }

    .hrn-footer__zone ul {
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-footer__chevron {
      transition: none;
    }
  }

  .hrn-footer__bottom {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border-inverse);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hrn-footer__signature {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
