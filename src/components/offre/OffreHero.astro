---
// Hero commun aux pages d'offre (/formation, /automatisation).
//
// Les deux pages sont des jumelles volontaires : même hero, même déroulé en
// étapes, même bloc de tarif, même pont vers l'autre offre. Un visiteur qui
// passe de l'une à l'autre doit reconnaître la structure et comparer sans
// effort. C'est aussi ce qui fait qu'un futur handoff de design ne s'applique
// qu'à un seul endroit au lieu de deux.
//
// Motif repris de /blog : fond jade, trame de points, titre display. Le
// padding haut laisse passer le header fixe de 68px (mesuré : le texte
// commence à 104px en étroit, 128px au large).
import Button from '../Button.astro';

interface Props {
  eyebrow: string;
  titre: string;
  lede: string;
  /** Rangée de faits sous le chapô. Le libellé porte le chiffre, la valeur l'explique. */
  faits: { cle: string; valeur: string }[];
  /** Lien secondaire à côté du bouton, typiquement vers l'ancre du tarif. */
  lienHref?: string;
  lienLabel?: string;
}

const { eyebrow, titre, lede, faits, lienHref, lienLabel } = Astro.props;
---

<section class="hrn-offre-hero">
  <div class="hrn-offre-hero__dots" aria-hidden="true"></div>
  <div class="hrn-section-inner hrn-offre-hero__content">
    <div class="hrn-eyebrow">{eyebrow}</div>
    <h1>{titre}</h1>
    <p class="hrn-offre-hero__lede">{lede}</p>

    <ul class="hrn-offre-facts" role="list">
      {faits.map((f) => (
        <li>
          <span class="hrn-offre-facts__key">{f.cle}</span>
          <span class="hrn-offre-facts__val">{f.valeur}</span>
        </li>
      ))}
    </ul>

    <div class="hrn-offre-hero__actions">
      <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
      {lienHref && lienLabel && (
        <a href={lienHref} class="hrn-offre-hero__link">
          {lienLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hrn-offre-hero {
    position: relative;
    padding: clamp(104px, 11vw, 128px) 0 clamp(40px, 5vw, 56px);
    background: var(--slate-900);
    color: var(--ink-200);
    overflow: hidden;
  }

  .hrn-offre-hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, #fff 7%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  .hrn-offre-hero__content {
    position: relative;
  }

  .hrn-offre-hero :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-offre-hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--text-inverse);
    max-width: 18ch;
    margin: 14px 0 0;
    text-wrap: balance;
  }

  .hrn-offre-hero__lede {
    margin-top: 18px !important;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-300);
    text-wrap: pretty;
  }

  /* minmax(min(…, 100%), 1fr) et non minmax(210px, 1fr) : sur un écran de
     320px, une piste fixe plus large que le conteneur déborde et pousse toute
     la page en défilement horizontal (piège n°1 du projet). */
  .hrn-offre-facts {
    list-style: none;
    margin: 34px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--border-inverse);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 22px;
  }

  .hrn-offre-facts li {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .hrn-offre-facts__key {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text-inverse);
  }

  .hrn-offre-facts__val {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-300);
    text-wrap: pretty;
  }

  .hrn-offre-hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .hrn-offre-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    color: var(--amber-300);
  }

  @media (max-width: 640px) {
    .hrn-offre-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
