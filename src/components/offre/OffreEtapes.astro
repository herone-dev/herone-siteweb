---
// Déroulé en étapes, commun aux deux pages d'offre.
//
// Porté du handoff Claude Design « Blocs Offres Herone » (bloc 1b).
// Changement principal apporté par le design : la mise en page passe sur DEUX
// colonnes. L'accroche reste calée à gauche pendant que les étapes défilent à
// droite, au lieu d'un titre posé au-dessus d'une longue liste. En étroit, la
// grille se replie d'elle-même en une colonne.
//
// Sur /formation, `meta` porte la durée du bloc (« 30 min »). Sur
// /automatisation, elle porte le moment (« avant de démarrer »). Elle peut
// aussi rester vide : la ligne se referme toute seule.
//
// Pas de white-space: nowrap sur le titre ni sur la méta. C'est ce qui a déjà
// poussé la page en défilement horizontal ailleurs sur le site (piège n°1).
// Les durées restent d'un seul tenant par leurs espaces insécables, ce qui
// suffit et ne bloque pas le repli du reste.

interface Props {
  eyebrow: string;
  titre: string;
  lede?: string;
  etapes: { num: string; titre: string; meta?: string; texte: string }[];
  /** Fond de la section, à choisir pour ne jamais répéter celui de la section précédente. */
  fond?: 'paper' | 'surface';
  id?: string;
}

const { eyebrow, titre, lede, etapes, fond = 'surface', id } = Astro.props;
---

<section class:list={['hrn-offre-etapes', `hrn-offre-etapes--${fond}`]} id={id}>
  <div class="hrn-section-inner hrn-offre-etapes__grid">
    <div class="hrn-offre-etapes__intro">
      <div class="hrn-eyebrow">{eyebrow}</div>
      <h2>{titre}</h2>
      {lede && <p>{lede}</p>}
    </div>

    <ol class="hrn-offre-etapes__list" role="list">
      {etapes.map((etape) => (
        <li class="hrn-offre-etape">
          <span class="hrn-offre-etape__num">{etape.num}</span>
          <div class="hrn-offre-etape__corps">
            <div class="hrn-offre-etape__head">
              <h3>{etape.titre}</h3>
              {etape.meta && <span class="hrn-offre-etape__meta">{etape.meta}</span>}
            </div>
            <p>{etape.texte}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hrn-offre-etapes {
    padding: var(--section-y) 0;
    scroll-margin-top: 68px;
  }

  .hrn-offre-etapes--paper {
    background: var(--bg-page);
  }

  .hrn-offre-etapes--surface {
    background: var(--bg-surface);
  }

  /* minmax(min(…, 100%), 1fr) : une piste fixe plus large que le conteneur
     pousse toute la page en défilement horizontal sur un écran de 320px
     (piège n°1 du projet). */
  .hrn-offre-etapes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(var(--space-8), 5vw, var(--space-16));
  }

  .hrn-offre-etapes__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    min-width: 0;
  }

  .hrn-offre-etapes__intro h2 {
    margin: 0;
    font: var(--type-h2);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    max-width: none;
    text-wrap: balance;
  }

  .hrn-offre-etapes__intro p {
    margin: 0 !important;
    font: var(--type-body);
    color: var(--text-secondary);
    max-width: 32rem;
    text-wrap: pretty;
  }

  .hrn-offre-etapes__list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    border-top: 1px solid var(--border);
  }

  .hrn-offre-etape {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }

  .hrn-offre-etape__num {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-label);
    color: var(--brand);
    padding-top: var(--space-1);
  }

  .hrn-offre-etape__corps {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .hrn-offre-etape__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
  }

  .hrn-offre-etape__head h3 {
    margin: 0;
    font: var(--type-h4);
    letter-spacing: var(--tracking-tight);
    color: var(--text-strong);
    min-width: 0;
  }

  /* text-transform: none, volontairement : la méta porte une durée ou un
     moment, pas un label. Les capitales la rendraient illisible. */
  .hrn-offre-etape__meta {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-wide);
    text-transform: none;
    color: var(--text-muted);
  }

  .hrn-offre-etape p {
    margin: 0 !important;
    font: var(--type-body);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
</style>
