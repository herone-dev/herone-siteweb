---
// Pont vers l'autre offre, en bas de chaque page d'offre.
//
// Raison d'être : un visiteur arrivé par une recherche « formation IA » ne
// sait pas que nous automatisons aussi, et l'inverse est tout aussi vrai. Ce
// bloc est le seul endroit où les deux pages se tiennent par la main, et il
// est volontairement le dernier : on ne propose l'autre porte qu'une fois la
// première expliquée en entier.

interface Props {
  titre: string;
  texte: string;
  liens: { href: string; label: string }[];
}

const { titre, texte, liens } = Astro.props;
---

<section class="hrn-offre-pont">
  <div class="hrn-section-inner hrn-offre-pont__inner">
    <div>
      <h2 set:html={titre} />
      <p>{texte}</p>
    </div>
    <div class="hrn-offre-pont__actions">
      {liens.map((l) => (
        <a href={l.href} class="hrn-offre-pont__link">
          {l.label}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-offre-pont {
    padding: 0 0 clamp(56px, 8vw, 96px);
    background: var(--paper);
  }

  .hrn-offre-pont__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-top: clamp(26px, 4vw, 40px);
    border-top: 1px solid var(--border);
  }

  .hrn-offre-pont h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    max-width: 22ch;
    margin: 0;
  }

  .hrn-offre-pont p {
    margin-top: 10px !important;
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-offre-pont__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hrn-offre-pont__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    color: var(--slate-600);
  }
</style>
