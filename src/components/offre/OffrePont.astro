---
// Pont vers l'autre offre, en bas de chaque page d'offre.
//
// Porté du handoff Claude Design « Blocs Offres Herone » (bloc 1e).
//
// Raison d'être : un visiteur arrivé par une recherche « formation IA » ne
// sait pas que nous automatisons aussi, et l'inverse est tout aussi vrai. Ce
// bloc est le seul endroit où les deux pages se tiennent par la main, et il
// est volontairement le dernier : on ne propose l'autre porte qu'une fois la
// première expliquée en entier.
//
// Maquettes du 24 septembre 2026 : le texte à gauche, les deux liens empilés
// à droite, le titre agrandi, les liens en turquoise. Le fond se choisit
// (`fond`) pour alterner avec la FAQ qui précède : crème sur /formation, bleu
// sur /automatisation. Le filet de tête a disparu avec l'alternance des
// fonds, qui sépare déjà le bloc de la section précédente.

interface Props {
  titre: string;
  texte: string;
  liens: { href: string; label: string }[];
  /** Fond de la section, à choisir pour ne jamais répéter celui de la section précédente. */
  fond?: 'paper' | 'surface';
}

const { titre, texte, liens, fond = 'paper' } = Astro.props;
---

<section class:list={['hrn-offre-pont', `hrn-offre-pont--${fond}`, fond === 'paper' ? 'hrn-zone-bleue' : 'hrn-zone-creme']}>
  <div class="hrn-section-inner hrn-offre-pont__inner">
    <div class="hrn-offre-pont__texte">
      <h2 set:html={titre} />
      <p>{texte}</p>
    </div>
    <div class="hrn-offre-pont__actions">
      {liens.map((l) => (
        <a href={l.href} class="hrn-offre-pont__link">
          {l.label}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-offre-pont {
    padding: 0;
    background: var(--bg-page);
  }

  .hrn-offre-pont--surface {
    background: var(--surface);
  }

  /* Texte à gauche, liens à droite ; en étroit, les liens passent dessous. */
  .hrn-offre-pont__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 28px 64px;
    padding-top: clamp(var(--space-10), 8vw, var(--space-20));
    padding-bottom: clamp(var(--space-10), 8vw, var(--space-20));
  }

  .hrn-offre-pont__texte {
    display: grid;
    gap: 16px;
    flex: 1 1 32rem;
    max-width: 40rem;
    min-width: 0;
  }

  .hrn-offre-pont h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(1.6rem, 2.8vw, 2.375rem);
    line-height: 1.12;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    max-width: none;
    text-wrap: balance;
  }

  .hrn-offre-pont p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-offre-pont__actions {
    display: grid;
    gap: 16px;
    align-content: start;
    min-width: 0;
  }

  .hrn-offre-pont__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    font-weight: var(--weight-semibold);
    min-height: 44px;
    font-size: var(--text-base);
    color: var(--accent-texte);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }

  .hrn-offre-pont__link:hover,
  .hrn-offre-pont__link:focus-visible {
    color: var(--text-strong);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offre-pont__link {
      transition: none;
    }

    .hrn-offre-pont__link:hover,
    .hrn-offre-pont__link:focus-visible {
      transform: none;
    }
  }
</style>
