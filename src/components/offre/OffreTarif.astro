---
// Bloc de tarif, commun aux deux pages d'offre.
//
// Porté du handoff Claude Design « Blocs Offres Herone » (bloc 1c).
// Ce que le design change par rapport à la version précédente :
//  - chaque carte de prix porte un petit label au-dessus du montant
//    (« Mise en place », « Maintenance, par mois ») : on sait ce qu'on lit
//    avant de lire le chiffre ;
//  - le montant grossit franchement (jusqu'à --text-5xl) ;
//  - les exemples chiffrés passent des pastilles à une liste de définitions
//    réglée, avec chiffres tabulaires : les montants s'alignent en colonne et
//    se comparent d'un coup d'œil ;
//  - la phrase « ce qui est compris » et le bouton se posent côte à côte.
//
// Maquettes du 24 septembre 2026 : deux variantes en plus de la version
// sombre d'origine (`sombre`, par défaut, inchangée) :
//  - `claire` (/formation) : fond crème, une carte blanche par règle et une
//    carte « Exemples » sur la même ligne, puis « ce qui est compris » et le
//    bouton côte à côte ;
//  - `suivi` (/automatisation) : fond bleu nuit profond, la mise en place dans
//    une carte crème, et à côté une carte sombre « Ensuite » (prop `suite`)
//    qui porte le texte de `inclus` et le bouton.
//
// Emplacement nommé `simulateur` (variante `claire`, /formation depuis le
// 24 septembre 2026) : quand il est rempli, il remplace les cartes de prix
// et la carte « Exemples », sur toute la largeur. Depuis le 25 septembre
// 2026, la variante `suivi` l'accepte aussi (/automatisation, simulateur de
// rentabilité) : il remplace alors les deux cartes, et `regles`, `suite` et
// `inclus` peuvent rester vides. Prop `lede` facultative sous le titre. La règle de prix est alors
// écrite dans le simulateur lui-même, et `regles` peut rester vide.
// Décision de l'utilisateur : les cartes répétaient le simulateur et
// alourdissaient la section.
//
// Les montants ne portent PAS de white-space: nowrap. Ils tiennent d'un seul
// tenant par leurs espaces insécables, ce qui suffit et ne fait pas déborder
// la carte en étroit (piège n°1, déjà vécu sur les cartes d'offres).
import Button from '../Button.astro';

interface Props {
  eyebrow?: string;
  titre: string;
  /** Phrase facultative sous le titre. */
  lede?: string;
  /** Une carte par règle de facturation. `label` coiffe le montant. */
  regles?: { label: string; prix: string; detail: string }[];
  /** Exemples chiffrés, facultatifs. Rendus en liste réglée, montants alignés. */
  exemples?: { qui: string; prix: string }[];
  /** Ce que le prix comprend, posé à gauche du bouton. */
  inclus?: string;
  id?: string;
  variante?: 'sombre' | 'claire' | 'suivi';
  /** Variante `suivi` : la carte sombre posée à côté du prix. Son texte est `inclus`. */
  suite?: { label: string; titre: string };
}

const { eyebrow = 'Le tarif', titre, lede, regles = [], exemples, inclus, id = 'tarif', variante = 'sombre', suite } = Astro.props;
const avecSimulateur = (variante === 'claire' || variante === 'suivi') && Astro.slots.has('simulateur');
---

<section
  class:list={[
    'hrn-offre-tarif',
    `hrn-offre-tarif--${variante}`,
    variante === 'claire' ? 'hrn-zone-creme' : 'hrn-zone-bleue',
  ]}
  id={id}
>
  <div class="hrn-section-inner hrn-offre-tarif__inner">
    <div class="hrn-offre-tarif__head">
      <div class="hrn-eyebrow">{eyebrow}</div>
      <h2>{titre}</h2>
      {lede && <p class="hrn-offre-tarif__lede">{lede}</p>}
    </div>

    {avecSimulateur && <slot name="simulateur" />}

    {variante === 'claire' && !avecSimulateur && (
      <div class="hrn-offre-tarif__cartes">
        {regles.map((r) => (
          <div class="hrn-offre-tarif__carte">
            <span class="hrn-offre-tarif__etiquette">{r.label}</span>
            <strong class="hrn-offre-tarif__montant">{r.prix}</strong>
            <p class="hrn-offre-tarif__detail">{r.detail}</p>
          </div>
        ))}
        {exemples && exemples.length > 0 && (
          <div class="hrn-offre-tarif__carte hrn-offre-tarif__carte--exemples">
            <span class="hrn-offre-tarif__etiquette">Exemples</span>
            <dl class="hrn-offre-tarif__lignes">
              {exemples.map((ex) => (
                <div>
                  <dt>{ex.qui}</dt>
                  <dd>{ex.prix}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    )}

    {variante === 'suivi' && !avecSimulateur && (
      <div class="hrn-offre-tarif__cartes hrn-offre-tarif__cartes--suivi">
        {regles.map((r) => (
          <div class="hrn-offre-tarif__carte hrn-offre-tarif__carte--creme hrn-zone-creme">
            <span class="hrn-offre-tarif__etiquette">{r.label}</span>
            <strong class="hrn-offre-tarif__montant">{r.prix}</strong>
            <p class="hrn-offre-tarif__detail">{r.detail}</p>
          </div>
        ))}
        {suite && (
          <div class="hrn-offre-tarif__suite">
            <span class="hrn-offre-tarif__etiquette">{suite.label}</span>
            <h3>{suite.titre}</h3>
            {inclus && <p class="hrn-offre-tarif__detail">{inclus}</p>}
            <div class="hrn-offre-tarif__suite-bouton">
              <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
            </div>
          </div>
        )}
      </div>
    )}

    {variante === 'claire' && (
      <div class="hrn-offre-tarif__pied">
        {inclus && <p class="hrn-offre-tarif__inclus">{inclus}</p>}
        <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
      </div>
    )}

    {variante === 'sombre' && (<>
    <div class:list={['hrn-offre-tarif__grid', regles.length === 1 && 'hrn-offre-tarif__grid--seule']}>
      {regles.map((r) => (
        <div class="hrn-offre-tarif__regle">
          <span class="hrn-offre-tarif__label">{r.label}</span>
          <strong class="hrn-offre-tarif__prix">{r.prix}</strong>
          <p>{r.detail}</p>
        </div>
      ))}
    </div>

    {exemples && exemples.length > 0 && (
      <dl class="hrn-offre-tarif__exemples">
        {exemples.map((ex) => (
          <div>
            <dt>{ex.qui}</dt>
            <dd>{ex.prix}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="hrn-offre-tarif__pied">
      {inclus && <p class="hrn-offre-tarif__inclus">{inclus}</p>}
      <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
    </div>
    </>)}
  </div>
</section>

<style>
  .hrn-offre-tarif {
    padding: var(--section-y) 0;
    background: var(--bg-inverse);
    color: var(--text-inverse);
    scroll-margin-top: 68px;
  }

  .hrn-offre-tarif__inner {
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-12));
  }

  /* --accent-texte vaut --amber-300 sur le bleu : la version sombre ne
     change pas, la version claire prend le turquoise foncé du crème. */
  .hrn-offre-tarif :global(.hrn-eyebrow) {
    color: var(--accent-texte);
  }

  .hrn-offre-tarif--claire {
    background: var(--surface);
    color: var(--text-primary);
  }

  .hrn-offre-tarif__head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .hrn-offre-tarif__head h2 {
    margin: 0;
    font: var(--type-h2);
    letter-spacing: var(--tracking-titre);
    color: #fff;
    max-width: none;
    text-wrap: balance;
    font-weight: var(--weight-titre);
  }

  /* minmax(min(…, 100%), 1fr) : une piste fixe plus large que le conteneur
     pousse toute la page en défilement horizontal sur un écran de 320px
     (piège n°1 du projet). */
  .hrn-offre-tarif__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-4);
  }

  /* Une seule règle de facturation : sans plafond, la carte s'étirerait sur
     toute la largeur du conteneur et le montant flotterait au milieu d'un
     bandeau vide. */
  .hrn-offre-tarif__grid--seule {
    max-width: 34rem;
  }

  .hrn-offre-tarif__regle {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease-standard);
  }

  .hrn-offre-tarif__regle:hover {
    transform: translateY(-2px);
  }

  .hrn-offre-tarif__label {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hrn-offre-tarif__prix {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-tighter);
    color: var(--accent);
  }

  .hrn-offre-tarif__regle p {
    margin: 0 !important;
    font: var(--type-body);
    color: var(--text-primary);
    text-wrap: pretty;
  }

  /* Liste de définitions réglée : libellé à gauche, montant à droite, tous
     alignés. font-variant-numeric: tabular-nums donne la même chasse à tous
     les chiffres, sans quoi les montants ne se compareraient pas en colonne. */
  .hrn-offre-tarif__exemples {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 0 var(--space-8);
    border-top: 1px solid var(--border-inverse);
  }

  .hrn-offre-tarif__exemples > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    min-width: 0;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-inverse);
  }

  .hrn-offre-tarif__exemples dt {
    font: var(--type-small);
    color: var(--text-primary);
    min-width: 0;
  }

  .hrn-offre-tarif__exemples dd {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    color: #fff;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .hrn-offre-tarif__pied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-8);
  }

  .hrn-offre-tarif__inclus {
    margin: 0 !important;
    font: var(--type-body);
    color: var(--text-primary);
    max-width: 36rem;
    text-wrap: pretty;
  }

  /* ============ Variantes « claire » et « suivi » ============ */

  .hrn-offre-tarif__lede {
    margin: 14px 0 0;
    max-width: 40em;
    font-size: clamp(1.05rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-offre-tarif--claire .hrn-offre-tarif__head h2 {
    color: var(--text-strong);
  }

  /* Paliers explicites : trois cartes sur une ligne au large ; sur tablette,
     les deux prix côte à côte et les exemples sur toute la largeur dessous
     (un auto-fit les laissait seuls sur une demi-ligne) ; une colonne sur
     téléphone. */
  .hrn-offre-tarif__cartes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  @media (min-width: 560px) {
    .hrn-offre-tarif__cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hrn-offre-tarif__carte--exemples {
      grid-column: 1 / -1;
    }
  }

  /* Au large, autant de colonnes égales que de cartes (deux prix et les
     exemples sur /formation). */
  @media (min-width: 960px) {
    .hrn-offre-tarif--claire .hrn-offre-tarif__cartes {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .hrn-offre-tarif__carte--exemples {
      grid-column: auto;
    }
  }

  @media (min-width: 860px) {
    .hrn-offre-tarif__cartes--suivi {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    }
  }

  .hrn-offre-tarif__carte {
    min-width: 0;
    padding: 32px;
    background: var(--carte-claire);
    border: 1px solid var(--carte-claire-bordure);
    border-radius: var(--radius-xl);
  }

  .hrn-offre-tarif__carte--exemples {
    padding: 24px 28px;
  }

  .hrn-offre-tarif__carte--creme {
    background: var(--surface);
    border-color: var(--creme-bordure);
  }

  .hrn-offre-tarif__etiquette {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hrn-offre-tarif__montant {
    display: block;
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(2.4rem, 3.7vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--accent-texte);
  }

  .hrn-offre-tarif__detail {
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-offre-tarif__lignes {
    margin: 6px 0 0;
  }

  .hrn-offre-tarif__lignes > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--carte-claire-bordure);
    font-size: 15px;
  }

  .hrn-offre-tarif__lignes dt {
    min-width: 0;
    color: var(--text-secondary);
  }

  .hrn-offre-tarif__lignes dd {
    margin: 0;
    font-weight: var(--weight-semibold);
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .hrn-offre-tarif--claire .hrn-offre-tarif__inclus {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46rem;
  }

  .hrn-offre-tarif__suite {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 32px;
    background: var(--nuit-carte);
    border: 1px solid var(--nuit-carte-bordure);
    border-radius: var(--radius-xl);
  }

  .hrn-offre-tarif__suite .hrn-offre-tarif__etiquette {
    color: var(--text-muted);
  }

  .hrn-offre-tarif__suite h3 {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(1.3rem, 1.8vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-offre-tarif__suite-bouton {
    margin-top: auto;
    padding-top: 28px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offre-tarif__regle {
      transition: none;
    }

    .hrn-offre-tarif__regle:hover {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hrn-offre-tarif__pied {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
