---
// Questions fréquentes propres à une offre, commun aux deux pages.
//
// Porté du handoff Claude Design « Blocs Offres Herone » (bloc 1d).
//
// Volontairement SANS accordéon, contrairement à la FAQ de l'accueil, et le
// design le confirme. Trois raisons : les réponses sont ici des levées
// d'objection décisives (ce que devient le système, ce qui est financé, ce qui
// arrive aux données), elles doivent être lues sans qu'on ait à cliquer ; un
// texte replié n'est pas toujours pris en compte de la même façon par les
// moteurs ; et une page sans le moindre JavaScript reste une page sans le
// moindre JavaScript.
//
// Placement : après le tarif, avant le pont. C'est la dernière objection
// avant de proposer l'autre porte.

interface Props {
  eyebrow?: string;
  titre: string;
  questions: { q: string; r: string }[];
  /** Fond de la section, à choisir pour ne jamais répéter celui de la section précédente. */
  fond?: 'paper' | 'surface';
}

const { eyebrow = 'Questions fréquentes', titre, questions, fond = 'surface' } = Astro.props;
---

<section class:list={['hrn-offre-faq', `hrn-offre-faq--${fond}`, fond === 'paper' && 'hrn-zone-bleue']}>
  <div class="hrn-section-inner hrn-offre-faq__inner">
    <div class="hrn-offre-faq__head">
      <div class="hrn-eyebrow">{eyebrow}</div>
      <h2>{titre}</h2>
    </div>

    <dl class="hrn-offre-faq__list">
      {questions.map((item) => (
        <div class="hrn-offre-faq__item">
          <dt>{item.q}</dt>
          <dd>{item.r}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hrn-offre-faq {
    padding: var(--section-y) 0;
  }

  .hrn-offre-faq--paper {
    background: var(--bg-page);
  }

  .hrn-offre-faq--surface {
    background: var(--bg-surface);
  }

  .hrn-offre-faq__inner {
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-12));
  }

  .hrn-offre-faq__head {
    display: grid;
    gap: var(--space-4);
  }

  .hrn-offre-faq__head h2 {
    margin: 0;
    font: var(--type-h2);
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    max-width: none;
    text-wrap: balance;
    font-weight: var(--weight-titre);
  }

  /* minmax(min(…, 100%), 1fr) : une piste fixe plus large que le conteneur
     pousse toute la page en défilement horizontal sur un écran de 320px
     (piège n°1 du projet). */
  .hrn-offre-faq__list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-8) var(--space-16);
  }

  .hrn-offre-faq__item {
    min-width: 0;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  /* La question est en sans, pas en display : c'est du texte à lire, pas un
     titre de section. Le design pose bold sur --text-md. */
  .hrn-offre-faq__item dt {
    font-family: var(--font-sans);
    font-weight: var(--weight-titre);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--text-strong);
    text-wrap: balance;
    letter-spacing: var(--tracking-titre);
  }

  .hrn-offre-faq__item dd {
    margin: 0;
    font: var(--type-body);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
</style>
