---
// Avis écrits sur une offre. Emplacement en attente de contenu.
//
// La section ne rend RIEN tant que la liste est vide. C'est voulu, et c'est
// déjà le fonctionnement de ReviewsSection sur l'accueil : mieux vaut un
// emplacement invisible qu'un bloc « témoignages à venir », qui signale au
// visiteur qu'on n'en a pas encore.
//
// Pour la remplir : éditer le fichier de données correspondant dans
// src/data/. Aucune compétence technique nécessaire, ce sont des champs de
// texte. Les entrées apparaissent dans l'ordre du fichier.
//
// Les avis VIDÉO ne passent pas par ici : quand il y en aura, c'est
// ProofSection qui les porte (façade YouTube, aucune iframe au chargement).

interface Avis {
  nom: string;
  fonction?: string;
  entreprise: string;
  commune?: string;
  texte: string;
}

interface Props {
  eyebrow?: string;
  titre: string;
  avis: Avis[];
  /** Fond de la section, à choisir pour ne jamais répéter celui de la section précédente. */
  fond?: 'paper' | 'surface';
}

const { eyebrow = 'Ils y étaient', titre, avis, fond = 'surface' } = Astro.props;
---

{avis.length > 0 && (
  <section class:list={['hrn-offre-avis', `hrn-offre-avis--${fond}`]}>
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">{eyebrow}</div>
      <h2>{titre}</h2>

      <ul class="hrn-offre-avis__list" role="list">
        {avis.map((a) => (
          <li class="hrn-offre-avis__card">
            <blockquote>{a.texte}</blockquote>
            <p class="hrn-offre-avis__auteur">
              <span class="hrn-offre-avis__nom">{a.nom}</span>
              <span class="hrn-offre-avis__org">
                {[a.fonction, a.entreprise, a.commune].filter(Boolean).join(' · ')}
              </span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .hrn-offre-avis {
    padding: var(--section-y) 0;
  }

  .hrn-offre-avis--paper {
    background: var(--paper);
  }

  .hrn-offre-avis--surface {
    background: var(--surface);
  }

  /* minmax(min(…, 100%), 1fr) : une piste fixe plus large que le conteneur
     pousse toute la page en défilement horizontal sur un écran de 320px
     (piège n°1 du projet). */
  .hrn-offre-avis__list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }

  .hrn-offre-avis__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--paper);
  }

  .hrn-offre-avis--paper .hrn-offre-avis__card {
    background: var(--surface);
  }

  .hrn-offre-avis__card blockquote {
    margin: 0;
    flex: 1;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .hrn-offre-avis__auteur {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hrn-offre-avis__nom {
    font-weight: 600;
    font-size: 15px;
    color: var(--text-strong);
  }

  /* Pas de white-space: nowrap ici : une légende insécable dans une grille qui
     se resserre a déjà poussé toute la page en scroll horizontal ailleurs sur
     le site (piège n°1). */
  .hrn-offre-avis__org {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-muted);
  }
</style>
