---
import Button from './Button.astro';

interface Props {
  // "dark" : le header démarre transparent/texte blanc (pages avec un hero sombre
  // immédiatement dessous) puis bascule en clair au scroll. "light" : toujours clair.
  theme?: 'dark' | 'light';
}

const { theme = 'light' } = Astro.props;
---

<header id="hrn-header" class={`hrn-header hrn-header--${theme} hrn-zone-bleue`}>
  <div class="hrn-header__inner">
    <a href="/" class="hrn-header__logo">HÉRONE</a>

    <nav class="hrn-header__nav-desktop">
      <a href="/formation" class="hrn-sweep">Formation IA</a>
      <a href="/automatisation" class="hrn-sweep">Automatisation IA</a>
      <a href="/#temoignage" class="hrn-sweep">Témoignages</a>
      <a href="/#fondateurs" class="hrn-sweep">À propos</a>
      <a href="tel:+33663710598" class="hrn-header__phone hrn-sweep">06 63 71 05 98</a>
      <Button variant="accent" size="md" href="/#reserver">Réserver 30 minutes</Button>
    </nav>

    <div class="hrn-header__nav-mobile">
      <Button variant="accent" size="sm" href="/#reserver">Réserver</Button>
      <button type="button" id="hrn-menu-toggle" class="hrn-header__burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="hrn-mobile-menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<div id="hrn-mobile-menu" class="hrn-mobile-menu hrn-zone-bleue" hidden>
  <div class="hrn-mobile-menu__top hrn-mobile-menu__item" style="--i:0">
    <a href="/" class="hrn-header__logo hrn-mobile-menu__logo">HÉRONE</a>
    <button type="button" id="hrn-menu-close" aria-label="Fermer le menu" class="hrn-mobile-menu__close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav class="hrn-mobile-menu__nav">
    <a href="/formation" class="hrn-sweep hrn-mobile-menu__item" style="--i:1">Formation IA</a>
    <a href="/automatisation" class="hrn-sweep hrn-mobile-menu__item" style="--i:2">Automatisation IA</a>
    <a href="/#temoignage" class="hrn-sweep hrn-mobile-menu__item" style="--i:3">Témoignages</a>
    <a href="/#fondateurs" class="hrn-sweep hrn-mobile-menu__item" style="--i:4">À propos</a>
  </nav>
  <div class="hrn-mobile-menu__bottom hrn-mobile-menu__item" style="--i:5">
    <a href="tel:+33663710598" class="hrn-mobile-menu__phone hrn-sweep">06 63 71 05 98</a>
    <Button variant="accent" size="lg" block href="/#reserver">Réserver 30 minutes</Button>
  </div>
</div>

<style>
  .hrn-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(6px) saturate(1.3);
    -webkit-backdrop-filter: blur(6px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: background var(--dur) var(--ease-standard), border-color var(--dur) var(--ease-standard);
  }

  .hrn-header--light,
  .hrn-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    border-bottom-color: var(--border);
  }

  .hrn-header--dark:not(.is-scrolled) {
    background: color-mix(in srgb, var(--ink-950) 12%, transparent);
    border-bottom-color: color-mix(in srgb, #fff 14%, transparent);
  }

  .hrn-header__inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Logo agrandi le 22 septembre 2026 : 36px (26px auparavant), 30px sous
     640px. La hauteur de l'en-tête reste 68px. */
  .hrn-header__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 36px;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--text-strong);
    text-decoration: none;
  }

  @media (max-width: 639px) {
    .hrn-header__logo {
      font-size: 30px;
    }
  }

  .hrn-header--dark:not(.is-scrolled) .hrn-header__logo,
  .hrn-header--dark:not(.is-scrolled) .hrn-header__nav-desktop a:not(.hrn-btn) {
    color: #fff;
  }

  .hrn-header--dark:not(.is-scrolled) .hrn-header__nav-desktop a.hrn-sweep {
    --sweep-from: #fff;
  }

  .hrn-header--dark:not(.is-scrolled) .hrn-header__phone.hrn-sweep {
    --sweep-from: color-mix(in srgb, #fff 78%, transparent);
  }

  .hrn-header--dark:not(.is-scrolled) .hrn-header__phone {
    color: color-mix(in srgb, #fff 78%, transparent) !important;
  }

  /* 4 entrées + téléphone + bouton. La barre n'apparaît qu'à 1024px (voir la
     media query plus bas) : en dessous, elle n'a pas la place et c'est le menu
     au burger qui prend le relais. */
  .hrn-header__nav-desktop {
    display: none;
    align-items: center;
    gap: 22px;
  }

  .hrn-header__nav-desktop a:not(.hrn-btn) {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-strong);
  }

  /* Couleur de départ du balayage. L'arrivée est commune à tout le site
     (--sweep-to dans global.css), pour que navbar et pied de page s'allument
     exactement de la même couleur. */
  .hrn-header__nav-desktop a.hrn-sweep {
    --sweep-from: var(--text-strong);
  }

  .hrn-header__phone.hrn-sweep {
    --sweep-from: var(--text-secondary);
  }

  .hrn-header__phone {
    font-family: var(--font-mono);
    color: var(--text-secondary) !important;
  }

  .hrn-header__nav-mobile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Rond depuis le 23 septembre 2026, dans la continuité de la pilule
     « Réserver » posée à côté (--radius-sm auparavant). 44px : cible tactile. */
  .hrn-header__burger {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    color: var(--text-strong);
    cursor: pointer;
  }

  .hrn-header--dark:not(.is-scrolled) .hrn-header__burger {
    border-color: color-mix(in srgb, #fff 30%, transparent);
    color: #fff;
  }

  /* Le menu bureau n'apparaît qu'à 1080px, et non plus à 820px. Mesuré : la
     barre complète fait 782px ; avec le logo (109px) et le rembourrage
     (2 x 48px), il faut 1080px de fenêtre pour qu'il reste 93px entre le logo
     et la première entrée. À 820px, il n'en restait que 24, et « Automatisation
     IA » comme « Témoignages » ont encore allongé la barre depuis.
     Toute la plage tablette bascule donc sur le menu au burger, qui contient
     déjà les mêmes entrées, le téléphone compris. */
  @media (min-width: 1080px) {
    .hrn-header__nav-desktop {
      display: flex;
    }

    .hrn-header__nav-mobile {
      display: none;
    }
  }

  /* L'écartement de 28px n'est rendu qu'au-delà de 1200px. Mesuré : à 1024px,
     la barre au complet fait 795px avec cet écartement, et il ne reste alors
     que 24px entre elle et le logo. Resserré à 22px, elle tombe à 765px et
     l'espace remonte à 54px. « Automatisation IA » et « Témoignages » ont
     allongé la barre, c'est ce qui a rendu ce palier nécessaire. */
  @media (min-width: 1200px) {
    .hrn-header__nav-desktop {
      gap: 28px;
    }
  }

  /* Ouverture du menu, en deux temps : le panneau se fond, puis ses blocs
     montent un par un. On n'anime que opacity et transform, conformément aux
     conventions du projet ; `hidden` reste la source de vérité pour le retrait
     du flux, la classe .is-open ne pilote que l'animation. */
  .hrn-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    padding: 20px clamp(20px, 6vw, 32px);
    opacity: 0;
    transition: opacity 320ms var(--ease-standard);
  }

  .hrn-mobile-menu[hidden] { display: none; }

  .hrn-mobile-menu.is-open {
    opacity: 1;
    transition-duration: 300ms;
    transition-timing-function: var(--ease-out);
  }

  /* État fermé, qui sert aussi de trajectoire de sortie. La sortie est
     échelonnée à l'envers de l'entrée (le bas s'en va d'abord, le haut en
     dernier) : le menu se replie au lieu de disparaître d'un coup. --DERNIER
     est l'indice du dernier bloc, il sert à inverser le décalage. */
  .hrn-mobile-menu__item {
    --dernier: 5;
    opacity: 0;
    transform: translateY(-14px);
    transition:
      opacity 240ms var(--ease-standard),
      transform 240ms var(--ease-standard);
    transition-delay: calc((var(--dernier) - var(--i, 0)) * 30ms);
  }

  /* Entrée : plus lente que la sortie, courbe signature du projet, et décalée
     de 48ms par bloc pour que le menu se déplie au lieu d'apparaître d'un
     bloc. */
  .hrn-mobile-menu.is-open .hrn-mobile-menu__item {
    opacity: 1;
    transform: none;
    transition-duration: 380ms;
    transition-timing-function: var(--ease-out);
    transition-delay: calc(60ms + var(--i, 0) * 48ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-mobile-menu,
    .hrn-mobile-menu__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .hrn-mobile-menu__top {
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Le logo du menu ramène à l'accueil, comme celui de l'en-tête. Il déborde
     la rangée de 28px pour offrir une cible de 44px ; le menu se referme au
     clic, comme pour tous ses liens. */
  .hrn-mobile-menu__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hrn-mobile-menu__close {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
  }

  .hrn-mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 40px;
  }

  .hrn-mobile-menu__nav a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    color: var(--text-strong);
    padding: 14px 0;
    border-bottom: 1px solid var(--divider);
  }

  .hrn-mobile-menu__nav a.hrn-sweep {
    --sweep-from: var(--text-strong);
  }

  .hrn-mobile-menu__bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 16px;
  }

  .hrn-mobile-menu__phone {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--text-primary);
  }

  .hrn-mobile-menu__phone.hrn-sweep {
    --sweep-from: var(--text-primary);
  }

  @media (min-width: 1080px) {
    .hrn-mobile-menu { display: none !important; }
  }
</style>

<script>
  let ac: AbortController | undefined;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  function initHeader() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const header = document.querySelector('#hrn-header');
    const menu = document.querySelector<HTMLElement>('#hrn-mobile-menu');
    const openBtn = document.querySelector<HTMLButtonElement>('#hrn-menu-toggle');
    const closeBtn = document.querySelector<HTMLButtonElement>('#hrn-menu-close');

    if (!header) return;

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { signal, passive: true });

    // L'animation ne peut pas partir de `display: none` : à l'ouverture on
    // retire `hidden`, on force un reflow pour que l'état fermé soit peint,
    // puis on ajoute la classe qui déclenche la transition. À la fermeture,
    // l'inverse : on retire la classe et on ne remet `hidden` qu'une fois la
    // sortie terminée, sinon le panneau disparaîtrait d'un coup.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EXIT_MS = 380; // > sortie la plus tardive : 4 x 30ms de décalage + 240ms

    const openMenu = () => {
      if (!menu) return;
      clearTimeout(closeTimer);
      menu.hidden = false;
      void menu.offsetHeight; // force le reflow, sinon la transition est sautée
      menu.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      openBtn?.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    };

    const closeMenu = () => {
      if (!menu || menu.hidden) return;
      menu.classList.remove('is-open');
      document.body.style.overflow = '';
      openBtn?.setAttribute('aria-expanded', 'false');
      clearTimeout(closeTimer);
      // Sans animation, on masque tout de suite : laisser le panneau invisible
      // mais présent bloquerait les clics pendant la durée de la transition.
      if (reduce) {
        menu.hidden = true;
        return;
      }
      closeTimer = setTimeout(() => {
        menu.hidden = true;
      }, EXIT_MS);
    };

    openBtn?.addEventListener('click', openMenu, { signal });
    closeBtn?.addEventListener('click', () => {
      closeMenu();
      openBtn?.focus(); // le focus revient sur le bouton qui a ouvert le menu
    }, { signal });
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu, { signal }));

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && menu && !menu.hidden) {
          closeMenu();
          openBtn?.focus();
        }
      },
      { signal }
    );
  }

  function teardownHeader() {
    clearTimeout(closeTimer);
    ac?.abort();
    // Navigation alors que le menu est ouvert : le verrou de défilement doit
    // sauter, sinon la page suivante arrive bloquée.
    document.body.style.overflow = '';
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:before-swap', teardownHeader);
</script>
