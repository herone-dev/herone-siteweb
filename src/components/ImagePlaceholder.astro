---
// Reprend le style des "image-slot" du handoff de design : un espace réservé
// sobre (fond + icône + légende) tant qu'aucune vraie photo n'est fournie.
// Pour remplacer par une vraie image : dépose le fichier au chemin indiqué
// par `expectedPath` puis remplace ce composant par <Image src=... />.
interface Props {
  label: string;
  expectedPath: string;
  ratio?: string;
  rounded?: boolean;
}

const { label, expectedPath, ratio = '16/10', rounded = true } = Astro.props;
---

<div
  class="hrn-placeholder"
  style={`aspect-ratio:${ratio};border-radius:${rounded ? 'var(--radius-lg)' : '0'}`}
  title={`Image attendue : ${expectedPath}`}
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <circle cx="9" cy="9" r="2"></circle>
    <path d="m21 15-5-5L5 21"></path>
  </svg>
  <span>{label}</span>
</div>

<style>
  .hrn-placeholder {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px dashed var(--border-strong);
  }

  .hrn-placeholder span {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    padding: 0 12px;
  }
</style>
