---
// Les logiciels que nous connectons.
//
// Deux variantes :
//  - `defilant` (par défaut) : deux bandes de pastilles qui défilent en sens
//    opposés, sous un titre ;
//  - `statique` (maquettes du 24 septembre 2026, /automatisation) : le texte
//    à gauche, les pastilles fixes sur plusieurs lignes à droite, sans aucun
//    défilement. Le texte et la sélection de logiciels arrivent par les props
//    `eyebrow`, `titre`, `texte` et `noms` : la section remplace à la fois
//    l'ancien bloc « Avec quoi nous construisons / Ce que nous connectons » et
//    l'ancienne bande défilante.
const row1 = [
  'Gmail', 'Google Sheets', 'Google Drive', 'Google Agenda', 'Outlook', 'Excel', 'Word', 'Teams',
  'WhatsApp', 'LinkedIn', 'Facebook', 'Instagram', 'Qonto', 'Stripe', 'PayPal', 'Shopify',
  'PrestaShop', 'WooCommerce', 'HubSpot', 'Pipedrive', 'Salesforce', 'Zoho', 'Brevo', 'Sellsy',
  'Mailchimp', 'Calendly', 'Aircall',
];

const row2 = [
  'Axonaut', 'Pennylane', 'Indy', 'Sage', 'EBP', 'Cegid', 'Yousign', 'DocuSign', 'Ringover',
  'Notion', 'Airtable', 'Trello', 'Asana', 'monday', 'ClickUp', 'Slack', 'Typeform', 'Tally',
  'Google Forms', 'Dropbox', 'OneDrive', 'Zendesk', 'Crisp', 'Apify', 'Mistral', 'ChatGPT', 'Claude',
];
interface Props {
  /** Fond de la section, pour tenir l'alternance de la page qui l'accueille. */
  fond?: 'paper' | 'surface';
  variante?: 'defilant' | 'statique';
  eyebrow?: string;
  titre?: string;
  /** Variante `statique` : paragraphes du texte de gauche. */
  texte?: string[];
  /** Variante `statique` : les logiciels affichés. Par défaut, les deux bandes. */
  noms?: string[];
}

const { fond = 'surface', variante = 'defilant', eyebrow, titre, texte = [], noms = [...row1, ...row2] } = Astro.props;

---

{variante === 'statique' ? (
<section id="logiciels" class:list={['hrn-logos', 'hrn-logos--statique', `hrn-logos--${fond}`, fond === 'paper' ? 'hrn-zone-bleue' : 'hrn-zone-creme']}>
  <div class="hrn-section-inner hrn-logos__duo">
    <div class="hrn-logos__texte">
      {eyebrow && <div class="hrn-eyebrow">{eyebrow}</div>}
      {titre && <h2>{titre}</h2>}
      {texte.map((paragraphe) => <p class="hrn-lede">{paragraphe}</p>)}
    </div>
    <div class="hrn-logos__fixe">
      <ul class="hrn-logos__pastilles" role="list">
        {noms.map((nom) => <li>{nom}</li>)}
      </ul>
      <p class="hrn-logos__more">et plus de 500 autres</p>
    </div>
  </div>
</section>
) : (
<section id="logiciels" class:list={['hrn-logos', `hrn-logos--${fond}`, fond === 'paper' && 'hrn-zone-bleue']}>
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Logiciels</div>
    <h2>Les logiciels que nous automatisons</h2>
    <p class="hrn-lede">Nous connectons les outils que vous utilisez déjà.</p>

    <div class:list={['hrn-logos__rows', fond === 'paper' ? 'hrn-zone-creme' : 'hrn-zone-bleue']}>
      <div class="hrn-logos__row">
        <div class="hrn-logos__track hrn-logos__track--left">
          {[...row1, ...row1].map((name) => <span>{name}</span>)}
        </div>
      </div>
      <div class="hrn-logos__row">
        <div class="hrn-logos__track hrn-logos__track--right">
          {[...row2, ...row2].map((name) => <span>{name}</span>)}
        </div>
      </div>
    </div>

    <p class="hrn-logos__more">et plus de 500 autres</p>
  </div>
</section>
)}

<style>
  .hrn-logos {
    padding: var(--section-y) 0;
    scroll-margin-top: 68px;
    background: var(--surface);
  }

  .hrn-logos--paper {
    background: var(--paper);
  }

  /* Les pastilles sont posées sur le fond papier : quand la section le prend
     à son tour, elles passent sur surface pour ne pas s'y fondre. Même parade
     que SystemsGrid pour ses cartes. */
  .hrn-logos--paper .hrn-logos__track span {
    background: var(--surface);
  }

  .hrn-logos h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    margin: 14px 0 0 !important;
    max-width: 20ch;
  }

  .hrn-logos .hrn-lede {
    margin-top: 12px;
  }

  .hrn-logos__rows {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 26px;
  }

  .hrn-logos__row {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .hrn-logos__track {
    display: flex;
    width: max-content;
    gap: 12px;
    will-change: transform;
    transform: translateZ(0);
  }

  .hrn-logos__track--left {
    animation: hrn-marq-left 45s linear infinite;
  }

  .hrn-logos__track--right {
    animation: hrn-marq-right 45s linear infinite;
  }

  @media (max-width: 768px) {
    .hrn-logos__track--left {
      animation-duration: 28s;
    }
    .hrn-logos__track--right {
      animation-duration: 28s;
    }
  }

  .hrn-logos__track span {
    flex: none;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    color: var(--text-secondary);
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    white-space: nowrap;
  }

  /* ============ Variante « statique » ============ */

  .hrn-logos__duo {
    display: grid;
    gap: 40px 64px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hrn-logos__duo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .hrn-logos__texte,
  .hrn-logos__fixe {
    min-width: 0;
  }

  .hrn-logos--statique :global(.hrn-eyebrow) {
    color: var(--accent-texte);
  }

  .hrn-logos--statique h2 {
    max-width: 17em;
  }

  .hrn-logos--statique .hrn-lede {
    margin-top: 18px;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
  }

  .hrn-logos__pastilles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hrn-logos__pastilles li {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }

  .hrn-logos__more {
    margin-top: 18px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
