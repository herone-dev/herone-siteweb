---
import { Image } from 'astro:assets';
import posterRapin from '../../assets/images/posters/temoignage-poster.jpg';
import posterGautier from '../../assets/images/posters/temoignage-lixogo-poster.jpg';
import avatarRapin from '../../assets/images/proof-rapin.webp';
import avatarGautier from '../../assets/images/proof-gautier.webp';

// Section « Témoignages » : les avis en cartes vidéo, deux de front.
//
// Mise en page issue d'un handoff Claude Design (« Section témoignages »).
// Le design y était écrit pour le moteur de Claude Design (DCLogic, sc-for,
// sc-if) : il est porté ici en Astro + JavaScript natif, sans dépendance.
// Les tokens du design system sont les mêmes que ceux du repo.
//
// Écarts assumés par rapport au fichier de design, et pourquoi :
//
//  1. Le design lit des fichiers .mp4 posés dans le projet de maquette. Les
//     vrais témoignages sont sur YouTube, et la convention du repo est de ne
//     jamais charger un lecteur tiers avant le clic. Chaque carte reste donc
//     une façade : l'affiche et la citation d'abord, le lecteur injecté au
//     clic seulement. C'est aussi ce qui garde la section légère.
//  2. Le lecteur est chargé depuis youtube-nocookie.com : rien n'est déposé
//     tant que le visiteur n'a pas lancé la vidéo lui-même.
//  3. Le design fait de la carte entière un <button> contenant la citation.
//     Un bouton ne peut pas contenir de blockquote : la citation reste du
//     contenu normal, lisible par les lecteurs d'écran, et la commande est la
//     pastille de lecture. Le clic n'importe où sur la carte la déclenche
//     quand même, par commodité à la souris.
//     Cette pastille est un bouton, sans adresse YouTube. Elle a un temps
//     été un lien vers la vidéo, pour qu'elle reste utile sans JavaScript ;
//     mais un lien peut être intercepté avant notre code par ce qui entoure
//     la page, et le visiteur se retrouvait sur YouTube au lieu de regarder
//     sur place. Sans adresse, plus rien ne peut naviguer : le clic ne peut
//     que lancer la vidéo dans la carte. Contrepartie assumée : sans
//     JavaScript la vidéo ne se lance pas, mais l'affiche, la citation et
//     l'auteur restent tous lisibles.
//  4. Les cartes sont en 5/4. À cette proportion, sur un petit écran, la
//     citation débordait : la carte passe en 3/4 sous 560px. Au-delà, en
//     colonne unique, elle est déjà assez large pour que le 5/4 suffise.
//  5. Le padding vertical passe par --section-y, le rythme du projet.
//
// Ce que le design retire par rapport à la version précédente : le fil des
// étapes (« Rendez-vous enregistré, Transcription, Attribution ») et l'encart
// chiffré (« 0 saisie », « 1 rapport »), ainsi que les flèches et les puces
// du carrousel. Les deux avis sont désormais visibles en même temps.
interface Props {
  /** Fond de la section, pour tenir l'alternance de la page qui l'accueille. */
  fond?: 'paper' | 'surface';
  eyebrow?: string;
  titre?: string;
  /** `superpose` (par défaut, l'accueil) : la citation posée sur l'affiche.
      `cartes` (maquettes du 24 septembre 2026, /automatisation) : une carte
      blanche par témoignage, l'affiche en haut, la citation dessous. La vidéo
      se lance alors dans la zone de l'affiche, la citation reste lisible. */
  variante?: 'superpose' | 'cartes';
}

// La section vit aussi sur /automatisation, où elle sert de preuve à l'offre
// et non d'avis général : son en-tête doit pouvoir changer de contexte.
const { eyebrow = 'Témoignages', titre = "Ils l'utilisent tous les jours", fond = 'paper', variante = 'superpose' } = Astro.props;
const cartes = variante === 'cartes';

const testimonials = [
  {
    id: 'rapin',
    youtubeId: 'v4twsQsrw4E',
    poster: posterRapin,
    avatar: avatarRapin,
    quote: "« Le rendez-vous est enregistré, la fiche client arrive remplie en PDF, prête à envoyer. On choisit qui s'en occupe, le mail part. On ne ressaisit plus rien »",
    name: 'Tommy et Audrey Rapin',
    org: 'Agence Allianz des Herbiers · 9 personnes',
  },
  {
    id: 'gautier',
    youtubeId: 'gGe3-iVTSZI',
    poster: posterGautier,
    avatar: avatarGautier,
    quote: "« Les stats publicitaires sont récupérées, l'IA génère le rapport complet. Le client reçoit son PDF par mail, automatiquement, chaque début de mois »",
    name: 'Lilian Gautier',
    org: 'Agence Lixogo · La Rochelle · 7 personnes',
  },
];
---

<section id="temoignage" class:list={['hrn-proof', `hrn-proof--${fond}`, fond === 'paper' && 'hrn-zone-bleue', cartes && 'hrn-proof--cartes']}>
  <div class="hrn-proof__inner">
    <div class="hrn-eyebrow">{eyebrow}</div>
    <h2>{titre}</h2>

    <div class="hrn-proof__grid">
      {testimonials.map((t) => cartes ? (
        <article class:list={['hrn-proof__card', fond === 'paper' && 'hrn-zone-creme']} data-youtube-id={t.youtubeId}>
          <div class="hrn-proof__media">
            <Image
              src={t.poster}
              widths={[480, 900]}
              sizes="(max-width: 700px) 92vw, min(46vw, 600px)"
              quality={82}
              alt=""
              loading="lazy"
              class="hrn-proof__poster"
            />
            <button
              type="button"
              class="hrn-proof__play"
              aria-label={`Lire le témoignage vidéo de ${t.name}`}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
            </button>
          </div>
          <figure class="hrn-proof__content">
            <blockquote>{t.quote}</blockquote>
            <figcaption class="hrn-proof__author">
              <span class="hrn-proof__who">
                <span class="hrn-proof__name">{t.name}</span>
                <span class="hrn-proof__org">{t.org}</span>
              </span>
            </figcaption>
          </figure>
        </article>
      ) : (
        <article class="hrn-proof__card" data-youtube-id={t.youtubeId}>
          <Image
            src={t.poster}
            widths={[480, 900]}
            sizes="(max-width: 700px) 92vw, min(46vw, 640px)"
            quality={82}
            alt=""
            loading="lazy"
            class="hrn-proof__poster"
          />

          <div class="hrn-proof__veil" aria-hidden="true"></div>

          <button
            type="button"
            class="hrn-proof__play"
            aria-label={`Lire le témoignage vidéo de ${t.name}`}
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
          </button>

          <figure class="hrn-proof__content">
            <blockquote>{t.quote}</blockquote>
            <figcaption class="hrn-proof__author">
              <span class="hrn-proof__avatar">
                <Image src={t.avatar} width={80} height={80} alt="" loading="lazy" />
              </span>
              <span class="hrn-proof__who">
                <span class="hrn-proof__name">{t.name}</span>
                <span class="hrn-proof__org">{t.org}</span>
              </span>
            </figcaption>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-proof {
    padding: var(--section-y-lg) 0;
    background: var(--paper);
    color: var(--text-secondary);
    scroll-margin-top: 68px;
  }

  .hrn-proof--surface {
    background: var(--surface);
  }

  /* Le design ouvre le conteneur : --container-wide au lieu de --container-max,
     pour que les deux cartes respirent. */
  .hrn-proof__inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding-left: clamp(20px, 4vw, 56px);
    padding-right: clamp(20px, 4vw, 56px);
  }

  .hrn-proof :global(.hrn-eyebrow) {
    color: var(--label);
  }

  .hrn-proof :global(h2) {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-top: 14px;
    max-width: 22ch;
  }

  .hrn-proof__grid {
    display: grid;
    /* min(320px, 100%) et non 320px : une piste fixe plus large que le
       conteneur pousse toute la page en défilement horizontal. Mesuré à
       320px de fenêtre avant correction : 340px de contenu. */
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(20px, 2.2vw, 32px);
    margin-top: clamp(32px, 4vw, 56px);
  }

  /* ---------- Carte ---------- */
  .hrn-proof__card {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: 24px;
    overflow: hidden;
    background: var(--slate-800);
    cursor: pointer;
  }

  .hrn-proof__poster,
  .hrn-proof__card :global(.hrn-proof__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Voile dégradé : la citation doit rester lisible quelle que soit l'affiche.
     Même bleu nuit que le voile du hero (--hero-voile). Il était vert très
     foncé, à 88 / 52 / 12 % du bas vers le haut. Il reste sombre derrière les
     textes et s'efface au-dessus, là où sont les visages. Un allègement
     uniforme (70 / 35 / 0 %) a été mesuré : la ligne de l'agence tombait à
     2,9:1 de contraste. Avec ces paliers, la ligne la plus faible est à
     4,8:1, à 1440 comme à 390px. */
  .hrn-proof__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--hero-voile) 85%, transparent) 0%,
      color-mix(in srgb, var(--hero-voile) 60%, transparent) 40%,
      color-mix(in srgb, var(--hero-voile) 12%, transparent) 65%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ---------- Pastille de lecture ---------- */
  .hrn-proof__play {
    position: absolute;
    text-decoration: none;
    top: clamp(20px, 2.6vw, 40px);
    left: clamp(20px, 2.6vw, 40px);
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink-950);
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease-out),
      background var(--dur) var(--ease-standard);
  }

  .hrn-proof__card:hover .hrn-proof__play,
  .hrn-proof__play:focus-visible {
    background: #fff;
    transform: scale(1.06);
  }

  /* ---------- Citation et auteur ---------- */
  .hrn-proof__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: clamp(20px, 2.6vw, 40px);
    /* Le clic passe à travers : c'est la carte qui l'attrape. */
    pointer-events: none;
  }

  .hrn-proof__content blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(1.05rem, 1.8vw, 1.75rem);
    line-height: 1.24;
    letter-spacing: var(--tracking-titre);
    color: #fff;
    text-wrap: pretty;
  }

  .hrn-proof__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(14px, 1.6vw, 22px);
  }

  .hrn-proof__avatar {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: var(--slate-700);
    display: block;
  }

  .hrn-proof__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hrn-proof__who {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .hrn-proof__name {
    font-weight: 600;
    font-size: 15px;
    color: #fff;
  }

  .hrn-proof__org {
    font-size: 13px;
    color: var(--ink-300);
  }

  /* ---------- Lecture en cours ---------- */
  /* `visibility` en plus de l'opacité : sans elle, la pastille invisible
     resterait dans l'ordre de tabulation. */
  .hrn-proof__card.is-playing .hrn-proof__veil,
  .hrn-proof__card.is-playing .hrn-proof__content,
  .hrn-proof__card.is-playing .hrn-proof__play,
  .hrn-proof__card.is-playing .hrn-proof__poster,
  .hrn-proof__card.is-playing :global(.hrn-proof__poster) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .hrn-proof__card.is-playing {
    cursor: default;
  }

  /* ---------- Étroit ----------
     En 5/4 sur un petit écran, la citation débordait de la carte : on la rend
     plus haute que large. */
  @media (max-width: 560px) {
    .hrn-proof__card {
      aspect-ratio: 3 / 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-proof__play {
      transition: none;
    }
  }

  /* ============ Variante « cartes » ============ */

  /* Même largeur utile que les autres sections de la page. */
  .hrn-proof--cartes .hrn-proof__inner {
    max-width: var(--container-max);
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }

  .hrn-proof--cartes :global(.hrn-eyebrow) {
    color: var(--accent-texte);
  }

  .hrn-proof--cartes .hrn-proof__grid {
    gap: 24px;
  }

  /* Cartes blanches : sur un fond bleu (pages villes, 25 septembre 2026), la
     carte pose .hrn-zone-creme pour que la citation reprenne des couleurs de
     texte foncées. Sur le fond crème de /automatisation, rien ne change. */
  .hrn-proof--cartes .hrn-proof__card {
    aspect-ratio: auto;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--carte-claire);
    border: 1px solid var(--carte-claire-bordure);
  }

  .hrn-proof__media {
    position: relative;
    height: clamp(220px, 26vw, 320px);
    background: var(--nuit-profonde);
    overflow: hidden;
  }

  .hrn-proof--cartes .hrn-proof__play {
    top: 24px;
    left: 24px;
    width: 56px;
    height: 56px;
    background: var(--surface);
    color: var(--paper);
  }

  .hrn-proof--cartes .hrn-proof__content {
    position: static;
    padding: 26px 28px 28px;
  }

  .hrn-proof--cartes .hrn-proof__content blockquote {
    font-size: clamp(1.1rem, 1.5vw, 1.3125rem);
    line-height: 1.3;
    color: var(--text-strong);
  }

  .hrn-proof--cartes .hrn-proof__author {
    margin-top: 18px;
  }

  .hrn-proof--cartes .hrn-proof__name {
    font-size: 16px;
    color: var(--text-strong);
  }

  .hrn-proof--cartes .hrn-proof__org {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* Pendant la lecture, seule l'affiche et sa pastille s'effacent : la
     citation, sous la vidéo, reste en place. */
  .hrn-proof--cartes .hrn-proof__card.is-playing .hrn-proof__content {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  let ctrl: AbortController | undefined;

  function teardownProof() {
    ctrl?.abort();
    ctrl = undefined;
  }

  function initProof() {
    teardownProof();
    ctrl = new AbortController();
    const { signal } = ctrl;

    const cartes = [...document.querySelectorAll<HTMLElement>('.hrn-proof__card')];

    for (const carte of cartes) {
      const id = carte.dataset.youtubeId;
      if (!id) continue;

      const lancer = () => {
        if (carte.classList.contains('is-playing')) return;

        // Le lecteur n'est injecté qu'ici : rien n'est chargé chez YouTube
        // tant que le visiteur n'a pas cliqué.
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = 'Témoignage vidéo';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;';
        // Variante « cartes » : la vidéo prend la place de l'affiche seulement.
        (carte.querySelector<HTMLElement>('.hrn-proof__media') ?? carte).appendChild(iframe);
        carte.classList.add('is-playing');
      };

      // La pastille est la commande réelle, celle que voient le clavier et les
      // lecteurs d'écran. Le clic sur la carte n'est qu'une commodité.
      carte.querySelector<HTMLButtonElement>('.hrn-proof__play')
        ?.addEventListener('click', (event) => { event.stopPropagation(); lancer(); }, { signal });
      carte.addEventListener('click', lancer, { signal });
    }
  }

  document.addEventListener('astro:page-load', initProof);
  document.addEventListener('astro:before-swap', teardownProof);
</script>
