---
// Section « Avis clients ».
//
// POUR AJOUTER UN AVIS (aucune connaissance technique nécessaire) :
//   1. Ouvrir src/data/avis.json et copier un bloc existant dans la liste "avis".
//   2. Champs obligatoires : nom, entreprise, commune, texte.
//      Champs optionnels : fonction, photo, video (laisser "" si non renseigné).
//   3. Photo : déposer le fichier image dans src/assets/images/ puis écrire son
//      nom de fichier exact dans "photo" (exemple : "proof-rapin.webp").
//      Si le fichier est introuvable, la carte s'affiche simplement sans photo.
//   4. Video : coller l'URL complète du témoignage (exemple : lien YouTube).
//   5. "googleReviewsUrl" : URL de la fiche Google de l'entreprise. Tant que la
//      valeur reste vide, aucun lien « Voir tous nos avis sur Google » ne
//      s'affiche (pas de lien mort).
// La grille s'adapte seule, de 1 à 10 avis (et au-delà), sans carrousel.
// Tant que la liste "avis" est vide, la section entière ne rend RIEN : c'est le
// cas aujourd'hui, le témoignage Rapin étant déjà porté en format long par
// ProofSection (ne pas le republier ici, la page l'afficherait deux fois).
// Pour la même raison, l'ancre #avis n'est volontairement ciblée par aucun lien
// de navigation : elle deviendrait morte dès que la liste est vide.
//
// Animation : reveal d'entrée sobre (opacity + transform uniquement) en CSS +
// IntersectionObserver, conformément aux conventions du projet (pas de GSAP).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import avisData from '../../data/avis.json';

interface Avis {
  nom: string;
  fonction?: string;
  entreprise: string;
  commune: string;
  texte: string;
  photo?: string;
  video?: string;
}

// Cast volontairement large : le JSON est édité à la main, les champs
// optionnels peuvent être absents ou vides sans casser le typage.
const data = avisData as unknown as { googleReviewsUrl?: string; avis?: Avis[] };

const clean = (value?: string): string => (typeof value === 'string' ? value.trim() : '');

// Un avis sans nom ni texte est ignoré plutôt que de produire une carte vide.
const reviews = (Array.isArray(data.avis) ? data.avis : []).filter(
  (avis) => clean(avis.nom) !== '' && clean(avis.texte) !== ''
);

// Photos : toutes les images du dossier sont chargées à la compilation, puis
// associées par nom de fichier. Un nom introuvable donne simplement undefined.
// Les extensions sont listées dans les deux casses : un fichier sorti d'un
// appareil photo s'appelle souvent IMG_1234.JPG. La correspondance se fait
// ensuite en minuscules, pour que la casse saisie dans avis.json n'ait aucune
// importance.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/*.{webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,avif,AVIF}',
  { eager: true }
);

const photosByFile = new Map<string, ImageMetadata>();
for (const [path, module] of Object.entries(photoModules)) {
  const fileName = path.split('/').pop();
  if (fileName) photosByFile.set(fileName.toLowerCase(), module.default);
}

// Avec auto-fit + minmax, une carte isolée s'étirerait sur toute la largeur :
// on borne le conteneur tant qu'il y a moins de trois avis.
const columns = Math.min(reviews.length, 3);
const gridMaxWidth = columns >= 3 ? '100%' : `${columns * 420 + (columns - 1) * 20}px`;

const googleReviewsUrl = clean(data.googleReviewsUrl);
---

{reviews.length > 0 && (
  <section id="avis" class="hrn-reviews">
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">Avis clients</div>
      <h2>Ce que disent nos clients</h2>

      <div class="hrn-reviews__grid" id="reviews-grid" style={`--hrn-reviews-max: ${gridMaxWidth}`}>
        {reviews.map((avis, index) => {
          const nom = clean(avis.nom);
          const photoFile = clean(avis.photo);
          const photo = photoFile ? photosByFile.get(photoFile.toLowerCase()) : undefined;
          // Le rendu reste gracieux (carte sans photo), mais l'erreur de saisie
          // devient visible dans la console de build.
          if (photoFile && !photo) {
            console.warn(`[avis] photo introuvable dans src/assets/images/ : ${photoFile}`);
          }
          const video = clean(avis.video);
          // Pas de séparateur orphelin : seuls les champs renseignés sont joints.
          const attribution = [clean(avis.fonction), clean(avis.entreprise), clean(avis.commune)]
            .filter((part) => part !== '')
            .join(' · ');

          return (
            <article class="hrn-reviews__card" style={`--i: ${index}`}>
              <blockquote class="hrn-reviews__quote">« {clean(avis.texte)} »</blockquote>

              <div class="hrn-reviews__author">
                {photo && (
                  <div class="hrn-reviews__avatar">
                    <Image src={photo} alt={`Portrait de ${nom}`} width={96} height={96} />
                  </div>
                )}
                <div class="hrn-reviews__ident">
                  <strong>{nom}</strong>
                  {attribution && <span>{attribution}</span>}
                </div>
              </div>

              {video && (
                <a class="hrn-reviews__video" href={video} target="_blank" rel="noopener noreferrer">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
                  Voir le témoignage en vidéo
                </a>
              )}
            </article>
          );
        })}
      </div>

      {googleReviewsUrl && (
        <a class="hrn-reviews__google" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer">
          Voir tous nos avis sur Google
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      )}
    </div>
  </section>
)}

<style>
  .hrn-reviews {
    padding: clamp(56px, 8vw, 96px) 0;
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  .hrn-reviews :global(.hrn-eyebrow) {
    color: var(--slate-600);
  }

  .hrn-reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin-top: 40px;
    /* Borne calculée côté serveur : 1 avis = 1 colonne, 2 avis = 2 colonnes,
       3 avis et plus = pleine largeur (la grille se réorganise seule). */
    max-width: var(--hrn-reviews-max, 100%);
  }

  .hrn-reviews__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      box-shadow var(--dur) var(--ease-standard),
      transform var(--dur) var(--ease-standard),
      border-color var(--dur) var(--ease-standard);
  }

  .hrn-reviews__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .hrn-reviews__quote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .hrn-reviews__author {
    display: flex;
    align-items: center;
    gap: 12px;
    /* Aligne les attributions en bas des cartes, quelle que soit la longueur. */
    margin-top: auto;
  }

  .hrn-reviews__avatar {
    width: 48px;
    height: 48px;
    aspect-ratio: 1 / 1;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-2);
  }

  .hrn-reviews__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hrn-reviews__ident {
    min-width: 0;
  }

  .hrn-reviews__ident strong {
    display: block;
    font-weight: 600;
    font-size: 15px;
    color: var(--text-strong);
  }

  .hrn-reviews__ident span {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-reviews__video {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 600;
    color: var(--slate-600);
    transition: color var(--dur) var(--ease-standard);
  }

  .hrn-reviews__video:hover {
    color: var(--amber-600);
  }

  .hrn-reviews__google {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    font-weight: 600;
    color: var(--slate-600);
  }

  .hrn-reviews__video:focus-visible,
  .hrn-reviews__google:focus-visible {
    outline: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--focus-ring);
  }

  /* Reveal d'entrée : état initial masqué activé UNIQUEMENT par le JS
     (classe .reveals), pour que les avis restent visibles sans JS. */
  .hrn-reviews__grid.reveals .hrn-reviews__card {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .hrn-reviews__grid.reveals .hrn-reviews__card.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-reviews__grid.reveals .hrn-reviews__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardown() {
    io?.disconnect();
    io = undefined;
  }

  function initReviews() {
    teardown();

    const grid = document.querySelector<HTMLElement>('#reviews-grid');
    if (!grid) return;
    const cards = [...grid.children] as HTMLElement[];
    if (!cards.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.classList.add('reveals');

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io?.unobserve(entry.target); // reveal unique
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
    );

    cards.forEach((card) => io!.observe(card));
  }

  document.addEventListener('astro:page-load', initReviews);
  document.addEventListener('astro:before-swap', teardown);
</script>
