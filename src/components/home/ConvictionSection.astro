---
const items = [
  {
    title: 'Nous comprenons avant de construire',
    text: "Nous n'installons jamais un outil qui finira inutilisé, c'est de l'argent perdu. Tant que nous n'avons pas compris votre fonctionnement, nous ne construisons rien.",
  },
  {
    title: 'Le ROI décide',
    text: "Si un système ne rend pas des heures ou de l'argent réels, il ne sort pas.",
  },
  {
    title: 'Nous ne remplaçons personne',
    text: "Nous retirons les tâches qui n'apportent rien à vos équipes et nous les rendons à ce qui compte : la décision, le métier, le client.",
  },
];
---

<section class="hrn-conviction">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Notre conviction</div>
    <h2>Nous ne construisons que ce qui vous rend du temps.</h2>

    <div class="hrn-conviction__grid" id="conviction-grid">
      {items.map((item, i) => (
        <div class="hrn-conviction__item" style={`--i:${i}`}>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-conviction {
    padding: var(--section-y) 0;
    background: var(--paper);
  }

  .hrn-conviction :global(h2) {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .hrn-conviction__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .hrn-conviction__item h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }

  .hrn-conviction__item p {
    margin-top: 10px !important;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Apparition des blocs, un par un. L'état masqué n'est appliqué que par la
     classe .reveals, posée par le script : sans JavaScript ou en mouvement
     réduit, les trois blocs sont visibles d'emblée. Seuls opacity et transform
     sont animés. */
  .hrn-conviction__grid.reveals .hrn-conviction__item {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 520ms var(--ease-out),
      transform 520ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 160ms);
  }

  .hrn-conviction__grid.reveals .hrn-conviction__item.is-visible {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardownConviction() {
    io?.disconnect();
    io = undefined;
  }

  function initConviction() {
    teardownConviction();

    const grid = document.getElementById('conviction-grid');
    if (!grid) return;
    const items = [...grid.querySelectorAll<HTMLElement>('.hrn-conviction__item')];
    if (!items.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.classList.add('reveals');

    // La grille entière déclenche : les blocs se succèdent ensuite par leur
    // délai, ce qui garde l'ordre premier, deuxième, troisième même quand les
    // trois entrent dans l'écran en même temps.
    //
    // Le bord bas de la zone d'observation est remonté à 70% de la fenêtre :
    // sans cela la séquence partait alors que la grille affleurait à peine en
    // bas de l'écran, et elle était terminée avant que le visiteur ne l'ait
    // sous les yeux.
    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const item of items) item.classList.add('is-visible');
          io?.disconnect();
        }
      },
      { threshold: 0, rootMargin: '0px 0px -30% 0px' }
    );

    io.observe(grid);
  }

  document.addEventListener('astro:page-load', initConviction);
  document.addEventListener('astro:before-swap', teardownConviction);
</script>
