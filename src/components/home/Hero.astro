---
import { Picture } from 'astro:assets';
import heroPoster from '../../assets/images/posters/hero-poster.jpg';
---

<section class="hrn-hero" id="top">
  <div class="hrn-hero__media" aria-hidden="true">
    <Picture
      src={heroPoster}
      formats={['avif', 'webp']}
      widths={[600, 1200, 2000]}
      sizes="100vw"
      alt=""
      class="hrn-hero__poster"
      fetchpriority="high"
      loading="eager"
    />
    <video
      id="hero-video"
      class="hrn-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      poster="/images/posters/hero-poster.jpg"
    >
      <source data-src="/videos/hero-hevc.mp4" type='video/mp4; codecs="hvc1"' />
      <source data-src="/videos/hero-vp9.webm" type='video/webm; codecs="vp9"' />
      <source data-src="/videos/hero-h264.mp4" type="video/mp4" />
    </video>
    <div class="hrn-hero__dots"></div>
    <div class="hrn-hero__gradient-v"></div>
    <div class="hrn-hero__gradient-h"></div>
  </div>

  <div class="hrn-hero__content">
    <h1>Vos tâches répétitives, automatisées</h1>
    <p class="hrn-hero__subtitle">Hérone conçoit et installe des systèmes automatisés pour les TPE et PME.</p>

    <div class="hrn-hero__stats">
      <div class="hrn-hero__stat"><span>Sur mesure</span><small>Aucun logiciel imposé</small></div>
      <div class="hrn-hero__divider"></div>
      <div class="hrn-hero__stat"><span>Humain</span><small>Vos équipes retrouvent du temps</small></div>
      <div class="hrn-hero__divider"></div>
      <div class="hrn-hero__stat"><span>Local</span><small>Basés aux Herbiers</small></div>
    </div>
  </div>
</section>

<style>
  .hrn-hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: min(92vh, 900px);
    min-height: 720px;
    display: flex;
    align-items: center;
    padding-top: 88px;
    background: var(--slate-900);
  }

  .hrn-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hrn-hero__poster,
  .hrn-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .hrn-hero__video {
    opacity: 0;
    transition: opacity var(--dur-slower) var(--ease-standard);
  }

  .hrn-hero__video.is-ready {
    opacity: 1;
  }

  .hrn-hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, #fff 7%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    background-position: -13px -13px;
  }

  .hrn-hero__gradient-v {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink-950) 23%, transparent) 0%,
      color-mix(in srgb, var(--ink-950) 30%, transparent) 52%,
      color-mix(in srgb, var(--ink-950) 89%, transparent) 100%
    );
  }

  .hrn-hero__gradient-h {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      96deg,
      color-mix(in srgb, var(--ink-950) 33%, transparent) 0%,
      color-mix(in srgb, var(--ink-950) 8%, transparent) 52%,
      transparent 78%
    );
  }

  .hrn-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 48px);
  }

  .hrn-hero__content h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text-inverse);
    max-width: 18ch;
    text-wrap: balance;
  }

  .hrn-hero__subtitle {
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    line-height: 1.55;
    color: var(--ink-200);
    max-width: 56ch;
    margin-top: 28px !important;
    text-wrap: pretty;
  }

  .hrn-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--border-inverse);
  }

  .hrn-hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hrn-hero__stat span {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--text-inverse);
  }

  .hrn-hero__stat small {
    font-size: 14px;
    color: var(--ink-300);
  }

  .hrn-hero__divider {
    width: 1px;
    background: var(--border-inverse);
  }
</style>

<script>
  let ac: AbortController | undefined;

  function initHero() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const video = document.querySelector<HTMLVideoElement>('#hero-video');
    if (!video) return;

    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (isMobile) return; // mobile : poster fixe uniquement, pas d'autoplay vidéo

    const sources = video.querySelectorAll<HTMLSourceElement>('source[data-src]');
    if (sources.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          sources.forEach((source) => {
            source.src = source.dataset.src ?? '';
          });
          video.load();
          video.muted = true;
          video.play().catch(() => {});
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(video);

    video.addEventListener('playing', () => video.classList.add('is-ready'), { signal, once: true });
    signal.addEventListener('abort', () => observer.disconnect());
  }

  document.addEventListener('astro:page-load', initHero);
</script>
