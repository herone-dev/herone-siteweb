---
import { Picture } from 'astro:assets';
import heroPoster from '../../assets/images/posters/hero-poster.jpg';
---

<section class="hrn-hero" id="top">
  <div class="hrn-hero__media" aria-hidden="true">
    <Picture
      src={heroPoster}
      formats={['avif', 'webp']}
      widths={[600, 1200, 2000]}
      sizes="100vw"
      alt=""
      class="hrn-hero__poster"
      fetchpriority="high"
      loading="eager"
    />
    <video
      id="hero-video"
      class="hrn-hero__video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster="/images/posters/hero-poster.jpg"
    >
      <source data-src="/videos/hero-hevc.mp4" type='video/mp4; codecs="hvc1"' />
      <source data-src="/videos/hero-vp9.webm" type='video/webm; codecs="vp9"' />
      <source data-src="/videos/hero-h264.mp4" type="video/mp4" />
    </video>
    <div class="hrn-hero__dots"></div>
    <div class="hrn-hero__gradient-v"></div>
    <div class="hrn-hero__gradient-h"></div>
  </div>

  <div class="hrn-hero__content">
    <h1>Vos tâches répétitives, automatisées</h1>
    <p class="hrn-hero__subtitle">Hérone conçoit et installe des systèmes automatisés pour les TPE et PME.</p>

    <div class="hrn-hero__stats">
      <div class="hrn-hero__stat"><span>Sans changer vos logiciels</span><small>Nous connectons ceux que vous avez déjà.</small></div>
      <div class="hrn-hero__divider"></div>
      <div class="hrn-hero__stat"><span>Vos équipes retrouvent du temps</span><small>Nous formons jusqu'à ce que ça tourne sans nous.</small></div>
      <div class="hrn-hero__divider"></div>
      <div class="hrn-hero__stat"><span>À moins de 45 minutes</span><small>Basés aux Herbiers, nous venons sur place.</small></div>
    </div>
  </div>

  <a href="#constat" class="hrn-hero__scroll-indicator" aria-label="Défiler vers le bas">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </a>
</section>

<style>
  .hrn-hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100vh;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding-top: 88px;
    background: var(--slate-900);
    scroll-margin-top: 0;
  }

  @supports (height: 100dvh) {
    .hrn-hero {
      height: 100dvh;
    }
  }

  .hrn-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hrn-hero__poster,
  .hrn-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    border: 0;
  }

  .hrn-hero__video {
    opacity: 0;
    transition: opacity var(--dur-slower) var(--ease-standard);
  }

  .hrn-hero__video.is-ready {
    opacity: 1;
  }

  .hrn-hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, #fff 7%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    background-position: -13px -13px;
  }

  .hrn-hero__gradient-v {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink-950) 23%, transparent) 0%,
      color-mix(in srgb, var(--ink-950) 30%, transparent) 52%,
      color-mix(in srgb, var(--ink-950) 89%, transparent) 100%
    );
  }

  .hrn-hero__gradient-h {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      96deg,
      color-mix(in srgb, var(--ink-950) 33%, transparent) 0%,
      color-mix(in srgb, var(--ink-950) 8%, transparent) 52%,
      transparent 78%
    );
  }

  .hrn-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 48px);
  }

  .hrn-hero__content h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text-inverse);
    max-width: 18ch;
    text-wrap: balance;
  }

  .hrn-hero__subtitle {
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    line-height: 1.55;
    color: var(--ink-200);
    max-width: 56ch;
    margin-top: 28px !important;
    text-wrap: pretty;
  }

  .hrn-hero__stats {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: clamp(18px, 2.2vw, 28px);
    margin-top: 88px;
    padding-top: 28px;
    border-top: 1px solid var(--border-inverse);
  }

  /* colonnes d'égale largeur : les libellés longs se replient dans leur colonne
      au lieu de déborder ou de casser la rangée en 2 + 1 */
  .hrn-hero__stat {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hrn-hero__stat span {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.25vw, 1.125rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text-inverse);
    text-wrap: balance;
  }

  .hrn-hero__stat small {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-300);
    text-wrap: pretty;
  }

  .hrn-hero__divider {
    flex: 0 0 1px;
    width: 1px;
    background: var(--border-inverse);
  }

  @media (max-width: 720px) {
    .hrn-hero {
      height: auto;
      min-height: 100dvh;
    }

    .hrn-hero__stats {
      flex-direction: column;
      gap: 16px;
      margin-top: 40px;
      padding-top: 20px;
    }

    .hrn-hero__divider {
      display: none;
    }

    .hrn-hero__stat span {
      font-size: 1rem;
    }

    .hrn-hero__stat small {
      font-size: 13px;
    }
  }

  .hrn-hero__scroll-indicator {
    position: absolute;
    bottom: clamp(16px, 3vh, 28px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink-950) 45%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    color: var(--amber-300);
    text-decoration: none;
    transition: background var(--dur) var(--ease-standard), border-color var(--dur) var(--ease-standard), color var(--dur) var(--ease-standard);
    animation: hrnScrollBounce 2.2s infinite ease-in-out;
  }

  .hrn-hero__scroll-indicator:hover {
    background: color-mix(in srgb, var(--amber-500) 30%, transparent);
    border-color: var(--amber-300);
    color: #fff;
  }

  @keyframes hrnScrollBounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(7px);
    }
    60% {
      transform: translateX(-50%) translateY(3.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-hero__scroll-indicator {
      animation: none;
    }
  }
</style>

<script>
  let ac: AbortController | undefined;

  function initHero() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const video = document.querySelector<HTMLVideoElement>('#hero-video');
    if (!video) return;

    const sources = video.querySelectorAll<HTMLSourceElement>('source[data-src]');
    if (sources.length === 0) return;

    const startPlayback = () => {
      sources.forEach((source) => {
        if (!source.src && source.dataset.src) {
          source.src = source.dataset.src;
        }
      });
      video.load();
      video.muted = true;
      video.play().catch(() => {});
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          startPlayback();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    observer.observe(video);

    const handleMobileInteraction = () => {
      if (video.paused) {
        video.muted = true;
        video.play().catch(() => {});
      }
    };

    window.addEventListener('touchstart', handleMobileInteraction, { signal, once: true });
    window.addEventListener('scroll', handleMobileInteraction, { signal, once: true });

    video.addEventListener('playing', () => video.classList.add('is-ready'), { signal, once: true });
    signal.addEventListener('abort', () => observer.disconnect());
  }

  document.addEventListener('astro:page-load', initHero);
</script>
