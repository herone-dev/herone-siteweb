---
import { Image } from 'astro:assets';
import constatRessaisie from '../../assets/images/constat-ressaisie.webp';
import constatDevis from '../../assets/images/constat-devis.webp';
import constatComptes from '../../assets/images/constat-comptes.webp';
import constatReporting from '../../assets/images/constat-reporting.webp';
import constatDocuments from '../../assets/images/constat-documents.webp';
import constatMails from '../../assets/images/constat-mails.webp';

const cards = [
  {
    id: 'constat-ressaisie',
    image: constatRessaisie,
    tag: 'chaque jour',
    title: "Ressaisie d'un logiciel à l'autre",
    text: "Les mêmes informations recopiées d'un outil à un autre, avec le risque d'erreur à chaque fois.",
  },
  {
    id: 'constat-devis',
    image: constatDevis,
    tag: 'à chaque variante',
    title: 'Devis recalculés dans Excel',
    text: "Des feuilles dupliquées, une formule oubliée, et la marge qui saute sans qu'on le voie.",
  },
  {
    id: 'constat-comptes',
    image: constatComptes,
    tag: 'après chaque réunion',
    title: 'Comptes rendus retapés à la main',
    text: "Une à deux heures de rédaction après le rendez-vous, et des détails qui filent.",
  },
  {
    id: 'constat-reporting',
    image: constatReporting,
    tag: 'chaque fin de mois',
    title: 'Reporting mensuel refait',
    text: "Une journée à rassembler des chiffres épars, prêts trop tard pour décider.",
  },
  {
    id: 'constat-documents',
    image: constatDocuments,
    tag: 'dossier par dossier',
    title: 'Documents envoyés un par un',
    text: "Le même envoi répété à la main, client après client, sans traçabilité.",
  },
  {
    id: 'constat-mails',
    image: constatMails,
    tag: 'au quotidien',
    title: 'Mails et pièces à trier',
    text: "Des heures à ranger, transférer et classer ce qui arrive dans la boîte.",
  },
];
---

<section id="constat" class="hrn-constat">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Le constat</div>
    <h2>Ces tâches, quelqu'un les fait à la main chez vous</h2>

    <div class="hrn-constat__head">
      <p class="hrn-lede">Vous en reconnaissez au moins une dans votre entreprise.</p>
      <div class="hrn-constat__arrows">
        <button type="button" id="constat-prev" aria-label="Tâche précédente">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button type="button" id="constat-next" aria-label="Tâche suivante">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
    </div>

    <div class="hrn-constat__viewport" id="constat-viewport">
      <div class="hrn-constat__track" id="constat-track">
        {cards.map((card) => (
          <div class="hrn-constat__card">
            <div class="hrn-constat__thumb">
              <Image src={card.image} alt={card.title} width={678} height={450} />
              <span class="hrn-constat__badge">{card.tag}</span>
            </div>
            <div class="hrn-constat__body">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hrn-constat__dots" id="constat-dots" role="tablist" aria-label="Pagination du carrousel"></div>

    <p class="hrn-constat__summary">Des heures chaque semaine, des erreurs de recopie, des retards, et vos équipes sur de la saisie au lieu du client.</p>
    <p class="hrn-constat__accent">Ce temps a une meilleure place.</p>
  </div>
</section>

<style>
  .hrn-constat {
    padding: var(--section-y) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 68px;
  }

  .hrn-constat :global(.hrn-eyebrow) {
    color: var(--amber-600);
  }

  .hrn-constat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 16px 0 0;
  }

  .hrn-constat__arrows {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hrn-constat__arrows button {
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--paper);
    border: 1px solid var(--border-strong);
    color: var(--text-strong);
    cursor: pointer;
    transition: opacity var(--dur) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
  }

  .hrn-constat__arrows button:hover {
    background: var(--surface-2);
  }

  .hrn-constat__arrows button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .hrn-constat__viewport {
    margin-top: 36px;
    overflow: hidden;
  }



  .hrn-constat__track {
    display: flex;
    gap: 16px;
    will-change: transform;
    transition: transform 520ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hrn-constat__card {
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 260ms cubic-bezier(.4,0,.2,1), box-shadow 260ms cubic-bezier(.4,0,.2,1);
  }

  .hrn-constat__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 820px) {
    .hrn-constat__card {
      flex-basis: calc((100% - 32px) / 3);
    }
  }

  .hrn-constat__thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .hrn-constat__thumb :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hrn-constat__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--surface);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
  }

  .hrn-constat__body {
    padding: 18px 20px;
  }

  .hrn-constat__body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    color: var(--text-strong);
    margin: 0 0 5px !important;
  }

  .hrn-constat__body p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .hrn-constat__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  /* Les puces sont créées en JS : elles n'ont pas l'attribut de scope Astro,
     d'où :global() pour que ces règles les atteignent réellement.
     Chaque puce = une piste (fond neutre) + un remplissage accent (barre de
     progression). Le remplissage est animé en JS via scaleX (transform only). */
  :global(.hrn-constat__dots button) {
    position: relative;
    width: 28px;
    height: 6px;
    border-radius: var(--radius-full);
    border: 0;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    background: var(--border-strong);
    transition: width 320ms cubic-bezier(.4,0,.2,1);
  }

  :global(.hrn-constat__dots button[aria-current='true']) {
    width: 44px;
  }

  :global(.hrn-constat__dots button .hrn-constat__dot-fill) {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .hrn-constat__summary {
    margin: 34px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.4;
    color: var(--text-strong);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .hrn-constat__accent {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--amber-600);
  }
</style>

<script>
  let ac: AbortController | undefined;

  function initConstat() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const viewport = document.querySelector<HTMLElement>('#constat-viewport');
    const track = document.querySelector<HTMLElement>('#constat-track');
    const dotsEl = document.querySelector<HTMLElement>('#constat-dots');
    const prevBtn = document.querySelector<HTMLButtonElement>('#constat-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('#constat-next');
    if (!viewport || !track || !dotsEl || !prevBtn || !nextBtn) return;

    const cards = [...track.children] as HTMLElement[];
    const cardCount = cards.length;
    let index = 0;

    // Défilement automatique : une vignette toutes les 6 s, en boucle continue.
    // Désactivé si l'utilisateur préfère les animations réduites (accessibilité).
    const AUTOPLAY_MS = 6000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let progress: Animation | undefined; // barre de la puce courante = horloge du défilement

    // Sous 820px on laisse le navigateur défiler nativement (glissement du
    // doigt + inertie) ; au-dessus, on translate la piste.
    const swipeMode = () => window.matchMedia('(max-width: 819px)').matches;

    // Nombre de cartes visibles à la fois, et donc nombre de positions
    // possibles en avançant d'une carte : maxIndex = cardCount - perView.
    const perView = () => (window.matchMedia('(min-width: 820px)').matches ? 3 : 1);
    const maxIndex = () => Math.max(0, cardCount - perView());

    const buildDots = () => {
      dotsEl.innerHTML = '';
      for (let i = 0; i <= maxIndex(); i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Aller à la position ${i + 1}`);
        const fill = document.createElement('span');
        fill.className = 'hrn-constat__dot-fill';
        dot.appendChild(fill);
        dot.addEventListener('click', () => { goTo(i); restartAuto(); }, { signal });
        dotsEl.appendChild(dot);
      }
    };

    // Puces et flèches. Séparé du déplacement : un glissement au doigt met à
    // jour l'état sans qu'on ait à redéplacer la piste sous le doigt.
    const paint = () => {
      const max = maxIndex();
      prevBtn.disabled = index === 0;
      nextBtn.disabled = index === max;
      // Les puces passées sont pleines, les suivantes vides. La courante part
      // vide (sa barre sera animée) — ou pleine en mode reduced-motion.
      [...dotsEl.children].forEach((dot, i) => {
        dot.setAttribute('aria-current', String(i === index));
        const fill = dot.firstElementChild as HTMLElement | null;
        if (!fill) return;
        fill.getAnimations().forEach((a) => a.cancel());
        const filled = i < index || (i === index && reduce);
        fill.style.transform = filled ? 'scaleX(1)' : 'scaleX(0)';
      });
    };

    // Un défilement déclenché par le code ne doit pas être confondu avec un
    // glissement de l'utilisateur, sinon le chrono se relancerait en boucle.
    let programmatic = false;
    let guardTimer: ReturnType<typeof setTimeout>;

    const move = () => {
      const offset = cards[index].offsetLeft - cards[0].offsetLeft;
      track.style.transform = `translateX(-${offset}px)`;
    };

    const render = (smooth = true) => {
      const max = maxIndex();
      if (index > max) index = max;
      move(smooth);
      paint();
    };

    const goTo = (i: number) => {
      index = Math.min(maxIndex(), Math.max(0, i));
      render();
    };

    const advance = () => {
      const max = maxIndex();
      index = index >= max ? 0 : index + 1; // revient au début après la dernière
      render();
      startAuto();
    };

    // Lance (ou relance) la barre de progression de la puce courante ; à la fin
    // de la barre, on passe à la vignette suivante. Un seul chrono à la fois.
    const startAuto = () => {
      progress?.cancel();
      progress = undefined;
      if (reduce) return;
      const fill = dotsEl.children[index]?.firstElementChild as HTMLElement | null;
      if (!fill) return;
      progress = fill.animate(
        [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
        { duration: AUTOPLAY_MS, easing: 'linear', fill: 'forwards' }
      );
      progress.onfinish = advance;
    };
    const pauseAuto = () => progress?.pause();
    const resumeAuto = () => progress?.play();
    // Après une action manuelle, on repart d'une barre pleine à zéro.
    const restartAuto = () => startAuto();

    prevBtn.addEventListener('click', () => { goTo(index - 1); restartAuto(); }, { signal });
    nextBtn.addEventListener('click', () => { goTo(index + 1); restartAuto(); }, { signal });

    // Glissement au doigt sur écran tactile (mobile & tablette)
    let touchStartX = 0;
    viewport.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
    }, { signal, passive: true });

    viewport.addEventListener('touchend', (e: TouchEvent) => {
      const deltaX = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(deltaX) > 35) {
        if (deltaX < 0) {
          goTo(index + 1);
        } else {
          goTo(index - 1);
        }
        restartAuto();
      }
    }, { signal, passive: true });

    // Pause au survol / focus clavier, et quand l'onglet passe en arrière-plan.
    viewport.addEventListener('pointerenter', pauseAuto, { signal });
    viewport.addEventListener('pointerleave', resumeAuto, { signal });
    // Sur tactile, un geste interrompu n'émet pas toujours pointerleave : sans
    // ce filet, le chrono resterait en pause indéfiniment.
    viewport.addEventListener('pointercancel', resumeAuto, { signal });
    viewport.addEventListener('focusin', pauseAuto, { signal });
    viewport.addEventListener('focusout', resumeAuto, { signal });
    document.addEventListener(
      'visibilitychange',
      () => (document.hidden ? pauseAuto() : resumeAuto()),
      { signal }
    );
    signal.addEventListener('abort', () => progress?.cancel());

    buildDots();
    render(false);
    startAuto();

    // Sur mobile, l'apparition et le masquage de la barre d'adresse émettent un
    // `resize` alors que seule la hauteur change. L'ancien gestionnaire y
    // relançait startAuto() : la barre de progression repartait à zéro à chaque
    // défilement de la page. On ne réagit donc qu'aux changements de LARGEUR.
    let lastWidth = window.innerWidth;
    let lastPerView = perView();
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const nextPerView = perView();
          const modeChanged = nextPerView !== lastPerView;
          lastPerView = nextPerView;
          if (modeChanged) {
            // On quitte ou on rejoint le défilement natif : les deux modes ne
            // se positionnent pas pareil, on remet le viewport à plat.
            viewport.scrollLeft = 0;
            index = 0;
            buildDots();
          }
          render(false);
          startAuto();
        }, 150);
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', initConstat);
  document.addEventListener('astro:before-swap', () => ac?.abort());
</script>
