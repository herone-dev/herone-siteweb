---
import { Image } from 'astro:assets';
import constatRessaisie from '../../assets/images/constat-ressaisie.webp';
import constatDevis from '../../assets/images/constat-devis.webp';
import constatComptes from '../../assets/images/constat-comptes.webp';
import constatReporting from '../../assets/images/constat-reporting.webp';
import constatDocuments from '../../assets/images/constat-documents.webp';
import constatMails from '../../assets/images/constat-mails.webp';

// Section « Le constat » : six tâches faites à la main, en grands panneaux
// qui défilent horizontalement.
//
// Mise en page issue d'un handoff Claude Design (« Section constat - Apple »).
// Le design y était écrit pour le moteur de Claude Design (DCLogic, sc-for,
// interpolation) : il est porté ici en Astro + JavaScript natif, sans
// dépendance. Les tokens du design system sont les mêmes que ceux du repo.
//
// Le design pose des emplacements d'image vides (« Photo terrain ») dont les
// identifiants reprennent exactement les six visuels déjà présents dans le
// repo : ce sont eux qui sont branchés.
//
// Écarts assumés par rapport au fichier de design, et pourquoi :
//
//  1. Les panneaux sont en 16/10. À cette proportion, sur un écran étroit, le
//     titre et le texte posés par-dessus débordaient du panneau. La proportion
//     passe donc en 4/5 sous 760px, où la place manque en largeur mais pas en
//     hauteur.
//  2. Le design écoute les flèches du clavier sur `window`, ce qui les
//     confisquerait à toute la page. L'écoute est posée sur la section.
//  3. Le padding vertical passe par --section-y : dans ce projet, aucune
//     section ne code son rythme en dur.
//  4. color-mix() est remplacé par des rgba() équivalentes.
//
//  5. Le défilement est confié au navigateur (overflow-x + scroll-snap) plutôt
//     qu'à une piste en translateX pilotée en JavaScript, comme le faisait le
//     design. Mesuré au navigateur, la version JavaScript avait deux défauts :
//     un seul geste de trackpad faisait avancer de trois vignettes, et sur
//     mobile le glissement se battait avec le navigateur, qui reprenait la
//     main au moindre début vertical. En natif, un geste vaut une vignette par
//     construction, l'inertie est celle du système, et tout marche sans
//     JavaScript.
//
// Écart assumé aux conventions d'animation : la puce active s'élargit de 6 à
// 34px, donc `width` est animée là où la règle est de n'animer que transform
// et opacity. Sur six éléments de 6px dans une barre isolée, le coût est
// négligeable, et le rendre en transform fausserait l'espacement des puces.
//
// Le défilement automatique avance d'une vignette toutes les 6 secondes et
// repart au début après la dernière. Il s'arrête au survol, quand le focus
// entre dans la section, et tant que la section n'est pas à l'écran ; il
// repart du bon endroit après une navigation manuelle, pour ne jamais tirer
// la piste sous le doigt du visiteur. Il n'existe pas du tout en mouvement
// réduit. La navigation reste au doigt, à la molette, aux puces, aux flèches.
//
// Taille des panneaux : plafonnée à 678px, la largeur native des six photos.
// Au-delà elles étaient étirées et visiblement molles.
//
// Les photos sont servies en WebP seul, et non en AVIF puis WebP comme
// ailleurs sur le site. Les sources sont déjà des WebP compressés : réencoder
// en AVIF ne fait que ré-encoder leurs artefacts. Mesuré sur la même image en
// 678px : 69 ko en AVIF contre 45 ko en WebP, pour un rendu identique. Le
// repli PNG que produisait <Picture> pesait 148 ko et n'aurait servi qu'à des
// navigateurs sans WebP, c'est-à-dire plus aucun.
const tasks = [
  {
    image: constatRessaisie,
    badge: 'chaque jour',
    title: "Ressaisie d'un logiciel à l'autre",
    body: "Les mêmes informations recopiées d'un outil à un autre, avec le risque d'erreur à chaque fois.",
  },
  {
    image: constatDevis,
    badge: 'à chaque variante',
    title: 'Devis recalculés dans Excel',
    body: "Des feuilles dupliquées, une formule oubliée, et la marge qui saute sans qu'on le voie.",
  },
  {
    image: constatComptes,
    badge: 'après chaque réunion',
    title: 'Comptes rendus retapés à la main',
    body: 'Une à deux heures de rédaction après le rendez-vous, et des détails qui filent.',
  },
  {
    image: constatReporting,
    badge: 'chaque fin de mois',
    title: 'Reporting mensuel refait',
    body: 'Une journée à rassembler des chiffres épars, prêts trop tard pour décider.',
  },
  {
    image: constatDocuments,
    badge: 'dossier par dossier',
    title: 'Documents envoyés un par un',
    body: 'Le même envoi répété à la main, client après client, sans traçabilité.',
  },
  {
    image: constatMails,
    badge: 'au quotidien',
    title: 'Mails et pièces à trier',
    body: 'Des heures à ranger, transférer et classer ce qui arrive dans la boîte.',
  },
];
---

<section id="constat" class="hrn-constat">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Le constat</div>
    <h2>Ces tâches, quelqu'un les fait à la main chez vous</h2>
    <p class="hrn-lede">Vous en reconnaissez au moins une dans votre entreprise.</p>
  </div>

  <div
    class="hrn-constat__viewport"
    id="constat-viewport"
    aria-roledescription="carousel"
    aria-label="Six tâches faites à la main"
  >
    <ul class="hrn-constat__track" id="constat-track" role="list">
      {tasks.map((task, i) => (
        <li
          class="hrn-constat__panel"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} sur ${tasks.length} : ${task.title}`}
        >
          <Image
            src={task.image}
            widths={[400, 678]}
            sizes="clamp(280px, 52vw, 678px)"
            quality={90}
            alt=""
            loading="lazy"
            class="hrn-constat__photo"
          />
          <span class="hrn-constat__badge">{task.badge}</span>
          <div class="hrn-constat__overlay">
            <h3>{task.title}</h3>
            <p>{task.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div class="hrn-section-inner hrn-constat__controls">
    <div class="hrn-constat__dots" id="constat-dots">
      {tasks.map((task, i) => (
        <button
          type="button"
          class:list={['hrn-constat__dot', { 'is-active': i === 0 }]}
          data-index={i}
          aria-label={`Aller à : ${task.title}`}
          aria-current={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>

    <button type="button" id="constat-prev" class="hrn-constat__arrow" aria-label="Tâche précédente" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button type="button" id="constat-next" class="hrn-constat__arrow" aria-label="Tâche suivante">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
  </div>

  <div class="hrn-section-inner hrn-constat__foot">
    <p class="hrn-constat__summary">Des heures chaque semaine, des erreurs de recopie, des retards, et vos équipes sur de la saisie au lieu du client.</p>
    <p class="hrn-constat__accent">Ce temps a une meilleure place.</p>
  </div>
</section>

<style>
  .hrn-constat {
    padding: var(--section-y) 0;
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  .hrn-constat :global(.hrn-eyebrow) {
    color: var(--amber-600);
  }

  /* Le titre est plus grand que celui des autres sections : c'est l'ouverture
     de la page, le design l'assume comme telle. */
  .hrn-constat :global(h2) {
    font-size: clamp(2.1rem, 5.4vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-top: 16px;
    max-width: 22ch;
  }

  .hrn-constat :global(.hrn-lede) {
    margin-top: 22px;
    max-width: 48ch;
  }

  /* ---------- Piste ----------

     Le défilement est celui du navigateur, avec accrochage. C'est lui qui gère
     le doigt, la molette, l'inertie et le clavier : un geste vaut une vignette,
     et rien ne fonctionne « contre » lui. Le script se contente de lire la
     position pour allumer la bonne puce, et de poser une cible au clic. */
  .hrn-constat__viewport {
    margin-top: clamp(32px, 4.5vw, 68px);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .hrn-constat__viewport::-webkit-scrollbar {
    display: none;
  }

  /* Pendant un glissement à la souris, l'accrochage est suspendu : sinon il
     ramènerait la piste à chaque micro-mouvement. */
  .hrn-constat__viewport.is-dragging {
    scroll-snap-type: none;
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hrn-constat__viewport {
      cursor: grab;
    }
  }

  .hrn-constat__track {
    list-style: none;
    margin: 0;
    /* Les marges de bout permettent au premier et au dernier panneau de
       s'aligner sur la gouttière de la page. */
    padding-top: 0;
    padding-bottom: 0;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
    display: flex;
    gap: 22px;
  }

  .hrn-constat__panel {
    position: relative;
    /* Plafonné à 678px : c'est la largeur native des photos, au-delà elles
       seraient étirées. */
    flex: 0 0 clamp(280px, 52vw, 678px);
    aspect-ratio: 16 / 10;
    border-radius: 32px;
    background: var(--surface-2);
    overflow: hidden;
    scroll-snap-align: center;
    user-select: none;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .hrn-constat__photo,
  .hrn-constat__panel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Le glissement ne doit pas se transformer en glisser-déposer d'image. */
    -webkit-user-drag: none;
    pointer-events: none;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  /* Léger relief au survol et sous le doigt : la photo avance dans son cadre,
     le panneau se soulève. Uniquement transform. */
  @media (hover: hover) and (pointer: fine) {
    .hrn-constat__panel:hover {
      transform: translateY(-4px);
    }

    .hrn-constat__panel:hover .hrn-constat__photo,
    .hrn-constat__panel:hover :global(img) {
      transform: scale(1.045);
    }
  }

  .hrn-constat__panel.is-pressed {
    transform: scale(0.985);
  }

  .hrn-constat__panel.is-pressed .hrn-constat__photo,
  .hrn-constat__panel.is-pressed :global(img) {
    transform: scale(1.02);
  }

  .hrn-constat__badge {
    position: absolute;
    top: clamp(16px, 2vw, 30px);
    left: clamp(16px, 2vw, 30px);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--slate-700);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    background: rgba(248, 244, 232, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
  }

  .hrn-constat__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(20px, 3.2vw, 44px);
    background: linear-gradient(
      to top,
      rgba(15, 29, 20, 0.78) 0%,
      rgba(15, 29, 20, 0.46) 52%,
      transparent 100%
    );
    pointer-events: none;
  }

  .hrn-constat__overlay h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-inverse);
    margin: 0;
    max-width: 26ch;
    text-wrap: balance;
  }

  .hrn-constat__overlay p {
    font-size: clamp(0.92rem, 1.15vw, 1.1rem);
    line-height: 1.5;
    color: var(--ink-200);
    margin: 12px 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  /* ---------- Commandes ---------- */
  .hrn-constat__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .hrn-constat__dots {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 20px;
    border-radius: var(--radius-full);
    background: var(--surface);
  }

  /* Écart assumé : c'est `width` qui est animée, pas transform. Six éléments
     de 6px dans une barre isolée, le reflow est négligeable, et passer par un
     scaleX fausserait l'espacement entre les puces. */
  .hrn-constat__dot {
    height: 6px;
    width: 6px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--ink-300);
    cursor: pointer;
    transition:
      width 420ms var(--ease-standard),
      background 420ms var(--ease-standard);
  }

  .hrn-constat__dot.is-active {
    width: 34px;
    background: var(--ink-900);
  }

  .hrn-constat__arrow {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 0;
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-standard),
      opacity var(--dur-fast) var(--ease-standard);
  }

  .hrn-constat__arrow:hover:not(:disabled) {
    background: var(--surface-2);
  }

  .hrn-constat__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* ---------- Pied de section ---------- */
  .hrn-constat__foot {
    margin-top: clamp(40px, 5vw, 76px);
  }

  .hrn-constat__summary {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .hrn-constat__accent {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    letter-spacing: -0.02em;
    color: var(--amber-600);
  }

  /* ---------- Étroit ----------
     En 16/10 sur un petit écran, le titre et le texte posés par-dessus
     débordaient du panneau. On le rend plus haut que large. */
  @media (max-width: 760px) {
    .hrn-constat__panel {
      aspect-ratio: 4 / 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-constat__panel,
    .hrn-constat__photo,
    .hrn-constat__panel :global(img),
    .hrn-constat__dot {
      transition: none;
    }
  }
</style>

<script>
  let section: HTMLElement | null = null;
  let viewport: HTMLElement | null = null;
  let panels: HTMLElement[] = [];
  let dots: HTMLButtonElement[] = [];
  let actif = 0;
  let ctrl: AbortController | undefined;
  let frame = 0;

  // Défilement automatique
  const DELAI_AUTO = 6000;
  let minuteur: ReturnType<typeof setInterval> | undefined;
  let auto = false;      // le défilement automatique est-il souhaité ici ?
  let enPause = false;   // survol, focus, ou section hors de l'écran

  function teardownConstat() {
    ctrl?.abort();
    ctrl = undefined;
    cancelAnimationFrame(frame);
    frame = 0;
    clearInterval(minuteur);
    minuteur = undefined;
    auto = false;
    enPause = false;
    section = null;
    viewport = null;
    panels = [];
    dots = [];
    actif = 0;
  }

  // Le panneau actif est celui dont le centre est le plus proche du centre de
  // la fenêtre de défilement. On le déduit de la position réelle plutôt que de
  // le compter : le navigateur reste seul maître du défilement.
  function panneauCourant() {
    if (!viewport || !panels.length) return 0;

    // Aux deux extrémités, la piste est bloquée : le dernier panneau ne peut
    // plus se centrer, et c'est son voisin qui se retrouve le plus près du
    // milieu. Sans ce cas particulier, cliquer la dernière puce en allumait
    // une autre. On tranche donc par la position de défilement.
    const fin = viewport.scrollWidth - viewport.clientWidth;
    if (viewport.scrollLeft <= 1) return 0;
    if (viewport.scrollLeft >= fin - 1) return panels.length - 1;

    const centre = viewport.scrollLeft + viewport.clientWidth / 2;
    let meilleur = 0;
    let ecartMin = Infinity;
    panels.forEach((panneau, i) => {
      const c = panneau.offsetLeft + panneau.offsetWidth / 2;
      const ecart = Math.abs(c - centre);
      if (ecart < ecartMin) {
        ecartMin = ecart;
        meilleur = i;
      }
    });
    return meilleur;
  }

  function rafraichir() {
    if (!viewport) return;
    const courant = panneauCourant();
    if (courant !== actif) {
      actif = courant;
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === actif);
        dot.setAttribute('aria-current', i === actif ? 'true' : 'false');
      });
      panels.forEach((panneau, i) => {
        panneau.setAttribute('aria-hidden', i === actif ? 'false' : 'true');
      });
    }

    // Les flèches suivent les extrémités réelles du défilement, et non l'index :
    // sur un grand écran plusieurs panneaux tiennent à la fois, la dernière
    // vignette peut donc être atteinte avant le dernier index.
    const prec = document.getElementById('constat-prev') as HTMLButtonElement | null;
    const suiv = document.getElementById('constat-next') as HTMLButtonElement | null;
    const fin = viewport.scrollWidth - viewport.clientWidth;
    if (prec) prec.disabled = viewport.scrollLeft <= 1;
    if (suiv) suiv.disabled = viewport.scrollLeft >= fin - 1;
  }

  function allerVers(index: number) {
    if (!viewport || !panels.length) return;
    const cible = panels[Math.min(panels.length - 1, Math.max(0, index))];
    if (!cible) return;
    const doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // On vise le centre : le même point que celui sur lequel l'accrochage se
    // cale, la position finale est donc exactement la même qu'au doigt.
    const gauche = cible.offsetLeft - (viewport.clientWidth - cible.offsetWidth) / 2;
    viewport.scrollTo({ left: gauche, behavior: doux ? 'smooth' : 'auto' });
  }

  // Le minuteur est relancé à chaque navigation manuelle : sinon la vignette
  // suivante pouvait arriver juste après un clic, et donner l'impression que
  // le carrousel part tout seul au mauvais moment.
  function relancerAuto() {
    clearInterval(minuteur);
    minuteur = undefined;
    if (!auto || enPause) return;
    minuteur = setInterval(() => {
      if (!viewport || !panels.length) return;
      const courant = panneauCourant();
      allerVers(courant >= panels.length - 1 ? 0 : courant + 1);
    }, DELAI_AUTO);
  }

  function initConstat() {
    teardownConstat();

    section = document.getElementById('constat');
    viewport = document.getElementById('constat-viewport');
    if (!section || !viewport) return;

    panels = [...viewport.querySelectorAll<HTMLElement>('.hrn-constat__panel')];
    dots = [...document.querySelectorAll<HTMLButtonElement>('.hrn-constat__dot')];
    if (!panels.length) return;

    ctrl = new AbortController();
    const { signal } = ctrl;

    rafraichir();

    // Le défilement est lu au rythme de l'affichage : on ne fait qu'y lire des
    // positions, jamais écrire, donc aucune lutte avec le navigateur.
    viewport.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(rafraichir);
    }, { signal, passive: true });

    document.getElementById('constat-prev')?.addEventListener('click', () => { allerVers(panneauCourant() - 1); relancerAuto(); }, { signal });
    document.getElementById('constat-next')?.addEventListener('click', () => { allerVers(panneauCourant() + 1); relancerAuto(); }, { signal });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { allerVers(i); relancerAuto(); }, { signal }));

    // Les flèches du clavier sont écoutées sur la section et non sur window :
    // sinon elles seraient confisquées au reste de la page.
    section.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); allerVers(panneauCourant() + 1); }
      else if (event.key === 'ArrowLeft') { event.preventDefault(); allerVers(panneauCourant() - 1); }
    }, { signal });

    /* -------------------------------------------- glissement à la souris ---
       Uniquement à la souris : au doigt, c'est le navigateur qui défile, et
       s'interposer était précisément ce qui cassait le tactile. On ne fait
       que déplacer scrollLeft, l'accrochage reprend la main au relâchement. */
    let departX = 0;
    let departScroll = 0;
    let pointeur: number | null = null;
    let aBouge = false;

    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      if (event.button !== 0) return;
      pointeur = event.pointerId;
      departX = event.clientX;
      departScroll = viewport!.scrollLeft;
      aBouge = false;
    }, { signal });

    viewport.addEventListener('pointermove', (event) => {
      if (pointeur === null || event.pointerId !== pointeur || !viewport) return;
      const dx = event.clientX - departX;
      if (!aBouge) {
        if (Math.abs(dx) < 5) return;
        aBouge = true;
        viewport.setPointerCapture(pointeur);
        viewport.classList.add('is-dragging');
      }
      event.preventDefault();
      viewport.scrollLeft = departScroll - dx;
    }, { signal });

    const finGlissement = () => {
      if (pointeur === null || !viewport) return;
      pointeur = null;
      viewport.classList.remove('is-dragging');
      if (!aBouge) return;
      // L'accrochage est de nouveau actif : on le laisse choisir la vignette la
      // plus proche, exactement comme après un geste au doigt.
      allerVers(panneauCourant());
    };

    viewport.addEventListener('pointerup', finGlissement, { signal });
    viewport.addEventListener('pointercancel', finGlissement, { signal });
    viewport.addEventListener('lostpointercapture', finGlissement, { signal });

    /* ------------------------------------ défilement automatique --------- */
    auto = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (auto) {
      const suspendre = () => { enPause = true; relancerAuto(); };
      const reprendre = () => { enPause = false; relancerAuto(); };

      // On ne tire jamais la piste sous le doigt ni sous le curseur.
      viewport.addEventListener('pointerenter', suspendre, { signal });
      viewport.addEventListener('pointerleave', reprendre, { signal });
      viewport.addEventListener('pointerdown', suspendre, { signal });
      viewport.addEventListener('touchstart', suspendre, { signal, passive: true });
      section.addEventListener('focusin', suspendre, { signal });
      section.addEventListener('focusout', reprendre, { signal });

      // Rien ne tourne tant que la section n'est pas à l'écran.
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          enPause = !entry.isIntersecting;
          relancerAuto();
        }
      }, { threshold: 0.25 });
      io.observe(section);
      signal.addEventListener('abort', () => io.disconnect());

      relancerAuto();
    }

    /* ------------------------------------------- relief sous le doigt ----- */
    for (const panneau of panels) {
      panneau.addEventListener('pointerdown', () => panneau.classList.add('is-pressed'), { signal });
      for (const fin of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
        panneau.addEventListener(fin, () => panneau.classList.remove('is-pressed'), { signal });
      }
    }
  }

  document.addEventListener('astro:page-load', initConstat);
  document.addEventListener('astro:before-swap', teardownConstat);
</script>
