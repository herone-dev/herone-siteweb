---
// Section Méthode : 5 étapes présentées en liste numérotée.
//
// Animation = reveals d'entrée simples (fondu + léger translate) quand chaque
// étape entre dans l'écran. Conformément à la convention du projet, ces reveals
// sobres sont faits en CSS + IntersectionObserver — PAS en GSAP.
//
// Fallback complet : sans JS ou en prefers-reduced-motion, toutes les étapes
// sont visibles d'emblée (le mode animé est activé par la classe .reveals que
// le JS n'ajoute que lorsqu'il peut animer).
const steps = [
  { title: 'Audit du fonctionnement', text: "Nous venons chez vous, nous observons vos tâches répétitives sur le terrain et nous chiffrons ce qu'elles vous coûtent. Gratuit, sans engagement, 1 à 3 heures." },
  { title: 'Conception du système', text: 'Nous vous présentons ce que nous installons, ce que ça vous fait gagner et le prix. Vous validez avant que la moindre ligne soit écrite.' },
  { title: 'Développement et livraison', text: 'Nous construisons, nous testons sur vos vraies données, nous installons chez vous. Vos outils actuels restent en place.' },
  { title: 'Formation des équipes', text: "Nous formons les personnes qui vont s'en servir, jusqu'à ce que le système tourne sans nous. C'est là que se joue l'adoption." },
  { title: 'Accompagnement et maintenance', text: 'Nous corrigeons, nous améliorons, nous suivons les évolutions de vos logiciels. Vous nous avez au bout du fil quand il faut.' },
];
---

<section id="methode" class="hrn-method">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Méthode</div>
    <h2>Notre processus en 5 étapes</h2>
    <p class="hrn-method__sub">De la première visite au système en production, sans que vos équipes arrêtent de travailler.</p>

    <ol class="hrn-method__list" id="method-list">
      {steps.map((step, i) => (
        <li class="hrn-method__step" style={`--i:${i}`}>
          <span class="hrn-method__num">{String(i + 1).padStart(2, '0')}</span>
          <div class="hrn-method__step-body">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <p class="hrn-method__pivot">
      <a href="#reserver">Tout commence par l'audit, et il est gratuit.</a>
    </p>
  </div>
</section>

<style>
  .hrn-method {
    background: var(--slate-900);
    color: var(--ink-200);
    padding: clamp(48px, 7vw, 88px) 0;
  }

  .hrn-method :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-method h2 {
    color: var(--text-inverse);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 16ch;
    margin-top: 12px !important;
  }

  .hrn-method__sub {
    max-width: 46ch;
    margin: 16px 0 0;
    font-size: clamp(1.05rem, 1.4vw, 1.19rem);
    line-height: 1.6;
    color: var(--ink-300);
  }

  .hrn-method__list {
    list-style: none;
    margin: clamp(32px, 5vw, 48px) 0 0;
    padding: 0;
  }

  .hrn-method__step {
    display: flex;
    gap: clamp(16px, 3vw, 34px);
    padding: clamp(22px, 3vw, 30px) 0;
    border-top: 1px solid var(--border-inverse);
  }

  .hrn-method__step:last-child {
    border-bottom: 1px solid var(--border-inverse);
  }

  .hrn-method__num {
    flex: none;
    min-width: 2.5ch;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--amber-300);
    padding-top: 5px;
  }

  .hrn-method__step h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.5rem);
    letter-spacing: -0.01em;
    color: var(--text-inverse);
    margin: 0 0 6px !important;
  }

  .hrn-method__step p {
    margin: 0;
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-300);
  }

  .hrn-method__pivot {
    margin: 28px 0 0;
    font-size: 15px;
  }

  .hrn-method__pivot a {
    color: var(--amber-300);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-method__pivot a:hover {
    border-color: currentColor;
  }

  /* Reveals d'entrée : état initial masqué activé UNIQUEMENT par le JS (.reveals),
     pour que le contenu reste visible sans JS. */
  .hrn-method__list.reveals .hrn-method__step {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .hrn-method__list.reveals .hrn-method__step.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-method__list.reveals .hrn-method__step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardown() {
    io?.disconnect();
    io = undefined;
  }

  function initMethod() {
    teardown();

    const list = document.querySelector<HTMLElement>('#method-list');
    if (!list) return;
    const steps = [...list.children] as HTMLElement[];
    if (!steps.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    list.classList.add('reveals');

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io?.unobserve(entry.target); // reveal unique
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
    );

    steps.forEach((step) => io!.observe(step));
  }

  document.addEventListener('astro:page-load', initMethod);
  document.addEventListener('astro:before-swap', teardown);
</script>
