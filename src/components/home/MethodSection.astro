---
// Seule section du site utilisant GSAP + ScrollTrigger, conformément à la
// convention "GSAP réservé au spectaculaire".
//
// La section est un bloc foncé normal, dimensionné comme la section témoignage
// (pas de pin, donc pas de bandes autour ni de pleine page). Les 5 étapes se
// révèlent progressivement au scroll (scrub) au fur et à mesure que le bloc
// traverse l'écran. Hauteur du bloc CONSTANTE : on réserve la place d'une
// description longue pour qu'il ne « grossisse » pas d'une étape à l'autre.
//
// Fallback statique complet (toutes les étapes dépliées) si prefers-reduced-motion,
// mobile (<820px), ou JS absent.
const steps = [
  { title: 'Audit du fonctionnement', text: "Nous observons vos tâches répétitives, sur le terrain, avant d'écrire la moindre ligne." },
  { title: 'Conception du système', text: 'Un système sur mesure, qui mêle automatisation et validation humaine là où elle compte.' },
  { title: 'Développement et livraison', text: 'Nous développons, testons et installons le système directement chez vous.' },
  { title: 'Formation des équipes', text: 'Nous formons vos équipes à utiliser le système au quotidien, en toute autonomie.' },
  { title: 'Accompagnement et maintenance', text: "Améliorations, correctifs et présence rapide dès qu'un besoin surgit." },
];
---

<section id="methode" class="hrn-method">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Méthode</div>
    <h2>Notre processus en 5 étapes</h2>

    <div class="hrn-method__layout">
      <div class="hrn-method__box" id="method-box">
        <div class="hrn-method__fill" id="method-fill"></div>
        <span class="hrn-method__num" id="method-num">1</span>
      </div>

      <ol class="hrn-method__list" id="method-list">
        {steps.map((step, i) => (
          <li class="hrn-method__step" data-index={i}>
            <span class="hrn-method__dot"></span>
            <div class="hrn-method__step-body">
              <h3>{step.title}</h3>
              <div class="hrn-method__step-desc"><p>{step.text}</p></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .hrn-method {
    background: var(--slate-900);
    color: var(--ink-200);
    padding: clamp(48px, 7vw, 88px) 0;
  }

  .hrn-method :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-method h2 {
    color: var(--text-inverse);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 16ch;
    margin-top: 12px !important;
  }

  .hrn-method__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 32px;
  }

  @media (min-width: 820px) {
    .hrn-method__layout {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: clamp(32px, 5vw, 64px);
      margin-top: 36px;
    }
  }

  .hrn-method__box {
    display: none;
    position: relative;
    width: 200px;
    height: 200px;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    overflow: hidden;
    align-items: flex-end;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
  }

  .hrn-method__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20%;
    background: linear-gradient(180deg, color-mix(in srgb, var(--amber-500) 25%, transparent), color-mix(in srgb, var(--amber-500) 45%, transparent));
  }

  .hrn-method__num {
    position: relative;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5.4rem;
    line-height: 1;
    color: var(--text-inverse);
    padding-bottom: 14px;
  }

  .hrn-method__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hrn-method__step {
    display: flex;
    gap: 18px;
  }

  .hrn-method__dot {
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ink-500);
    box-shadow: none;
    transition: background var(--dur) var(--ease-standard), box-shadow var(--dur) var(--ease-standard);
  }

  .hrn-method__step h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    letter-spacing: -0.01em;
    color: var(--ink-400);
    transition: color var(--dur) var(--ease-standard);
  }

  .hrn-method__step-desc {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--dur-slow) var(--ease-standard);
  }

  .hrn-method__step-desc p {
    overflow: hidden;
    margin-top: 6px !important;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-400);
  }

  /* Mode scroll-driven (activé par JS sur desktop, sans prefers-reduced-motion) */
  .hrn-method__list.is-scroll-driven .hrn-method__step-desc {
    grid-template-rows: 0fr;
  }

  /* Hauteur de description RÉSERVÉE quand une étape est active : toutes les
     étapes réservent la même place (2 lignes) → le bloc foncé ne change pas
     de taille en défilant d'une étape à l'autre. */
  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active .hrn-method__step-desc {
    grid-template-rows: 1fr;
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active .hrn-method__step-desc p {
    min-height: calc(2 * 1.55 * 15px);
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active .hrn-method__dot {
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active h3 {
    color: var(--text-inverse);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: ReturnType<typeof gsap.context> | undefined;

  function teardown() {
    ctx?.revert();
    ctx = undefined;

    const box = document.querySelector<HTMLElement>('#method-box');
    const list = document.querySelector<HTMLElement>('#method-list');
    if (box) box.style.display = '';
    if (list) {
      list.style.height = '';
      list.classList.remove('is-scroll-driven');
      [...list.children].forEach((el) => el.classList.remove('is-active'));
    }
  }

  function init() {
    teardown();

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 820px)').matches;

    const section = document.querySelector<HTMLElement>('#methode');
    const box = document.querySelector<HTMLElement>('#method-box');
    const fill = document.querySelector<HTMLElement>('#method-fill');
    const num = document.querySelector<HTMLElement>('#method-num');
    const list = document.querySelector<HTMLElement>('#method-list');

    if (!section || !box || !fill || !num || !list) return;
    const steps = [...list.children] as HTMLElement[];
    if (!steps.length) return;

    // Sur mobile / reduced-motion : rendu statique (toutes les descriptions
    // dépliées, pavé numéroté masqué, pas d'animation).
    if (!isDesktop || reduce) return;

    ctx = gsap.context(() => {
      box.style.display = 'flex';
      list.classList.add('is-scroll-driven');

      let current = -1;
      const setActive = (i: number) => {
        if (i === current) return;
        current = i;
        steps.forEach((step, idx) => step.classList.toggle('is-active', idx === i));
        num.textContent = String(i + 1);
        gsap.fromTo(num, { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: 0.3, ease: 'power3.out' });
        gsap.to(fill, { height: `${(i + 1) * 20}%`, duration: 0.4, ease: 'power3.out' });
      };
      setActive(0);

      // Verrou de hauteur : la liste occupe en permanence sa hauteur stabilisée
      // (identique pour chaque étape) → l'accordéon s'anime à l'intérieur sans
      // jamais faire varier la taille du bloc foncé, même pendant la transition.
      // On neutralise les transitions le temps de lire la hauteur finale (sinon
      // on mesurerait un état intermédiaire, encore en cours d'animation).
      requestAnimationFrame(() => {
        const descs = [...list.querySelectorAll<HTMLElement>('.hrn-method__step-desc')];
        descs.forEach((d) => (d.style.transition = 'none'));
        void list.offsetHeight;
        list.style.height = `${list.scrollHeight}px`;
        void list.offsetHeight;
        descs.forEach((d) => (d.style.transition = ''));
      });

      // Pas de pin : l'avancement suit le passage du bloc dans l'écran.
      ScrollTrigger.create({
        trigger: section,
        start: 'top 72%',
        end: 'bottom 28%',
        scrub: true,
        onUpdate(self) {
          const idx = Math.min(steps.length - 1, Math.floor(self.progress * steps.length));
          setActive(idx);
        },
      });
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
