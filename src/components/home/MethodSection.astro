---
// Seule section du site utilisant GSAP + ScrollTrigger (scroll-driven), conformément
// à la convention "GSAP réservé au spectaculaire".
//
// Principe : le foncé est porté UNIQUEMENT par le bloc `.hrn-method__card`
// (dimensionné comme la section témoignage). La « piste » de scroll qui l'entoure
// est transparente → pendant le pin, le bloc figé garde la taille d'une section
// normale, avec le fond clair de la page autour (jamais une pleine page foncée).
//
// Fallback statique complet (toutes les étapes dépliées, pas de pin) si
// prefers-reduced-motion, mobile (<820px), ou JS absent.
const steps = [
  { title: 'Audit du fonctionnement', text: "Nous observons vos tâches répétitives, sur le terrain, avant d'écrire la moindre ligne." },
  { title: 'Conception du système', text: 'Un système sur mesure, qui mêle automatisation et validation humaine là où elle compte.' },
  { title: 'Développement et livraison', text: 'Nous développons, testons et installons le système directement chez vous.' },
  { title: 'Formation des équipes', text: 'Nous formons vos équipes à utiliser le système au quotidien, en toute autonomie.' },
  { title: 'Accompagnement et maintenance', text: "Améliorations, correctifs et présence rapide dès qu'un besoin surgit." },
];
---

<section id="methode" class="hrn-method">
  <div class="hrn-method__scroll" id="method-scroll">
    <div class="hrn-method__pin" id="method-pin">
      <div class="hrn-method__card">
        <div class="hrn-section-inner">
          <div class="hrn-eyebrow">Méthode</div>
          <h2>Notre processus en 5 étapes</h2>

          <div class="hrn-method__layout">
            <div class="hrn-method__box" id="method-box">
              <div class="hrn-method__fill" id="method-fill"></div>
              <span class="hrn-method__num" id="method-num">1</span>
            </div>

            <ol class="hrn-method__list" id="method-list">
              {steps.map((step, i) => (
                <li class="hrn-method__step" data-index={i}>
                  <span class="hrn-method__dot"></span>
                  <div class="hrn-method__step-body">
                    <h3>{step.title}</h3>
                    <div class="hrn-method__step-desc"><p>{step.text}</p></div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section = simple conteneur de la piste de scroll ; aucun fond ici. */
  .hrn-method {
    background: transparent;
  }

  /* Le bloc foncé : c'est lui qui est dimensionné comme la section témoignage. */
  .hrn-method__card {
    background: var(--slate-900);
    color: var(--ink-200);
    padding: clamp(48px, 7vw, 88px) 0;
  }

  .hrn-method :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-method__card h2 {
    color: var(--text-inverse);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 16ch;
    margin-top: 12px !important;
  }

  .hrn-method__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 32px;
  }

  @media (min-width: 820px) {
    /* Piste : hauteur posée par le JS (invisible, transparente). */
    .hrn-method__pin {
      min-height: 100vh;
      display: flex;
      align-items: center;
    }

    .hrn-method__pin > .hrn-method__card {
      width: 100%;
    }

    .hrn-method__layout {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: clamp(32px, 5vw, 64px);
      margin-top: 36px;
    }
  }

  .hrn-method__box {
    display: none;
    position: relative;
    width: 200px;
    height: 200px;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    overflow: hidden;
    align-items: flex-end;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
  }

  .hrn-method__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20%;
    background: linear-gradient(180deg, color-mix(in srgb, var(--amber-500) 25%, transparent), color-mix(in srgb, var(--amber-500) 45%, transparent));
  }

  .hrn-method__num {
    position: relative;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5.4rem;
    line-height: 1;
    color: var(--text-inverse);
    padding-bottom: 14px;
  }

  .hrn-method__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hrn-method__step {
    display: flex;
    gap: 18px;
  }

  .hrn-method__dot {
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--ink-500);
    box-shadow: none;
    transition: background var(--dur) var(--ease-standard), box-shadow var(--dur) var(--ease-standard);
  }

  .hrn-method__step h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.4rem);
    letter-spacing: -0.01em;
    color: var(--ink-400);
    transition: color var(--dur) var(--ease-standard);
  }

  .hrn-method__step-desc {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--dur-slow) var(--ease-standard);
  }

  .hrn-method__step-desc p {
    overflow: hidden;
    margin-top: 6px !important;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-400);
  }

  /* Mode scroll-driven (activé par JS sur desktop, sans prefers-reduced-motion) */
  .hrn-method__list.is-scroll-driven .hrn-method__step-desc {
    grid-template-rows: 0fr;
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active .hrn-method__dot {
    background: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active h3 {
    color: var(--text-inverse);
  }

  .hrn-method__list.is-scroll-driven .hrn-method__step.is-active .hrn-method__step-desc {
    grid-template-rows: 1fr;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: ReturnType<typeof gsap.context> | undefined;
  let ac: AbortController | undefined;

  function teardown() {
    ctx?.revert();
    ctx = undefined;

    const scrollWrap = document.querySelector<HTMLElement>('#method-scroll');
    const box = document.querySelector<HTMLElement>('#method-box');
    const list = document.querySelector<HTMLElement>('#method-list');

    if (scrollWrap) scrollWrap.style.height = '';
    if (box) box.style.display = '';
    if (list) {
      list.classList.remove('is-scroll-driven');
      [...list.children].forEach((el) => el.classList.remove('is-active'));
    }
  }

  function init() {
    teardown();
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 820px)').matches;

    const scrollWrap = document.querySelector<HTMLElement>('#method-scroll');
    const pin = document.querySelector<HTMLElement>('#method-pin');
    const box = document.querySelector<HTMLElement>('#method-box');
    const fill = document.querySelector<HTMLElement>('#method-fill');
    const num = document.querySelector<HTMLElement>('#method-num');
    const list = document.querySelector<HTMLElement>('#method-list');

    if (!scrollWrap || !pin || !box || !fill || !num || !list) return;
    const steps = [...list.children] as HTMLElement[];
    if (!steps.length) return;

    // Sur mobile / reduced-motion : rendu statique (CSS mobile-first, toutes
    // les descriptions dépliées, pavé numéroté masqué, pas de pin).
    if (!isDesktop || reduce) return;

    ctx = gsap.context(() => {
      // Piste de scroll : 100vh (couverture du pin) + une distance courte par
      // étape → l'animation défile sans imposer 5 pleines pages.
      const perStepVh = 42;
      scrollWrap.style.height = `${100 + steps.length * perStepVh}vh`;
      box.style.display = 'flex';
      list.classList.add('is-scroll-driven');

      let current = -1;
      const setActive = (i: number) => {
        if (i === current) return;
        current = i;
        steps.forEach((step, idx) => step.classList.toggle('is-active', idx === i));
        num.textContent = String(i + 1);
        gsap.fromTo(num, { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: 0.3, ease: 'power3.out' });
        gsap.to(fill, { height: `${(i + 1) * 20}%`, duration: 0.4, ease: 'power3.out' });
      };
      setActive(0);

      ScrollTrigger.create({
        trigger: scrollWrap,
        start: 'top top',
        end: 'bottom bottom',
        pin,
        pinSpacing: true,
        scrub: true,
        onUpdate(self) {
          const idx = Math.min(steps.length - 1, Math.floor(self.progress * steps.length));
          setActive(idx);
        },
      });
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener(
      'resize',
      () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(init, 200);
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
