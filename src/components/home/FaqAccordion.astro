---
const faqs = [
  {
    q: 'Mes données sont-elles en sécurité et confidentielles ?',
    a: "Oui. Nous privilégions un hébergement en Europe, et en France quand c'est possible. Vos données restent les vôtres : nous vous disons précisément où elles vont, qui y a accès, et rien n'est utilisé à d'autres fins.",
  },
  {
    q: 'Que couvre la maintenance ?',
    a: "La surveillance du système, les correctifs en cas de dysfonctionnement, les améliorations quand vos outils évoluent, et notre présence dans les meilleurs délais dès qu'un besoin surgit. Vos équipes gardent toujours la possibilité de reprendre la main.",
  },
  {
    q: 'Comment se déroule un projet ?',
    a: "Tout commence par trente minutes d'échange, gratuit et sans engagement, pour qualifier votre besoin. Selon ce qui ressort, nous enchaînons sur un atelier IA pour vos équipes, un diagnostic complet ou directement une automatisation. Nous concevons le système et le faisons valider par vous avant de le construire, puis nous l'installons chez vous et formons vos équipes. Un suivi mensuel prend le relais une fois le système en service.",
  },
  {
    q: 'Travaillez-vous avec des entreprises de ma taille ?',
    a: "Nous travaillons avec des structures de 5 à 30 personnes, dont le dirigeant décide seul et reste maître de ses logiciels. En dessous, il n'y a en général pas assez de tâches répétitives pour que ce soit rentable. Au-dessus, les circuits de décision sont différents et ce n'est pas notre métier.",
  },
  {
    q: 'Vous déplacez-vous chez nous ?',
    a: "Oui, systématiquement, et c'est même le principe. Nous intervenons dans un rayon de 45 minutes autour des Herbiers : Montaigu, Chantonnay, Pouzauges, Mortagne-sur-Sèvre, et jusqu'à La Roche-sur-Yon et Cholet.",
  },
  {
    q: 'Êtes-vous conformes au RGPD ?',
    a: "Oui. Chaque système est pensé pour respecter le RGPD : minimisation des données, hébergement maîtrisé, accès contrôlés. Nous documentons ce qui est collecté et pourquoi, avant de démarrer.",
  },
  {
    q: 'Est-ce que ça marche avec mes logiciels actuels ?',
    a: "C'est justement le point de départ. Nous construisons autour de vos logiciels existants : CRM, tableur, messagerie, métier. Le système les relie plutôt que de les remplacer.",
  },
  {
    q: 'Combien ça coûte ?',
    a: "Nos quatre offres vont de 300 à 2 500 €, prix affichés plus haut. Un atelier pour votre équipe coûte entre 300 et 600 €, un diagnostic complet entre 800 et 1 500 €, une automatisation entre 500 et 2 500 € avec un suivi mensuel de 100 à 150 €. Nous ne prenons aucune prestation au-dessus de 3 000 €.",
  },
];
---

<section id="objections" class="hrn-faq">
  <div class="hrn-faq__inner">
    <div class="hrn-eyebrow">Vos questions</div>
    <h2>Ce que les dirigeants nous demandent</h2>

    <div class="hrn-faq__list">
      {faqs.map((item) => (
        <details name="faq" class="hrn-faq__item">
          <summary>
            <span>{item.q}</span>
            <svg class="hrn-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
          </summary>
          <div class="hrn-faq__panel">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-faq {
    padding: var(--section-y) 0;
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  /* Colonne étroite et centrée (fidèle à la maquette Claude Design) */
  .hrn-faq__inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  /* Le titre suit la largeur de la colonne (casse après « nous ») */
  .hrn-faq__inner h2 {
    max-width: none;
  }

  .hrn-faq__list {
    margin-top: 32px;
    border-top: 1px solid var(--border);
  }

  .hrn-faq__item {
    border-bottom: 1px solid var(--border);
  }

  .hrn-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--text-strong);
    cursor: pointer;
  }

  .hrn-faq__chevron {
    flex: none;
    color: var(--text-muted);
    transition: transform var(--dur) var(--ease-standard);
  }

  /* Rotation du chevron : natif (sans JS) via [open], enrichi (JS) via .is-open */
  .hrn-faq:not(.is-enhanced) .hrn-faq__item[open] .hrn-faq__chevron,
  .hrn-faq.is-enhanced .hrn-faq__item.is-open .hrn-faq__chevron {
    transform: rotate(180deg);
  }

  /* Zone repliable : animée en hauteur + opacité par le JS (WAAP) */
  .hrn-faq__panel {
    overflow: hidden;
  }

  .hrn-faq__panel p {
    margin: 0;
    padding: 0 4px 22px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>

<script>
  function initFaq() {
    const root = document.querySelector<HTMLElement>('.hrn-faq');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('.hrn-faq__item'));
    if (!items.length) return;

    root.classList.add('is-enhanced');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 440;
    const EASING = 'cubic-bezier(0.65, 0, 0.35, 1)'; // même courbe, veloutée et symétrique (ouverture = fermeture)

    const expand = (item: HTMLDetailsElement, panel: HTMLElement) => {
      item.open = true;
      item.classList.add('is-open');
      if (reduce) return;
      item.classList.add('is-animating');
      panel.style.height = '0px'; // évite le flash à pleine hauteur avant l'anim
      const target = panel.scrollHeight;
      const anim = panel.animate(
        [{ height: '0px', opacity: 0 }, { height: `${target}px`, opacity: 1 }],
        { duration: DURATION, easing: EASING },
      );
      anim.onfinish = () => {
        panel.style.height = '';
        item.classList.remove('is-animating');
      };
    };

    const collapse = (item: HTMLDetailsElement, panel: HTMLElement) => {
      item.classList.remove('is-open');
      if (reduce) {
        item.open = false;
        return;
      }
      item.classList.add('is-animating');
      const start = panel.scrollHeight;
      const anim = panel.animate(
        [{ height: `${start}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: DURATION, easing: EASING },
      );
      anim.onfinish = () => {
        item.open = false;
        panel.style.height = '';
        item.classList.remove('is-animating');
      };
    };

    for (const item of items) {
      if (item.dataset.faqReady) continue;
      item.dataset.faqReady = '1';
      item.removeAttribute('name'); // l'exclusivité est désormais pilotée par le JS (anim simultanée)

      const summary = item.querySelector('summary');
      const panel = item.querySelector<HTMLElement>('.hrn-faq__panel');
      if (!summary || !panel) continue;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.classList.contains('is-animating')) return;

        if (item.open) {
          collapse(item, panel);
          return;
        }

        // Une seule question ouverte : on referme l'ouverte pendant que celle-ci s'ouvre.
        const current = items.find((other) => other !== item && other.open);
        if (current) {
          const currentPanel = current.querySelector<HTMLElement>('.hrn-faq__panel');
          if (currentPanel) collapse(current, currentPanel);
        }
        expand(item, panel);
      });
    }
  }

  document.addEventListener('astro:page-load', initFaq);
</script>
