---
// FAQ en accordéon : une seule question ouverte à la fois, ouverture et
// fermeture animées, repli natif <details> sans JavaScript.
//
// Posée sur l'accueil (valeurs par défaut ci-dessous) et, depuis le
// 23 septembre 2026, sur /formation et /automatisation avec leurs propres
// questions, à la place de l'ancienne FAQ dépliée des pages d'offre
// (OffreFaq), à la demande de l'utilisateur : même présentation partout.
//
// Le script cherche UNE section .hrn-faq par page : ne pas en poser deux.
const FAQ_ACCUEIL = [
  {
    q: 'Mes données sont-elles en sécurité et confidentielles ?',
    a: "Oui. Nous privilégions un hébergement en Europe, et en France quand c'est possible. Vos données restent les vôtres : nous vous disons précisément où elles vont, qui y a accès, et rien n'est utilisé à d'autres fins.",
  },
  {
    q: 'Que couvre la maintenance ?',
    a: "La surveillance du système, les correctifs en cas de dysfonctionnement, les améliorations quand vos outils évoluent, et notre présence dans les meilleurs délais dès qu'un besoin surgit. Vos équipes gardent toujours la possibilité de reprendre la main.",
  },
  {
    q: 'Comment se déroule un projet ?',
    a: "Tout commence par trente minutes d'échange, gratuit et sans engagement, pour qualifier votre besoin. Selon ce qui ressort, nous enchaînons sur une journée de formation IA pour vos équipes, ou directement sur une automatisation. Pour une formation, nous préparons la journée en amont sur vos dossiers, puis nous l'animons chez vous, à deux. Pour une automatisation, nous concevons le système et le faisons valider par vous avant de le construire, puis nous l'installons chez vous et formons vos équipes. Un suivi mensuel prend le relais une fois le système en service.",
  },
  {
    q: 'Que contient la journée de formation IA ?',
    a: "Une journée entière chez vous, animée à deux, sans prérequis technique. Chacun part de la tâche qu'il refait le plus souvent : il la fait d'abord à la main, chronomètre en marche, puis la refait avec l'IA en fin de journée, et compare. Entre les deux : les fondamentaux, la prise en main de l'outil, la méthode pour déléguer, décrire, discerner et rester diligent, puis le paramétrage, les connecteurs et les compétences réutilisables. Plus de la moitié du temps se passe en atelier. Six livrables repartent avec chaque participant, dont la charte d'usage de l'entreprise, décidée et signée dans la journée. Le détail complet est sur la page Formation IA.",
  },
  {
    q: 'Formation ou automatisation, par quoi commencer ?',
    a: "Par la formation, dans la plupart des cas. Une équipe qui sait ce que l'IA fait bien, et où elle casse, repère elle-même les tâches qui valent la peine d'être automatisées, et nous construisons ensuite sur du solide. L'automatisation seule reste le bon choix quand la tâche est déjà identifiée et qu'elle revient tous les jours, par exemple une ressaisie entre deux logiciels. Nous construisons ces automatisations sur n8n, Make ou Zapier, selon ce qui convient à vos outils.",
  },
  {
    q: 'Travaillez-vous avec des entreprises de ma taille ?',
    a: "Pour la formation, oui, dès une personne à former : elle vaut pour un dirigeant seul comme pour une équipe entière. Pour l'automatisation, nous travaillons avec des structures de 5 à 30 personnes, dont le dirigeant décide seul et reste maître de ses logiciels. En dessous, il n'y a en général pas assez de tâches répétitives pour que ce soit rentable. Au-dessus, les circuits de décision sont différents et ce n'est pas notre métier.",
  },
  {
    q: 'Vous déplacez-vous chez nous ?',
    a: "Oui, systématiquement, et c'est même le principe. Nous intervenons dans un rayon de 45 minutes autour des Herbiers : Montaigu, Chantonnay, Pouzauges, Mortagne-sur-Sèvre, et jusqu'à La Roche-sur-Yon et Cholet.",
  },
  {
    q: 'Êtes-vous conformes au RGPD ?',
    a: "Oui. Chaque système est pensé pour respecter le RGPD : minimisation des données, hébergement maîtrisé, accès contrôlés. Nous documentons ce qui est collecté et pourquoi, avant de démarrer.",
  },
  {
    q: 'Est-ce que ça marche avec mes logiciels actuels ?',
    a: "C'est justement le point de départ. Nous construisons autour de vos logiciels existants : CRM, tableur, messagerie, métier. Le système les relie plutôt que de les remplacer.",
  },
  {
    q: 'Combien ça coûte ?',
    a: "Tous nos prix sont affichés plus haut, et ils s'entendent hors taxes. La formation IA en entreprise démarre à 1 500 € HT la journée jusqu'à trois personnes, puis 500 € HT par personne au-delà : cinq personnes à former, c'est 2 500 € HT. L'automatisation démarre à 2 000 € HT, et le suivi mensuel qui prend ensuite le relais se chiffre avec vous au rendez-vous. En fonction de la complexité, de l'ambition de l'entreprise et de sa taille, un projet peut monter à plusieurs milliers d'euros. Des tarifs volontairement accessibles : nous voulons nous faire connaître vite dans la région.",
  },
];

interface Props {
  faqs?: { q: string; a: string }[];
  eyebrow?: string;
  titre?: string;
  /** Ancre de la section. `objections` sur l'accueil, visée par aucun lien externe. */
  id?: string;
}

const {
  faqs = FAQ_ACCUEIL,
  eyebrow = 'Vos questions',
  titre = 'Ce que les dirigeants nous demandent',
  id = 'objections',
} = Astro.props;
---

<section id={id} class="hrn-faq">
  <div class="hrn-faq__inner">
    <div class="hrn-eyebrow">{eyebrow}</div>
    <h2>{titre}</h2>

    <div class="hrn-faq__list">
      {faqs.map((item) => (
        <details name="faq" class="hrn-faq__item">
          <summary>
            <span>{item.q}</span>
            <svg class="hrn-faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
          </summary>
          <div class="hrn-faq__panel">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .hrn-faq {
    padding: var(--section-y) 0;
    background: var(--surface);
    /* Fond inverse le 22 septembre 2026 : la section « Logiciels » est
       partie sur /automatisation, et son retrait decalait l'alternance
       de toutes les sections suivantes. */
    scroll-margin-top: 68px;
  }

  /* Colonne étroite et centrée (fidèle à la maquette Claude Design) */
  .hrn-faq__inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  /* Le titre suit la largeur de la colonne (casse après « nous ») */
  .hrn-faq__inner h2 {
    max-width: none;
  }

  .hrn-faq__list {
    margin-top: 32px;
    border-top: 1px solid var(--border);
  }

  .hrn-faq__item {
    border-bottom: 1px solid var(--border);
  }

  .hrn-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: var(--text-lg);
    color: var(--text-strong);
    cursor: pointer;
    letter-spacing: var(--tracking-titre);
  }

  .hrn-faq__chevron {
    flex: none;
    color: var(--text-muted);
    transition: transform var(--dur) var(--ease-standard);
  }

  /* Rotation du chevron : natif (sans JS) via [open], enrichi (JS) via .is-open */
  .hrn-faq:not(.is-enhanced) .hrn-faq__item[open] .hrn-faq__chevron,
  .hrn-faq.is-enhanced .hrn-faq__item.is-open .hrn-faq__chevron {
    transform: rotate(180deg);
  }

  /* Zone repliable : animée en hauteur + opacité par le JS (WAAP) */
  .hrn-faq__panel {
    overflow: hidden;
  }

  .hrn-faq__panel p {
    margin: 0;
    padding: 0 4px 22px;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>

<script>
  function initFaq() {
    const root = document.querySelector<HTMLElement>('.hrn-faq');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('.hrn-faq__item'));
    if (!items.length) return;

    root.classList.add('is-enhanced');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 440;
    const EASING = 'cubic-bezier(0.65, 0, 0.35, 1)'; // même courbe, veloutée et symétrique (ouverture = fermeture)

    const expand = (item: HTMLDetailsElement, panel: HTMLElement) => {
      item.open = true;
      item.classList.add('is-open');
      if (reduce) return;
      item.classList.add('is-animating');
      panel.style.height = '0px'; // évite le flash à pleine hauteur avant l'anim
      const target = panel.scrollHeight;
      const anim = panel.animate(
        [{ height: '0px', opacity: 0 }, { height: `${target}px`, opacity: 1 }],
        { duration: DURATION, easing: EASING },
      );
      anim.onfinish = () => {
        panel.style.height = '';
        item.classList.remove('is-animating');
      };
    };

    const collapse = (item: HTMLDetailsElement, panel: HTMLElement) => {
      item.classList.remove('is-open');
      if (reduce) {
        item.open = false;
        return;
      }
      item.classList.add('is-animating');
      const start = panel.scrollHeight;
      const anim = panel.animate(
        [{ height: `${start}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: DURATION, easing: EASING },
      );
      anim.onfinish = () => {
        item.open = false;
        panel.style.height = '';
        item.classList.remove('is-animating');
      };
    };

    for (const item of items) {
      if (item.dataset.faqReady) continue;
      item.dataset.faqReady = '1';
      item.removeAttribute('name'); // l'exclusivité est désormais pilotée par le JS (anim simultanée)

      const summary = item.querySelector('summary');
      const panel = item.querySelector<HTMLElement>('.hrn-faq__panel');
      if (!summary || !panel) continue;

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (item.classList.contains('is-animating')) return;

        if (item.open) {
          collapse(item, panel);
          return;
        }

        // Une seule question ouverte : on referme l'ouverte pendant que celle-ci s'ouvre.
        const current = items.find((other) => other !== item && other.open);
        if (current) {
          const currentPanel = current.querySelector<HTMLElement>('.hrn-faq__panel');
          if (currentPanel) collapse(current, currentPanel);
        }
        expand(item, panel);
      });
    }
  }

  document.addEventListener('astro:page-load', initFaq);
</script>
