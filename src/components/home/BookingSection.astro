---
// Section « Appel final » : le vrai planificateur Calendly remplace l'ancien
// calendrier fictif. L'embed est chargé en lazy (le script Calendly n'est
// injecté que lorsque la section approche de l'écran) pour préserver la vitesse
// et ne solliciter le tiers qu'au moment utile. Fallback <noscript> : lien direct.
const CALENDLY_URL = 'https://calendly.com/herone/echange-decouverte-de-30-minutes';
// Paramètres de thème pour fondre le widget dans la section sombre.
const CALENDLY_EMBED_URL = `${CALENDLY_URL}?hide_gdpr_banner=1&background_color=132a24&text_color=f1eee1&primary_color=ec3a08`;
---

<section id="reserver" class="hrn-booking">
  <div class="hrn-section-inner">
    <div class="hrn-booking__header">
      <div class="hrn-booking__eyebrow">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
          <path d="m9 16 2 2 4-4"></path>
        </svg>
        <span>RÉSERVEZ VOTRE RENDEZ-VOUS</span>
      </div>

      <div class="hrn-booking__header-main">
        <h2>30 minutes pour voir ce qu'on peut vous retirer des mains.</h2>
        <p class="hrn-booking__lede">
          Vous décrivez votre quotidien, nous repérons les tâches à supprimer. Trente minutes d'échange, gratuit et sans engagement.
        </p>
      </div>
    </div>

    <div class="hrn-booking__calendar">
      <div id="calendly-embed" class="hrn-booking__calendly" data-url={CALENDLY_EMBED_URL}></div>

      <noscript>
        <p class="hrn-booking__note">
          <a href={CALENDLY_URL} target="_blank" rel="noopener">Réserver un créneau sur Calendly ↗</a>
        </p>
      </noscript>
    </div>
  </div>
</section>

<style>
  .hrn-booking {
    padding: clamp(32px, 4vh, 52px) 0;
    background: var(--slate-900);
    color: var(--ink-200);
    scroll-margin-top: 68px;
  }

  .hrn-booking__header {
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }

  .hrn-booking__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-300);
    margin-bottom: 12px;
  }

  .hrn-booking__eyebrow svg {
    color: var(--amber-300);
    flex-shrink: 0;
  }

  .hrn-booking__header-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .hrn-booking__header-main {
      grid-template-columns: 1.4fr 1fr;
      gap: 36px;
      align-items: center;
    }
  }

  .hrn-booking h2 {
    color: var(--text-inverse);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  .hrn-booking__lede {
    margin: 0;
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    line-height: 1.5;
    color: var(--ink-200);
    text-wrap: pretty;
  }

  /* Calendrier pleine largeur sans fond ni bordure */
  .hrn-booking__calendar {
    background: transparent;
    border: none;
    padding: 0;
    overflow: hidden;
  }

  .hrn-booking__calendly {
    width: 100%;
    min-height: 450px;
    height: 760px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 768px) {
    .hrn-booking__calendly {
      height: 700px;
      min-height: 420px;
    }
  }

  .hrn-booking__calendly :global(iframe) {
    width: 100% !important;
    height: 100% !important;
    border: 0 !important;
    overflow: hidden !important;
  }

  .hrn-booking__note {
    margin: 12px 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-300);
  }

  .hrn-booking__note a {
    color: var(--amber-300);
  }
</style>

<script>
  function loadCalendlyScript(): Promise<void> {
    const w = window as any;
    if (w.Calendly) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>('script[data-calendly]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('calendly')), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.dataset.calendly = '';
      script.addEventListener('load', () => resolve(), { once: true });
      script.addEventListener('error', () => reject(new Error('calendly')), { once: true });
      document.head.appendChild(script);
    });
  }

  function showFallback(el: HTMLElement) {
    if (el.dataset.inited) return;
    el.dataset.inited = '1';
    el.innerHTML =
      '<p class="hrn-booking__note"><a href="https://calendly.com/herone/echange-decouverte-de-30-minutes" target="_blank" rel="noopener">Ouvrir le calendrier de réservation ↗</a></p>';
  }

  function setupHeightListener() {
    const w = window as any;
    if (w.__calendlyHeightListenerAttached) return;
    w.__calendlyHeightListenerAttached = true;

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.data && e.data.event === 'calendly.page_height_changed') {
        const el = document.querySelector<HTMLElement>('#calendly-embed');
        if (el && e.data.payload && e.data.payload.height) {
          const rawHeight = e.data.payload.height;
          const heightNum = typeof rawHeight === 'number' ? rawHeight : parseInt(rawHeight, 10);
          if (!isNaN(heightNum)) {
            // Hauteur minimale pour éviter le décalage sur mobile tout en conservant le bureau net
            const minH = isMobile ? 420 : 760;
            const targetH = Math.max(heightNum, minH);
            el.style.height = `${targetH}px`;
          }
        }
      }
    });
  }

  function initCalendly() {
    setupHeightListener();

    const el = document.querySelector<HTMLElement>('#calendly-embed');
    if (!el || el.dataset.inited) return;

    const fallbackTimer = setTimeout(() => showFallback(el), 8000);
    loadCalendlyScript()
      .then(() => {
        const w = window as any;
        if (!w.Calendly || el.dataset.inited) return;
        clearTimeout(fallbackTimer);
        el.dataset.inited = '1';
        w.Calendly.initInlineWidget({ url: el.dataset.url, parentElement: el });
        
        // Empêcher les barres de défilement de l'iframe
        const disableIframeScroll = () => {
          const iframe = el.querySelector('iframe');
          if (iframe) {
            iframe.setAttribute('scrolling', 'no');
            iframe.style.overflow = 'hidden';
          }
        };
        disableIframeScroll();
        setTimeout(disableIframeScroll, 300);
        setTimeout(disableIframeScroll, 1000);
      })
      .catch(() => {
        clearTimeout(fallbackTimer);
        showFallback(el);
      });
  }

  document.addEventListener('astro:page-load', initCalendly);
</script>
