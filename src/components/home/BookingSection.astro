---
// Section « Appel final » : le vrai planificateur Calendly remplace l'ancien
// calendrier fictif. L'embed est chargé en lazy (le script Calendly n'est
// injecté que lorsque la section approche de l'écran) pour préserver la vitesse
// et ne solliciter le tiers qu'au moment utile. Fallback <noscript> : lien direct.
const CALENDLY_URL = 'https://calendly.com/herone/echange-decouverte-de-30-minutes';
// Paramètres de thème pour fondre le widget dans la section sombre.
const CALENDLY_EMBED_URL = `${CALENDLY_URL}?hide_gdpr_banner=1&background_color=132a24&text_color=f1eee1&primary_color=ec3a08`;
---

<section id="reserver" class="hrn-booking">
  <div class="hrn-section-inner hrn-booking__grid">
    <div class="hrn-booking__text">
      <div class="hrn-eyebrow">Appel final</div>
      <h2>Trente minutes pour voir ce qu'on peut vous retirer des mains.</h2>
      <p class="hrn-booking__lede">Vous décrivez votre quotidien, nous repérons les tâches à supprimer.</p>

      <span class="hrn-booking__free"><i></i>Audit gratuit, sans engagement</span>

      <div class="hrn-booking__contacts">
        <a href="tel:+33663710598"><small>Ou par téléphone</small><strong>06 63 71 05 98</strong></a>
        <a href="mailto:contact@herone.fr"><small>Par e-mail</small><strong>contact@herone.fr</strong></a>
      </div>
    </div>

    <div class="hrn-booking__calendar">
      <div class="hrn-booking__calendar-head">
        <strong>Choisissez un créneau</strong>
        <span class="hrn-booking__badge">30 min</span>
      </div>

      <div id="calendly-embed" class="hrn-booking__calendly" data-url={CALENDLY_EMBED_URL}></div>

      <noscript>
        <p class="hrn-booking__note">
          <a href={CALENDLY_URL} target="_blank" rel="noopener">Réserver un créneau sur Calendly</a>
        </p>
      </noscript>
    </div>
  </div>
</section>

<style>
  .hrn-booking {
    padding: clamp(56px, 8vw, 104px) 0;
    background: var(--slate-900);
    color: var(--ink-200);
  }

  .hrn-booking :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-booking__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .hrn-booking__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hrn-booking h2 {
    color: var(--text-inverse);
    max-width: 18ch;
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin-top: 0;
  }

  .hrn-booking__lede {
    margin: 18px 0 0;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-200);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .hrn-booking__free {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-inverse);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-full);
    padding: 7px 14px;
  }

  .hrn-booking__free i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber-400);
  }

  .hrn-booking__contacts {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }

  .hrn-booking__contacts a {
    display: flex;
    flex-direction: column;
    color: var(--text-inverse);
  }

  .hrn-booking__contacts small {
    font-size: 13px;
    color: var(--ink-300);
  }

  .hrn-booking__contacts strong {
    font-family: var(--font-mono);
    font-weight: 600 !important;
    color: var(--text-inverse);
  }

  .hrn-booking__calendar {
    background: color-mix(in srgb, #fff 5%, transparent);
    color: var(--text-inverse);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    padding: clamp(20px, 3vw, 28px);
  }

  .hrn-booking__calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hrn-booking__calendar-head strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--text-inverse);
  }

  .hrn-booking__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-300);
  }

  /* Conteneur de l'embed Calendly. Hauteur EXPLICITE (pas seulement min-height) :
     l'iframe Calendly est en height:100% et a besoin d'une hauteur ferme sur son
     parent, sinon elle retombe sur une bande étroite avec scroll interne.
     Mobile : Calendly empile le calendrier puis les créneaux → plus haut. */
  .hrn-booking__calendly {
    margin-top: 16px;
    height: 1040px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .hrn-booking__calendly {
      height: 720px;
    }
  }

  .hrn-booking__calendly :global(iframe) {
    width: 100% !important;
    height: 100% !important;
    border: 0;
  }

  .hrn-booking__note {
    margin: 12px 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink-300);
  }

  .hrn-booking__note a {
    color: var(--amber-300);
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function loadCalendlyScript(): Promise<void> {
    const w = window as any;
    if (w.Calendly) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>('script[data-calendly]');
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('calendly')), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.dataset.calendly = '';
      script.addEventListener('load', () => resolve(), { once: true });
      script.addEventListener('error', () => reject(new Error('calendly')), { once: true });
      document.head.appendChild(script);
    });
  }

  function showFallback(el: HTMLElement) {
    if (el.dataset.inited) return;
    el.dataset.inited = '1';
    el.innerHTML =
      '<p class="hrn-booking__note"><a href="https://calendly.com/herone/echange-decouverte-de-30-minutes" target="_blank" rel="noopener">Ouvrir le calendrier de réservation ↗</a></p>';
  }

  function initCalendly() {
    io?.disconnect();

    const el = document.querySelector<HTMLElement>('#calendly-embed');
    if (!el || el.dataset.inited) return;

    const mount = () => {
      // Filet de sécurité : si Calendly ne se charge pas (réseau, bloqueur),
      // on affiche un lien direct plutôt qu'un cadre vide.
      const fallbackTimer = setTimeout(() => showFallback(el), 8000);
      loadCalendlyScript()
        .then(() => {
          const w = window as any;
          if (!w.Calendly || el.dataset.inited) return;
          clearTimeout(fallbackTimer);
          el.dataset.inited = '1';
          w.Calendly.initInlineWidget({ url: el.dataset.url, parentElement: el });
        })
        .catch(() => {
          clearTimeout(fallbackTimer);
          showFallback(el);
        });
    };

    // Lazy : on ne charge Calendly que lorsque la section approche de l'écran.
    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io?.disconnect();
          mount();
        }
      },
      { rootMargin: '400px' }
    );
    io.observe(el);
  }

  document.addEventListener('astro:page-load', initCalendly);
  document.addEventListener('astro:before-swap', () => io?.disconnect());
</script>
