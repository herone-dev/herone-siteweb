---
import Button from '../Button.astro';

// Mock visuel statique en attendant l'intégration Cal.com (l'utilisateur fournira
// son lien une fois son compte créé). Remplacer ce bloc `.hrn-booking__calendar`
// par l'embed Cal.com le moment venu — le CTA principal reste tel/mailto pour l'instant.
const days = [
  { label: 'Lun', slots: [{ time: '09:00' }, { time: '14:00' }] },
  { label: 'Mar', slots: [{ time: '10:30' }, { time: '15:00', disabled: true }] },
  { label: 'Mer', slots: [{ time: '09:30', selected: true }, { time: '16:00' }] },
  { label: 'Jeu', slots: [{ time: '11:00' }, { time: '17:00' }] },
  { label: 'Ven', slots: [{ time: '09:00' }, { time: '13:30' }] },
];
---

<section id="reserver" class="hrn-booking">
  <div class="hrn-section-inner hrn-booking__grid">
    <div class="hrn-booking__text">
      <div class="hrn-eyebrow">Appel final</div>
      <h2>Trente minutes pour voir ce qu'on peut vous retirer des mains.</h2>
      <p class="hrn-booking__lede">Vous décrivez votre quotidien, nous repérons les tâches à supprimer.</p>

      <span class="hrn-booking__free"><i></i>Audit gratuit, sans engagement</span>

      <div class="hrn-booking__contacts">
        <a href="tel:+33663710598"><small>Ou par téléphone</small><strong>06 63 71 05 98</strong></a>
        <a href="mailto:contact@herone.fr"><small>Par e-mail</small><strong>contact@herone.fr</strong></a>
      </div>
    </div>

    <div class="hrn-booking__calendar">
      <div class="hrn-booking__calendar-head">
        <strong>Choisissez un créneau</strong>
        <span class="hrn-booking__badge">30 min</span>
      </div>

      <div class="hrn-booking__week">
        <span>Semaine du 20 juillet</span>
        <span class="hrn-booking__week-nav">
          <button type="button" aria-label="Semaine précédente">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" aria-label="Semaine suivante" class="is-active">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </span>
      </div>

      <div class="hrn-booking__days">
        {days.map((day) => (
          <div class="hrn-booking__day">
            <span class="hrn-booking__day-label">{day.label}</span>
            {day.slots.map((slot) => (
              <span class:list={['hrn-booking__slot', { 'is-disabled': slot.disabled, 'is-selected': slot.selected }]}>
                {slot.time}
              </span>
            ))}
          </div>
        ))}
      </div>

      <Button variant="accent" size="lg" block href="tel:+33663710598">Confirmer le créneau · Mer 09:30</Button>
      <p class="hrn-booking__note">Agenda de démonstration · connexion à venir</p>
    </div>
  </div>
</section>

<style>
  .hrn-booking {
    padding: clamp(56px, 8vw, 104px) 0;
    background: var(--slate-900);
    color: var(--ink-200);
  }

  .hrn-booking :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-booking__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .hrn-booking__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hrn-booking h2 {
    color: var(--text-inverse);
    max-width: 18ch;
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin-top: 0;
  }

  .hrn-booking__lede {
    margin: 18px 0 0;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-200);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .hrn-booking__free {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-inverse);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-full);
    padding: 7px 14px;
  }

  .hrn-booking__free i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber-400);
  }

  .hrn-booking__contacts {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 32px;
  }

  .hrn-booking__contacts a {
    display: flex;
    flex-direction: column;
    color: var(--text-inverse);
  }

  .hrn-booking__contacts small {
    font-size: 13px;
    color: var(--ink-300);
  }

  .hrn-booking__contacts strong {
    font-family: var(--font-mono);
    font-weight: 600 !important;
    color: var(--text-inverse);
  }

  .hrn-booking__calendar {
    background: color-mix(in srgb, #fff 5%, transparent);
    color: var(--text-inverse);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    padding: clamp(20px, 3vw, 28px);
  }

  .hrn-booking__calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hrn-booking__calendar-head strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--text-inverse);
  }

  .hrn-booking__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-300);
  }

  .hrn-booking__note {
    margin: 12px 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .hrn-booking__week {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--text-inverse);
  }

  .hrn-booking__week-nav {
    display: flex;
    gap: 6px;
  }

  .hrn-booking__week-nav button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-inverse);
    background: transparent;
    color: var(--ink-300);
  }

  .hrn-booking__week-nav button.is-active {
    color: var(--text-inverse);
  }

  .hrn-booking__days {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }

  .hrn-booking__day {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
  }

  .hrn-booking__day-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-300);
    margin-bottom: 2px;
  }

  .hrn-booking__slot {
    display: block;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 0;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-inverse);
    color: var(--text-inverse);
    cursor: pointer;
  }

  .hrn-booking__slot.is-disabled {
    color: var(--ink-400);
    text-decoration: line-through;
    cursor: default;
  }

  .hrn-booking__slot.is-selected {
    background: var(--amber-500);
    border-color: var(--amber-500);
    color: #fff;
  }

  .hrn-booking__calendar :global(.hrn-btn) {
    margin-top: 20px;
  }
</style>
