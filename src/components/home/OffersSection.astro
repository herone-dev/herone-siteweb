---
// Section « Nos offres » : 4 formats, 4 prix affichés en clair.
//
// Règle produit : les quatre prix restent visibles sans aucune interaction
// (aucun bloc repliable, aucun accordeon, aucune troncature). Les données sont
// centralisées dans le tableau `offers` puis bouclées dans le markup, comme
// dans MethodSection.astro et ConvictionSection.astro.
//
// Typographie des prix : espaces insécables (U+00A0) avant le symbole euro et
// comme séparateur de milliers. Le prix est en `white-space: nowrap` pour ne
// jamais casser au milieu ; l'offre 3 est découpée en deux segments
// insécables (montant d'installation / mensualité) afin de rester lisibles sur
// mobile. La liaison entre les deux segments n'est jamais mise dans la donnée :
// une virgule finale resterait orpheline en gros corps quand le segment mensuel
// passe à la ligne.
//
// Animation = reveal d'entrée sobre (fondu + léger translate) en CSS +
// IntersectionObserver, conformément aux conventions du projet (pas de GSAP,
// uniquement transform et opacity). Le reveal porte sur le <li> conteneur et
// non sur la carte, pour ne pas entrer en conflit avec le translate de survol.
// Sans JS ou en prefers-reduced-motion, tout est visible d'emblée.
const offers = [
  {
    num: '01',
    title: 'Atelier IA en entreprise',
    price: '300 à 600 €',
    priceExtra: null,
    intro: null,
    rows: [
      {
        label: 'Format',
        text: '2 à 3 heures dans vos locaux, dirigeant et équipe réunis, 5 à 15 personnes, chacun sur son poste.',
      },
      {
        label: 'Déroulé',
        text: '30 minutes de démonstration sur vos cas réels, 60 à 90 minutes de pratique guidée, 20 minutes pour arrêter les cinq usages à installer dès la semaine suivante.',
      },
      {
        label: 'Vous repartez avec',
        text: 'un support PDF, 20 formulations adaptées à votre métier, une fiche qui relie vos besoins aux outils.',
      },
    ],
    note: "Le coût d'un déjeuner d'équipe, pour une demi-journée dont chacun ressort avec des usages installés.",
  },
  {
    num: '02',
    title: 'Diagnostic IA et automatisation',
    price: '800 à 1 500 €',
    priceExtra: null,
    intro: null,
    rows: [
      {
        label: 'Format',
        text: 'un entretien avec le dirigeant, deux à trois avec les postes clés, une analyse hors site, une restitution.',
      },
      {
        label: 'Vous repartez avec',
        text: "un rapport de 10 à 15 pages : vos processus cartographiés, 3 à 10 pistes d'automatisation chiffrées en heures gagnées par mois, classées par impact et par effort.",
      },
    ],
    note: "Les recommandations sont applicables sans nous. Un diagnostic qui ne serait qu'un devis déguisé n'a aucune valeur.",
  },
  {
    num: '03',
    title: 'Automatisation à prix fixe',
    price: '500 à 2 500 €',
    priceExtra: 'puis 100 à 150 € par mois',
    intro: null,
    rows: [
      {
        label: 'Format',
        text: 'connexion de deux logiciels ou plus. Périmètre écrit avant de démarrer, prix ferme, aucune surprise.',
      },
      {
        label: 'Suivi',
        text: 'inclus chaque mois : surveillance du système, correctifs, adaptation quand vos logiciels évoluent.',
      },
    ],
    note: 'Nous ne laissons jamais un système tourner sans surveillance.',
  },
  {
    num: '04',
    title: 'Du rendez-vous au compte rendu envoyé',
    price: '1 500 à 2 500 €',
    priceExtra: null,
    intro: 'Le système déjà installé chez Allianz des Herbiers, déclinable à tout métier qui fait des rendez-vous.',
    rows: [
      {
        label: 'Format',
        text: "le rendez-vous est enregistré, l'audio traité, une fiche structurée part au bon interlocuteur. Zéro ressaisie.",
      },
      {
        label: 'Pour qui',
        text: 'agences immobilières, artisans en rendez-vous de chantier, équipes commerciales, cabinets.',
      },
    ],
    note: "La source d'entrée reste à votre choix : une application d'enregistrement ou un service de transcription.",
  },
];
---

<section id="offres" class="hrn-offers">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Offres</div>
    <h2>Nos offres</h2>
    <p class="hrn-lede">Quatre formats, quatre prix affichés. Vous savez avant d'appeler ce que ça coûte et ce que vous recevez.</p>

    <ul class="hrn-offers__grid" id="offers-grid" role="list">
      {offers.map((offer, i) => (
        <li class="hrn-offers__item" style={`--i:${i}`}>
          <article class="hrn-offers__card">
            <div class="hrn-offers__num">{offer.num}</div>
            <h3 class="hrn-offers__title">{offer.title}</h3>

            <p class="hrn-offers__price">
              <span class="hrn-offers__price-main">{offer.price}</span>
              {offer.priceExtra && <span class="hrn-offers__price-rec">{offer.priceExtra}</span>}
            </p>

            {offer.intro && <p class="hrn-offers__intro">{offer.intro}</p>}

            <dl class="hrn-offers__rows">
              {offer.rows.map((row) => (
                <div class="hrn-offers__row">
                  <dt>{row.label}</dt>
                  <dd>{row.text}</dd>
                </div>
              ))}
            </dl>

            <p class="hrn-offers__note">{offer.note}</p>
          </article>
        </li>
      ))}
    </ul>

    <p class="hrn-offers__guard">Aucune prestation au-dessus de 3 000 €. Si votre besoin dépasse ce cadre, nous vous le disons et nous vous orientons.</p>

    <p class="hrn-offers__pivot">
      <a href="#reserver">Vous ne savez pas quelle offre vous correspond ? Trente minutes d'échange, gratuit et sans engagement.</a>
    </p>
  </div>
</section>

<style>
  .hrn-offers {
    padding: clamp(56px, 8vw, 96px) 0;
    /* Le carrousel « Le constat », juste au-dessus, est en --surface depuis le
       retrait de la section Systèmes : on inverse fond de section et fond de
       carte pour ne pas coller deux bandes identiques. */
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  .hrn-offers .hrn-lede {
    margin-top: 16px;
  }

  /* ---------- Grille : 2 colonnes en desktop, 1 colonne en mobile ---------- */
  .hrn-offers__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: clamp(32px, 5vw, 44px) 0 0;
    padding: 0;
  }

  .hrn-offers__item {
    display: flex;
  }

  .hrn-offers__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 2.6vw, 30px);
    transition:
      box-shadow var(--dur) var(--ease-standard),
      transform var(--dur) var(--ease-standard),
      border-color var(--dur);
  }

  .hrn-offers__card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  /* ---------- Tête de carte ---------- */
  .hrn-offers__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--slate-600);
  }

  .hrn-offers__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 10px 0 0;
    text-wrap: balance;
  }

  /* Le prix reste lisible et ne casse jamais au milieu : chaque segment est
     insécable, le retour à la ligne ne peut se faire qu'entre les segments. */
  .hrn-offers__price {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
  }

  .hrn-offers__price-main {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--amber-600);
    white-space: nowrap;
  }

  .hrn-offers__price-rec {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.3;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .hrn-offers__intro {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-primary);
  }

  /* ---------- Contenu détaillé ---------- */
  .hrn-offers__rows {
    margin: 0;
    padding: 0;
  }

  .hrn-offers__row {
    margin-top: 18px;
  }

  .hrn-offers__row dt {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--slate-600);
  }

  .hrn-offers__row dd {
    margin: 5px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* `margin-top: auto` place la ligne d'engagement en bas de carte pour que les
     cartes d'une même rangée s'alignent visuellement. */
  .hrn-offers__note {
    margin: auto 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-primary);
  }

  /* ---------- Réassurance (encart discret, pas une carte) ---------- */
  .hrn-offers__guard {
    margin: 28px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--amber-300);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: color-mix(in srgb, var(--amber-50) 55%, transparent);
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    line-height: 1.55;
    color: var(--text-strong);
    max-width: 70ch;
    text-wrap: pretty;
  }

  .hrn-offers__pivot {
    margin: 20px 0 0;
    font-size: 15px;
  }

  .hrn-offers__pivot a {
    color: var(--amber-600);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-offers__pivot a:hover {
    border-color: currentColor;
  }

  @media (max-width: 820px) {
    .hrn-offers__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Reveals d'entrée ----------
     État initial masqué activé UNIQUEMENT par le JS (classe .reveals), pour que
     le contenu reste visible sans JS. */
  .hrn-offers__grid.reveals .hrn-offers__item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .hrn-offers__grid.reveals .hrn-offers__item.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offers__grid.reveals .hrn-offers__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardownOffers() {
    io?.disconnect();
    io = undefined;
  }

  function initOffers() {
    teardownOffers();

    const grid = document.querySelector<HTMLElement>('#offers-grid');
    if (!grid) return;
    const items = [...grid.children] as HTMLElement[];
    if (!items.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.classList.add('reveals');

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io?.unobserve(entry.target); // reveal unique
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    items.forEach((item) => io!.observe(item));
  }

  document.addEventListener('astro:page-load', initOffers);
  document.addEventListener('astro:before-swap', teardownOffers);
</script>
