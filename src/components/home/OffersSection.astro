---
// Section « Nos offres » : 4 formats, 4 prix affichés en clair.
//
// Mise en page issue d'un handoff Claude Design (« Section offres - cartes »).
// Le design y était écrit pour le moteur de Claude Design (DCLogic, sc-for,
// interpolation {{ }}) : il est ici porté en Astro + JavaScript natif, sans
// dépendance. Les tokens du design system sont les mêmes que ceux du repo,
// aucune valeur n'est donc écrite en dur.
//
// Les cartes sont empilées en éventail : celle du milieu est nette et lisible,
// les autres sont décalées, réduites, inclinées et floutées. On navigue avec
// les deux boutons, en cliquant une carte latérale, ou aux flèches du clavier.
//
// Écarts assumés par rapport au fichier de design, et pourquoi :
//
//  1. Le design fixe la carte à 420px de large. En dessous de 460px de
//     viewport elle dépassait de l'écran et son contenu se retrouvait rogné.
//     La largeur est donc plafonnée à la place disponible, et toute la
//     géométrie de l'éventail se recalcule à partir d'elle.
//  2. Le design fixe la scène à 672px et la carte à 630px de haut. Le texte se
//     replie davantage en étroit : la hauteur est mesurée à l'exécution et
//     appliquée aux quatre cartes, pour qu'elles restent alignées sans jamais
//     rogner leur contenu.
//  3. Le design écoute les flèches sur `window`, ce qui confisquerait ces
//     touches à toute la page. L'écoute est limitée au carrousel.
//  4. Le padding vertical passe par --section-y : dans ce projet, aucune
//     section ne code son rythme en dur, ce sont les trois tokens qui pilotent
//     toute la page.
//  5. color-mix() est remplacé par des rgba() équivalentes, pour ne pas faire
//     dépendre le motif de fond et les survols d'une fonction récente.
//
// Écart assumé aux conventions d'animation du projet : le flou des cartes
// latérales est animé (`filter`), là où la règle est de n'animer que transform
// et opacity. C'est le cœur de l'effet de profondeur voulu par le design. Le
// flou est figé en mouvement réduit, et la bascule reste instantanée.
//
// Typographie des prix : espace FINE insécable (U+202F) avant le symbole euro
// comme en séparateur de milliers. L'insécable classique occupe une cellule
// entière en chasse fixe (17,7px contre 10,2px, mesuré) et détachait
// visiblement l'euro de son montant.
const offers = [
  {
    num: '01',
    kicker: 'Formation',
    title: 'Atelier IA en entreprise',
    pricePrefix: 'À partir de',
    price: '500 €',
    priceNote: null,
    promise: 'On forme votre équipe sur ses vrais dossiers, chez vous.',
    points: [
      '2 à 4 heures selon le nombre de participants',
      '5 à 15 personnes, chacun sur son poste',
      'Cinq usages installés en repartant',
    ],
  },
  {
    num: '02',
    kicker: 'Cadrage',
    title: 'Diagnostic IA et automatisation',
    pricePrefix: 'À partir de',
    price: '800 €',
    priceNote: null,
    promise: 'On vous dit où part votre temps, et ce que vaut chaque piste.',
    points: [
      'Entretiens dirigeant et postes clés',
      'Vos processus cartographiés',
      '3 à 10 pistes chiffrées et classées',
    ],
  },
  {
    num: '03',
    kicker: 'Mise en œuvre',
    title: 'Automatisation sur mesure',
    pricePrefix: 'À partir de',
    price: '1 000 €',
    priceNote: 'puis 100 à 150 € par mois',
    promise: 'Vos logiciels se parlent. Plus aucune ressaisie.',
    points: [
      'Périmètre écrit, prix ferme',
      'Livré en 1 à 4 semaines',
      'Suivi mensuel inclus',
    ],
  },
  {
    num: '04',
    kicker: 'Système livré',
    title: 'Système standardisé',
    pricePrefix: 'À partir de',
    price: '2 000 €',
    priceNote: null,
    promise: 'Votre rendez-vous devient un compte rendu envoyé, sans rien taper.',
    points: [
      'Installé chez notre client qui a témoigné ci-dessous',
      'Agences, artisans, commerciaux, cabinets',
      "La source d'enregistrement reste la vôtre",
    ],
  },
];
---

<section id="offres" class="hrn-offers">
  <div class="hrn-offers__grain" aria-hidden="true"></div>

  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Offres</div>
    <h2>Découvrez nos offres</h2>
    <p class="hrn-lede">Quatre formats, quatre prix affichés. Vous savez avant d'appeler ce que ça coûte et ce que vous recevez.</p>
  </div>

  <div
    class="hrn-offers__stage"
    id="offers-stage"
    aria-roledescription="carousel"
    aria-label="Nos quatre offres"
  >
    <ul class="hrn-offers__deck" id="offers-deck" role="list">
      {offers.map((offer, i) => (
        <li
          class="hrn-offers__slot"
          data-index={i}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} sur ${offers.length} : ${offer.title}`}
        >
          <article class="hrn-offers__card">
            <div class="hrn-offers__card-head">
              <span class="hrn-offers__num">{offer.num}</span>
              <span class="hrn-offers__kicker">{offer.kicker}</span>
            </div>

            <h3 class="hrn-offers__title">{offer.title}</h3>

            <p class="hrn-offers__price">
              <span class="hrn-offers__price-line">
                <span class="hrn-offers__price-from">{offer.pricePrefix}</span>
                <span class="hrn-offers__price-main">{offer.price}</span>
              </span>
              {offer.priceNote && <span class="hrn-offers__price-rec">{offer.priceNote}</span>}
            </p>

            <p class="hrn-offers__pitch">{offer.promise}</p>

            <ul class="hrn-offers__points" role="list">
              {offer.points.map((point) => <li>{point}</li>)}
            </ul>

            <div class="hrn-offers__cta">
              <a href="#reserver" class="hrn-offers__cta-link">Réserver 30 minutes</a>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div class="hrn-section-inner hrn-offers__nav">
    <div class="hrn-offers__arrows">
      <button
        type="button"
        id="offers-prev"
        class="hrn-offers__arrow"
        aria-label="Offre précédente"
        aria-controls="offers-deck"
        disabled
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <button
        type="button"
        id="offers-next"
        class="hrn-offers__arrow"
        aria-label="Offre suivante"
        aria-controls="offers-deck"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>

    <p class="hrn-offers__counter">
      <span id="offers-counter">01</span>
      <span class="hrn-offers__counter-total">/ 0{offers.length}</span>
    </p>

    <div class="hrn-offers__progress" aria-hidden="true">
      <span class="hrn-offers__progress-fill"></span>
    </div>

    <p class="hrn-offers__active-title" id="offers-active-title">{offers[0].title}</p>
  </div>

  <div class="hrn-section-inner hrn-offers__foot">
    <p class="hrn-offers__guard">Tous nos prix sont affichés, toutes nos prestations restent abordables. Des tarifs volontairement accessibles : nous voulons nous faire connaître vite dans la région.</p>

    <p class="hrn-offers__pivot">
      <a href="#reserver">Vous ne savez pas quelle offre vous correspond ? Trente minutes d'échange, gratuit et sans engagement.</a>
    </p>
  </div>
</section>

<style>
  .hrn-offers {
    position: relative;
    overflow: hidden;
    padding: var(--section-y) 0;
    background: var(--slate-900);
    scroll-margin-top: 68px;
  }

  /* Trame de points : rgba plutôt que color-mix, pour ne dépendre d'aucune
     fonction récente. */
  .hrn-offers__grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 26px 26px;
    background-position: -13px -13px;
    pointer-events: none;
  }

  .hrn-offers > .hrn-section-inner {
    position: relative;
  }

  .hrn-offers :global(.hrn-eyebrow) {
    color: var(--slate-300);
  }

  .hrn-offers :global(h2) {
    color: var(--text-inverse);
    letter-spacing: -0.03em;
  }

  .hrn-offers :global(.hrn-lede) {
    color: var(--ink-200);
    margin-top: 20px;
  }

  /* ---------- Scène : l'éventail de cartes ----------
     La hauteur est posée par le script une fois les cartes mesurées ; la valeur
     de repli sert au premier rendu et au cas sans JavaScript. */
  .hrn-offers__stage {
    position: relative;
    margin-top: clamp(14px, 1.6vw, 24px);
    perspective: 1600px;
  }

  /* Repli sans JavaScript : les quatre cartes s'empilent verticalement, toutes
     lisibles. L'éventail n'est armé qu'une fois le script en place (.is-deck),
     sinon elles se superposeraient au centre et trois offres sur quatre
     seraient invisibles. */
  .hrn-offers__deck {
    list-style: none;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hrn-offers__deck.is-deck {
    display: block;
    margin: 0;
    padding: 0;
    max-width: none;
    height: 100%;
  }

  .hrn-offers__deck.is-deck .hrn-offers__slot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-w, 420px);
    /* Le centrage est intégré à la chaîne de transformations : la hauteur peut
       ainsi varier sans casser l'alignement. */
    transform: translate(-50%, -50%) translateX(var(--x, 0px)) scale(var(--s, 1)) rotate(var(--r, 0deg));
    z-index: var(--z, 1);
    opacity: var(--op, 1);
    filter: blur(var(--blur, 0px)) saturate(var(--sat, 1));
    will-change: transform;
  }

  .hrn-offers__deck.is-live .hrn-offers__slot {
    transition:
      transform 0.72s var(--ease-standard),
      filter 0.72s var(--ease-standard),
      opacity 0.72s var(--ease-standard);
  }

  /* Seule la carte au centre est cliquable comme un lien ; les latérales se
     sélectionnent au clic. */
  .hrn-offers__deck.is-deck .hrn-offers__slot:not(.is-active) {
    cursor: pointer;
  }

  .hrn-offers__card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(26px, 3vw, 38px) clamp(22px, 2.6vw, 34px) clamp(24px, 2.6vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 34px 70px -28px rgba(9, 24, 18, 0.75);
  }

  .hrn-offers__card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .hrn-offers__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--slate-500);
  }

  .hrn-offers__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .hrn-offers__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink-950);
    margin: clamp(28px, 3.4vw, 46px) 0 0;
    text-wrap: balance;
  }

  /* ---------- Prix ---------- */
  .hrn-offers__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 20px 0 0;
  }

  .hrn-offers__price-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 9px;
  }

  .hrn-offers__price-from {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink-700);
    white-space: nowrap;
  }

  /* Le montant ne casse jamais au milieu. Collé au « À partir de » dans une
     seule chaîne insécable, il débordait de sa carte en étroit : les deux
     segments sont donc distincts, la coupure se fait entre eux. */
  .hrn-offers__price-main {
    position: relative;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.2vw, 1.875rem);
    letter-spacing: -0.01em;
    color: var(--amber-500);
    white-space: nowrap;
  }

  .hrn-offers__price-rec {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-500);
  }

  /* ---------- Compteur à rouleaux sur le montant ----------

     Le montant part de zéro et défile jusqu'à sa valeur, chiffre par chiffre,
     comme un compteur mécanique, la première fois que sa carte passe au
     centre. Chaque caractère devient une fenêtre d'une ligne contenant une
     bande verticale ; seule la bande bouge, en translateY.

     Le texte d'origine reste dans le flux (.price-ghost) : c'est lui qui donne
     sa largeur et sa ligne de base au prix, et c'est lui que lisent les
     lecteurs d'écran. Les rouleaux sont superposés en absolu par-dessus et
     marqués aria-hidden. Sans JS, en mouvement réduit, ou tant que la carte
     n'est pas passée au centre, le ghost reste visible et rien n'est
     construit : le prix s'affiche normalement.

     Ces éléments sont créés à l'exécution : ils ne portent donc pas l'attribut
     de portée d'Astro, d'où les :global(). */
  :global(.hrn-offers__price-main.is-odometer .hrn-offers__price-ghost) {
    opacity: 0;
  }

  :global(.hrn-offers__price-reels) {
    display: none;
  }

  :global(.hrn-offers__price-main.is-odometer .hrn-offers__price-reels) {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    line-height: 1.2;
    white-space: nowrap;
    /* Les chiffres hors fenêtre existent dans le DOM : sans ceci, copier le
       prix embarquerait toute la bande. */
    user-select: none;
  }

  :global(.hrn-offers__reel) {
    display: inline-block;
    overflow: hidden;
    height: 1.2em;
    vertical-align: top;
  }

  :global(.hrn-offers__reel-strip) {
    display: block;
    transform: translateY(0);
  }

  :global(.hrn-offers__reel-strip > span) {
    display: block;
    height: 1.2em;
    line-height: 1.2;
  }

  :global(.hrn-offers__price-main.is-rolling .hrn-offers__reel-strip) {
    transform: translateY(calc(var(--n, 0) * -1.2em));
    transition: transform 1400ms var(--ease-out) var(--d, 0ms);
  }

  /* ---------- Corps de carte ---------- */
  .hrn-offers__pitch {
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-700);
    margin: 22px 0 0;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
    text-wrap: pretty;
  }

  .hrn-offers__points {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hrn-offers__points li {
    position: relative;
    padding-left: 17px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-600);
  }

  .hrn-offers__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--slate-400);
  }

  .hrn-offers__cta {
    margin-top: auto;
    padding-top: 26px;
  }

  .hrn-offers__cta-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-900);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink-400);
    transition: border-color var(--dur) var(--ease-standard), color var(--dur) var(--ease-standard);
  }

  .hrn-offers__cta-link:hover {
    color: var(--amber-600);
    border-bottom-color: var(--amber-600);
  }

  /* ---------- Barre de navigation ---------- */
  .hrn-offers__nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 24px);
    margin-top: clamp(20px, 2.4vw, 32px);
  }

  .hrn-offers__arrows {
    display: flex;
    gap: 10px;
    flex: none;
  }

  .hrn-offers__arrow {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--border-inverse);
    color: var(--text-inverse);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      opacity var(--dur-fast) var(--ease-standard);
  }

  .hrn-offers__arrow:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .hrn-offers__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .hrn-offers__counter {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    flex: none;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--text-inverse);
    font-weight: 600;
  }

  .hrn-offers__counter-total {
    color: var(--slate-400);
    font-weight: 400;
  }

  /* Barre de progression : elle se remplit d'une carte à l'autre et elle est
     pleine sur la dernière. C'est un scaleX et non une largeur, pour ne pas
     provoquer de reflow à chaque bascule. */
  .hrn-offers__progress {
    position: relative;
    flex: 1;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--border-inverse);
  }

  .hrn-offers__progress-fill {
    position: absolute;
    inset: 0;
    background: var(--amber-500);
    transform: scaleX(var(--p, 0.25));
    transform-origin: left center;
    transition: transform 0.5s var(--ease-out);
  }

  .hrn-offers__active-title {
    margin: 0;
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--slate-300);
  }

  /* ---------- Pied de section ---------- */
  .hrn-offers__foot {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .hrn-offers__guard {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-200);
    margin: 0;
    padding-left: 20px;
    border-left: 2px solid var(--amber-500);
    max-width: 78ch;
    text-wrap: pretty;
  }

  .hrn-offers__pivot {
    margin: 0;
  }

  .hrn-offers__pivot a {
    font-size: 15px;
    color: var(--amber-400);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid currentColor;
  }

  /* ---------- Étroit ---------- */
  @media (max-width: 720px) {
    /* Le flou coûte cher (mesuré : environ 2,5 fois plus d'images perdues
       pendant la bascule) et ne rapporte presque rien ici, où les cartes
       latérales ne dépassent que d'un liseré. Le retrait et l'échelle
       suffisent à donner la profondeur. */
    .hrn-offers__deck.is-deck .hrn-offers__slot {
      filter: none;
    }

    .hrn-offers__nav {
      flex-wrap: wrap;
    }

    /* Le titre de l'offre active passe sous les commandes : à cette largeur il
       écrasait le trait de séparation. */
    .hrn-offers__active-title {
      order: 4;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offers__deck.is-live .hrn-offers__slot {
      transition: none;
    }

    .hrn-offers__deck.is-deck .hrn-offers__slot {
      filter: none;
    }

    :global(.hrn-offers__price-main.is-rolling .hrn-offers__reel-strip) {
      transition: none;
    }

    .hrn-offers__progress-fill {
      transition: none;
    }
  }
</style>

<script>
  const NB_CARTES = 4;

  // Compteur à rouleaux
  const TOURS = 2; // séries 0-9 traversées avant de se poser
  const DECALAGE = 90; // ms entre deux chiffres voisins

  let stage: HTMLElement | null = null;
  let deck: HTMLElement | null = null;
  let slots: HTMLElement[] = [];
  let actif = 0;
  let derniereLargeur = 0;
  let ctrl: AbortController | undefined;
  let reduit = false;

  function teardownOffers() {
    ctrl?.abort();
    ctrl = undefined;
    stage = null;
    deck = null;
    slots = [];
    actif = 0;
    derniereLargeur = 0;
  }

  /* ---------------------------------------------------- compteur à rouleaux */

  function construireRouleaux(prix: HTMLElement) {
    if (prix.dataset.rouleaux === 'ok') return;

    const texte = prix.textContent ?? '';
    if (!texte) return;

    const ghost = document.createElement('span');
    ghost.className = 'hrn-offers__price-ghost';
    ghost.textContent = texte;

    const reels = document.createElement('span');
    reels.className = 'hrn-offers__price-reels';
    reels.setAttribute('aria-hidden', 'true');

    let rang = 0;
    for (const caractere of texte) {
      const fenetre = document.createElement('span');
      fenetre.className = 'hrn-offers__reel';

      const bande = document.createElement('span');
      bande.className = 'hrn-offers__reel-strip';

      if (caractere >= '0' && caractere <= '9') {
        // La bande va de 0 jusqu'au chiffre visé, en repassant TOURS fois par
        // la série complète. Sa position finale est son dernier index.
        const arrivee = TOURS * 10 + Number(caractere);
        for (let i = 0; i <= arrivee; i++) {
          const cellule = document.createElement('span');
          cellule.textContent = String(i % 10);
          bande.appendChild(cellule);
        }
        bande.style.setProperty('--n', String(arrivee));
        bande.style.setProperty('--d', `${rang * DECALAGE}ms`);
        rang++;
      } else {
        // Espaces et symbole euro : une seule cellule, la bande ne bouge pas.
        const cellule = document.createElement('span');
        cellule.textContent = caractere;
        bande.appendChild(cellule);
      }

      fenetre.appendChild(bande);
      reels.appendChild(fenetre);
    }

    prix.textContent = '';
    prix.append(ghost, reels);
    prix.dataset.rouleaux = 'ok';
    prix.classList.add('is-odometer');
  }

  // Rejoué à chaque passage au centre, et pas seulement la première fois : on
  // retire la classe pour que les bandes reviennent à zéro (le retour n'est pas
  // transitionné, il est donc instantané), puis on la repose.
  function lancerRouleaux(slot: HTMLElement) {
    const prix = slot.querySelector<HTMLElement>('.hrn-offers__price-main');
    if (!prix) return;

    construireRouleaux(prix);
    prix.classList.remove('is-rolling');
    // Une transition ne peut pas partir d'un état posé dans la même frame :
    // sans ce reflow, la remise à zéro et le départ fusionneraient et les
    // bandes sauteraient directement à leur chiffre.
    void prix.offsetHeight;
    prix.classList.add('is-rolling');
  }

  /* --------------------------------------------------------- mise en place */

  // Hauteur commune aux quatre cartes : on efface, on mesure la plus haute, on
  // l'applique à toutes. Sans cela l'éventail serait irrégulier, et une carte
  // plus longue que la scène se ferait rogner.
  // La largeur de carte est posée d'abord : mesurer avant elle reviendrait à
  // mesurer la hauteur du contenu pour une carte plus large que celle qui sera
  // réellement affichée, et le texte finirait rogné en étroit.
  function poserLargeur() {
    if (!stage) return 420;
    const largeur = Math.min(420, stage.clientWidth - 40);
    stage.style.setProperty('--card-w', `${largeur}px`);
    return largeur;
  }

  // Proportion de carte voulue par le design : 420 de large pour 630 de haut.
  // Sans ce plancher, la hauteur suivait le seul contenu et les cartes
  // paraissaient trapues sur grand écran.
  const RATIO = 1.5;

  function mesurerHauteur(largeurCarte: number) {
    if (!stage || !slots.length) return;
    for (const slot of slots) slot.style.height = '';
    stage.style.height = '';
    let max = Math.round(largeurCarte * RATIO);
    for (const slot of slots) max = Math.max(max, slot.offsetHeight);
    for (const slot of slots) slot.style.height = `${max}px`;
    stage.style.height = `${max}px`;
  }

  // Largeur, puis hauteur, puis placement : cet ordre est ce qui garantit que
  // rien n'est rogné.
  function disposer() {
    mesurerHauteur(poserLargeur());
    placer();
  }

  // Géométrie de l'éventail, portée du fichier de design mais recalculée à
  // partir de la largeur réelle de la carte plutôt que d'un 420px figé.
  function placer() {
    if (!stage || !slots.length) return;

    const largeurScene = stage.clientWidth;
    const largeurCarte = Math.min(420, largeurScene - 40);

    const marge = Math.max(0, (largeurScene - largeurCarte) / 2 - 24);
    const ecart = Math.max(largeurCarte * 0.36, Math.min(302, marge - 100));
    const pas = Math.max(24, Math.min(46, (marge - ecart + largeurCarte / 2) / 5));

    slots.forEach((slot, i) => {
      const offset = i - actif;
      const distance = Math.abs(offset);
      const sens = Math.sign(offset);
      const x = offset === 0 ? 0 : sens * (ecart + (distance - 1) * pas);
      const echelle = offset === 0 ? 1 : Math.max(0.72, 0.87 - (distance - 1) * 0.045);
      const rotation = offset === 0 ? 0 : sens * (3 + (distance - 1) * 1.2);
      const flou = offset === 0 ? 0 : Math.min(9, 4.5 + (distance - 1) * 2);
      const opacite = offset === 0 ? 1 : Math.max(0.3, 0.62 - (distance - 1) * 0.14);

      slot.style.setProperty('--x', `${x}px`);
      slot.style.setProperty('--s', String(echelle));
      slot.style.setProperty('--r', `${rotation}deg`);
      slot.style.setProperty('--blur', `${flou}px`);
      slot.style.setProperty('--sat', offset === 0 ? '1' : '0.85');
      slot.style.setProperty('--op', String(opacite));
      slot.style.setProperty('--z', String(100 - distance));

      slot.classList.toggle('is-active', offset === 0);
      // Une carte en retrait est décorative : elle sort du parcours au clavier
      // et de l'arbre d'accessibilité, sinon on tabulerait dans du texte flou.
      slot.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
      const lien = slot.querySelector<HTMLAnchorElement>('.hrn-offers__cta-link');
      if (lien) lien.tabIndex = offset === 0 ? 0 : -1;
    });

    const compteur = document.getElementById('offers-counter');
    const titre = document.getElementById('offers-active-title');
    const carteActive = slots[actif];
    if (compteur) compteur.textContent = carteActive.querySelector('.hrn-offers__num')?.textContent ?? '';
    if (titre) titre.textContent = carteActive.querySelector('.hrn-offers__title')?.textContent ?? '';

    const barre = document.querySelector<HTMLElement>('.hrn-offers__progress-fill');
    if (barre) barre.style.setProperty('--p', String((actif + 1) / slots.length));

    const prec = document.getElementById('offers-prev') as HTMLButtonElement | null;
    const suiv = document.getElementById('offers-next') as HTMLButtonElement | null;
    if (prec) prec.disabled = actif === 0;
    if (suiv) suiv.disabled = actif === slots.length - 1;
  }

  function aller(cible: number) {
    const borne = Math.min(slots.length - 1, Math.max(0, cible));
    if (borne === actif) return;
    actif = borne;
    placer();
    if (!reduit) lancerRouleaux(slots[actif]);
  }

  function initOffers() {
    teardownOffers();

    stage = document.getElementById('offers-stage');
    deck = document.getElementById('offers-deck');
    if (!stage || !deck) return;

    slots = [...deck.querySelectorAll<HTMLElement>('.hrn-offers__slot')];
    if (slots.length !== NB_CARTES) return;

    reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    ctrl = new AbortController();
    const { signal } = ctrl;

    deck.classList.add('is-deck');
    disposer();
    // Les transitions ne sont armées qu'après le premier placement, sinon les
    // cartes glisseraient depuis le centre au chargement de la page.
    requestAnimationFrame(() => deck?.classList.add('is-live'));

    document.getElementById('offers-prev')?.addEventListener('click', () => aller(actif - 1), { signal });
    document.getElementById('offers-next')?.addEventListener('click', () => aller(actif + 1), { signal });

    slots.forEach((slot, i) => {
      slot.addEventListener('click', () => { if (i !== actif) aller(i); }, { signal });
    });

    // Les flèches sont écoutées sur le carrousel et non sur window : sinon
    // elles seraient confisquées au reste de la page.
    stage.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); aller(actif + 1); }
      else if (event.key === 'ArrowLeft') { event.preventDefault(); aller(actif - 1); }
    }, { signal });

    // Sur mobile, l'apparition de la barre d'adresse émet un resize alors que
    // seule la HAUTEUR change. On ne réagit donc qu'aux changements de largeur.
    derniereLargeur = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === derniereLargeur) return;
      derniereLargeur = window.innerWidth;
      disposer();
    }, { signal });

    // Le compteur de la carte du milieu ne part qu'une fois la section à
    // l'écran, sinon il se serait déjà joué quand le visiteur y arrive.
    if (!reduit) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          lancerRouleaux(slots[actif]);
          io.disconnect();
        }
      }, { threshold: 0.25 });
      io.observe(stage);
      signal.addEventListener('abort', () => io.disconnect());
    }
  }

  document.addEventListener('astro:page-load', initOffers);
  document.addEventListener('astro:before-swap', teardownOffers);
</script>
