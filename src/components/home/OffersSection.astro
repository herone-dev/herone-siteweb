---
// Section « Nos offres » : 4 formats, 4 prix affichés en clair.
//
// Chaque carte : un numéro, un titre, un prix, une accroche d'une ligne et
// trois points. Structure identique pour les quatre, pour qu'elles se lisent
// en parallèle.
//
// Règle produit : les quatre prix restent visibles sans aucune interaction
// (aucun bloc repliable, aucun accordeon, aucune troncature). Les données sont
// centralisées dans le tableau `offers` puis bouclées dans le markup, comme
// dans MethodSection.astro et ConvictionSection.astro.
//
// Typographie des prix : espaces insécables (U+00A0) avant le symbole euro et
// comme séparateur de milliers. Le prix est en `white-space: nowrap` pour ne
// jamais casser au milieu ; l'offre 3 est découpée en deux segments
// insécables (montant d'installation / mensualité) afin de rester lisibles sur
// mobile. La liaison entre les deux segments n'est jamais mise dans la donnée :
// une virgule finale resterait orpheline en gros corps quand le segment mensuel
// passe à la ligne.
//
// Animation = reveal d'entrée sobre (fondu + léger translate) en CSS +
// IntersectionObserver, conformément aux conventions du projet (pas de GSAP,
// uniquement transform et opacity). Le reveal porte sur le <li> conteneur et
// non sur la carte, pour ne pas entrer en conflit avec le translate de survol.
// Sans JS ou en prefers-reduced-motion, tout est visible d'emblée.
const offers = [
  {
    num: '01',
    title: 'Atelier IA en entreprise',
    price: '300 à 600 €',
    priceExtra: null,
    pitch: 'On forme votre équipe sur ses vrais dossiers, chez vous.',
    points: [
      '2 à 4 heures selon le nombre de participants',
      '5 à 15 personnes, chacun sur son poste',
      'Cinq usages installés en repartant',
    ],
  },
  {
    num: '02',
    title: 'Diagnostic IA et automatisation',
    price: '800 à 1 500 €',
    priceExtra: null,
    pitch: 'On vous dit où part votre temps, et ce que vaut chaque piste.',
    points: [
      'Entretiens dirigeant et postes clés',
      'Vos processus cartographiés',
      '3 à 10 pistes chiffrées et classées',
    ],
  },
  {
    num: '03',
    title: 'Automatisation à prix fixe',
    price: '500 à 2 500 €',
    priceExtra: 'puis 100 à 150 € par mois',
    pitch: 'Vos logiciels se parlent. Plus aucune ressaisie.',
    points: [
      'Périmètre écrit, prix ferme',
      'Livré en 2 à 5 jours',
      'Suivi mensuel inclus',
    ],
  },
  {
    num: '04',
    title: 'Du rendez-vous au compte rendu',
    price: '1 500 à 2 500 €',
    priceExtra: null,
    pitch: 'Votre rendez-vous devient un compte rendu envoyé, sans rien taper.',
    points: [
      'Installé chez notre client qui a témoigné ci-dessous',
      'Agences, artisans, commerciaux, cabinets',
      "La source d'enregistrement reste la vôtre",
    ],
  },
];
---

<section id="offres" class="hrn-offers">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Offres</div>
    <h2>Nos offres</h2>
    <p class="hrn-lede">Quatre formats, quatre prix affichés. Vous savez avant d'appeler ce que ça coûte et ce que vous recevez.</p>

    <ul class="hrn-offers__grid" id="offers-grid" role="list">
      {offers.map((offer, i) => (
        <li class="hrn-offers__item" style={`--i:${i}`}>
          <article class="hrn-offers__card">
            <div class="hrn-offers__num">{offer.num}</div>
            <h3 class="hrn-offers__title">{offer.title}</h3>

            <p class="hrn-offers__price">
              <span class="hrn-offers__price-main">{offer.price}</span>
              {offer.priceExtra && <span class="hrn-offers__price-rec">{offer.priceExtra}</span>}
            </p>

            <p class="hrn-offers__pitch">{offer.pitch}</p>

            <ul class="hrn-offers__points" role="list">
              {offer.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ul>

    <p class="hrn-offers__guard">Aucune prestation au-dessus de 3 000 €.</p>

    <p class="hrn-offers__pivot">
      <a href="#reserver">Vous ne savez pas quelle offre vous correspond ? Trente minutes d'échange, gratuit et sans engagement.</a>
    </p>
  </div>
</section>

<style>
  .hrn-offers {
    padding: var(--section-y) 0;
    /* Le carrousel « Le constat », juste au-dessus, est en --surface depuis le
       retrait de la section Systèmes : on inverse fond de section et fond de
       carte pour ne pas coller deux bandes identiques. */
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  .hrn-offers .hrn-lede {
    margin-top: 16px;
  }

  /* ---------- Grille : 2 colonnes en desktop, 1 colonne en mobile ---------- */
  .hrn-offers__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: clamp(32px, 5vw, 44px) 0 0;
    padding: 0;
  }

  .hrn-offers__item {
    display: flex;
  }

  .hrn-offers__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 2.6vw, 30px);
    transition:
      box-shadow var(--dur) var(--ease-standard),
      transform var(--dur) var(--ease-standard),
      border-color var(--dur);
  }

  .hrn-offers__card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  /* ---------- Tête de carte ---------- */
  .hrn-offers__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--slate-600);
  }

  .hrn-offers__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 10px 0 0;
    text-wrap: balance;
  }

  /* Le prix reste lisible et ne casse jamais au milieu : chaque segment est
     insécable, le retour à la ligne ne peut se faire qu'entre les segments. */
  .hrn-offers__price {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
  }

  .hrn-offers__price-main {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--amber-600);
    white-space: nowrap;
  }

  .hrn-offers__price-rec {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.3;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .hrn-offers__pitch {
    margin: 14px 0 0;
    font-size: clamp(0.98rem, 1.2vw, 1.05rem);
    line-height: 1.5;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  /* `margin-top: auto` colle la liste au bas de la carte : les trois points
     s'alignent d'une carte à l'autre même si une accroche passe sur deux
     lignes. */
  .hrn-offers__points {
    list-style: none;
    margin: auto 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .hrn-offers__points li {
    position: relative;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Puce dessinée en CSS plutôt qu'un caractère : aucun tiret dans le texte,
     et la taille ne dépend pas de la police. */
  .hrn-offers__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--slate-400);
  }

  /* ---------- Réassurance (encart discret, pas une carte) ---------- */
  .hrn-offers__guard {
    margin: 28px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--amber-300);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: color-mix(in srgb, var(--amber-50) 55%, transparent);
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    line-height: 1.55;
    color: var(--text-strong);
    /* La phrase est courte : l'encart épouse sa largeur au lieu de s'étirer. */
    width: fit-content;
    max-width: 100%;
    text-wrap: pretty;
  }

  .hrn-offers__pivot {
    margin: 20px 0 0;
    font-size: 15px;
  }

  .hrn-offers__pivot a {
    color: var(--amber-600);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-offers__pivot a:hover {
    border-color: currentColor;
  }

  @media (max-width: 820px) {
    .hrn-offers__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Reveals d'entrée ----------
     État initial masqué activé UNIQUEMENT par le JS (classe .reveals), pour que
     le contenu reste visible sans JS. */
  .hrn-offers__grid.reveals .hrn-offers__item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .hrn-offers__grid.reveals .hrn-offers__item.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offers__grid.reveals .hrn-offers__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardownOffers() {
    io?.disconnect();
    io = undefined;
  }

  function initOffers() {
    teardownOffers();

    const grid = document.querySelector<HTMLElement>('#offers-grid');
    if (!grid) return;
    const items = [...grid.children] as HTMLElement[];
    if (!items.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.classList.add('reveals');

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          io?.unobserve(entry.target); // reveal unique
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    items.forEach((item) => io!.observe(item));
  }

  document.addEventListener('astro:page-load', initOffers);
  document.addEventListener('astro:before-swap', teardownOffers);
</script>
