---
// Section « Nos offres » : 4 formats, 4 prix affichés en clair.
//
// Chaque carte : un numéro, un titre, un prix, une accroche d'une ligne et
// trois points. Structure identique pour les quatre, pour qu'elles se lisent
// en parallèle.
//
// Règle produit : les quatre prix restent visibles sans aucune interaction
// (aucun bloc repliable, aucun accordeon, aucune troncature). Les données sont
// centralisées dans le tableau `offers` puis bouclées dans le markup, comme
// dans MethodSection.astro et ConvictionSection.astro.
//
// Typographie des prix : espace insécable (U+00A0) avant le symbole euro, et
// espace FINE insécable (U+202F) comme séparateur de milliers. L'insécable
// classique écartait trop le chiffre des milliers de celui des centaines. Le prix est en `white-space: nowrap` pour ne
// jamais casser au milieu ; l'offre 3 est découpée en deux segments
// insécables (montant d'installation / mensualité) afin de rester lisibles sur
// mobile. Le « À partir de » est lui aussi un segment distinct : colle au
// montant dans une seule chaîne insécable, il débordait sous 360px.
// La liaison entre les deux segments n'est jamais mise dans la donnée :
// une virgule finale resterait orpheline en gros corps quand le segment mensuel
// passe à la ligne.
//
// Animation = reveal d'entrée sobre (fondu + léger translate) en CSS +
// IntersectionObserver, conformément aux conventions du projet (pas de GSAP,
// uniquement transform et opacity). Le reveal porte sur le <li> conteneur et
// non sur la carte, pour ne pas entrer en conflit avec le translate de survol.
// Sans JS ou en prefers-reduced-motion, tout est visible d'emblée.
const offers = [
  {
    num: '01',
    title: 'Atelier IA en entreprise',
    price: '500 €',
    priceFrom: true,
    priceExtra: null,
    pitch: 'On forme votre équipe sur ses vrais dossiers, chez vous.',
    points: [
      '2 à 4 heures selon le nombre de participants',
      '5 à 15 personnes, chacun sur son poste',
      'Cinq usages installés en repartant',
    ],
  },
  {
    num: '02',
    title: 'Diagnostic IA et automatisation',
    price: '800 €',
    priceFrom: true,
    priceExtra: null,
    pitch: 'On vous dit où part votre temps, et ce que vaut chaque piste.',
    points: [
      'Entretiens dirigeant et postes clés',
      'Vos processus cartographiés',
      '3 à 10 pistes chiffrées et classées',
    ],
  },
  {
    num: '03',
    title: 'Automatisation sur mesure',
    price: '1 000 €',
    priceFrom: true,
    priceExtra: 'puis 100 à 150 € par mois',
    pitch: 'Vos logiciels se parlent. Plus aucune ressaisie.',
    points: [
      'Périmètre écrit, prix ferme',
      'Livré en 1 à 4 semaines',
      'Suivi mensuel inclus',
    ],
  },
  {
    num: '04',
    title: 'Du rendez-vous au compte rendu',
    price: '2 000 €',
    priceFrom: true,
    priceExtra: null,
    pitch: 'Votre rendez-vous devient un compte rendu envoyé, sans rien taper.',
    points: [
      'Installé chez notre client qui a témoigné ci-dessous',
      'Agences, artisans, commerciaux, cabinets',
      "La source d'enregistrement reste la vôtre",
    ],
  },
];
---

<section id="offres" class="hrn-offers">
  <div class="hrn-section-inner">
    <div class="hrn-eyebrow">Offres</div>
    <h2>Nos offres</h2>
    <p class="hrn-lede">Quatre formats, quatre prix affichés. Vous savez avant d'appeler ce que ça coûte et ce que vous recevez.</p>

    <ul class="hrn-offers__grid" id="offers-grid" role="list">
      {offers.map((offer, i) => (
        <li class="hrn-offers__item" style={`--i:${i}`}>
          <article class="hrn-offers__card">
            <div class="hrn-offers__num">{offer.num}</div>
            <h3 class="hrn-offers__title">{offer.title}</h3>

            <p class="hrn-offers__price">
              {offer.priceFrom && <span class="hrn-offers__price-from">À partir de</span>}
              <span class="hrn-offers__price-main">{offer.price}</span>
              {offer.priceExtra && <span class="hrn-offers__price-rec">{offer.priceExtra}</span>}
            </p>

            <p class="hrn-offers__pitch">{offer.pitch}</p>

            <ul class="hrn-offers__points" role="list">
              {offer.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ul>

    <p class="hrn-offers__guard">Tous nos prix sont affichés, toutes nos prestations restent abordables. Des tarifs volontairement accessibles : nous voulons nous faire connaître vite dans la région.</p>

    <p class="hrn-offers__pivot">
      <a href="#reserver">Vous ne savez pas quelle offre vous correspond ? Trente minutes d'échange, gratuit et sans engagement.</a>
    </p>
  </div>
</section>

<style>
  .hrn-offers {
    padding: var(--section-y) 0;
    /* Le carrousel « Le constat », juste au-dessus, est en --surface depuis le
       retrait de la section Systèmes : on inverse fond de section et fond de
       carte pour ne pas coller deux bandes identiques. */
    background: var(--paper);
    scroll-margin-top: 68px;
  }

  .hrn-offers .hrn-lede {
    margin-top: 16px;
  }

  /* ---------- Grille : 2 colonnes en desktop, 1 colonne en mobile ---------- */
  .hrn-offers__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: clamp(32px, 5vw, 44px) 0 0;
    padding: 0;
  }

  .hrn-offers__item {
    display: flex;
  }

  .hrn-offers__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 2.6vw, 30px);
    transition:
      box-shadow var(--dur) var(--ease-standard),
      transform var(--dur) var(--ease-standard),
      border-color var(--dur);
  }

  .hrn-offers__card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  /* ---------- Tête de carte ---------- */
  .hrn-offers__num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--slate-600);
  }

  .hrn-offers__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 10px 0 0;
    text-wrap: balance;
  }

  /* Le prix reste lisible et ne casse jamais au milieu : chaque segment est
     insécable, le retour à la ligne ne peut se faire qu'entre les segments. */
  .hrn-offers__price {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
  }

  .hrn-offers__price-from {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.3;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .hrn-offers__price-main {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--amber-600);
    white-space: nowrap;
  }

  /* ---------- Compteur a rouleaux sur le montant ----------

     Le montant part de zero et defile jusqu'a sa valeur, chiffre par chiffre,
     comme un compteur mecanique. Chaque caractere devient une fenetre d'une
     ligne contenant une bande verticale ; seule la bande bouge, en translateY.
     Aucune propriete de mise en page n'est animee.

     Le texte d'origine reste dans le flux (.price-ghost) : c'est lui qui donne
     sa largeur et sa ligne de base au prix, et c'est lui que lisent les
     lecteurs d'ecran. Les rouleaux sont superposes en absolu par-dessus et
     marques aria-hidden. Sans JS, sans intersection, ou en mouvement reduit,
     le ghost reste visible et rien n'est construit : le prix s'affiche
     normalement.

     Ces elements sont crees a l'execution : ils ne portent donc pas
     l'attribut de portee d'Astro, d'ou les :global(). */
  .hrn-offers__price-main {
    position: relative;
  }

  :global(.hrn-offers__price-main.is-odometer .hrn-offers__price-ghost) {
    opacity: 0;
  }

  :global(.hrn-offers__price-reels) {
    display: none;
  }

  :global(.hrn-offers__price-main.is-odometer .hrn-offers__price-reels) {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    line-height: 1.2;
    white-space: nowrap;
    /* Les chiffres hors fenetre existent dans le DOM : sans ceci, copier le
       prix embarquerait toute la bande. */
    user-select: none;
  }

  /* La fenetre : une seule ligne visible sur toute la bande. */
  :global(.hrn-offers__reel) {
    display: inline-block;
    overflow: hidden;
    height: 1.2em;
    vertical-align: top;
  }

  :global(.hrn-offers__reel-strip) {
    display: block;
    transform: translateY(0);
  }

  :global(.hrn-offers__reel-strip > span) {
    display: block;
    height: 1.2em;
    line-height: 1.2;
  }

  /* Le defilement : chaque bande remonte jusqu'a son chiffre, avec un leger
     decalage de gauche a droite pour que les chiffres se posent en cascade. */
  :global(.hrn-offers__price-main.is-rolling .hrn-offers__reel-strip) {
    transform: translateY(calc(var(--n, 0) * -1.2em));
    transition: transform 820ms var(--ease-out) var(--d, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hrn-offers__price-main.is-rolling .hrn-offers__reel-strip) {
      transition: none;
    }
  }

  .hrn-offers__price-rec {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.3;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .hrn-offers__pitch {
    margin: 14px 0 0;
    font-size: clamp(0.98rem, 1.2vw, 1.05rem);
    line-height: 1.5;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  /* `margin-top: auto` colle la liste au bas de la carte : les trois points
     s'alignent d'une carte à l'autre même si une accroche passe sur deux
     lignes. */
  .hrn-offers__points {
    list-style: none;
    margin: auto 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .hrn-offers__points li {
    position: relative;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Puce dessinée en CSS plutôt qu'un caractère : aucun tiret dans le texte,
     et la taille ne dépend pas de la police. */
  .hrn-offers__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--slate-400);
  }

  /* ---------- Réassurance (encart discret, pas une carte) ---------- */
  .hrn-offers__guard {
    margin: 28px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--amber-300);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background: color-mix(in srgb, var(--amber-50) 55%, transparent);
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    line-height: 1.55;
    color: var(--text-strong);
    /* La phrase est courte : l'encart épouse sa largeur au lieu de s'étirer. */
    width: fit-content;
    max-width: 100%;
    text-wrap: pretty;
  }

  .hrn-offers__pivot {
    margin: 20px 0 0;
    font-size: 15px;
  }

  .hrn-offers__pivot a {
    color: var(--amber-600);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-offers__pivot a:hover {
    border-color: currentColor;
  }

  @media (max-width: 820px) {
    .hrn-offers__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Reveals d'entrée ----------
     État initial masqué activé UNIQUEMENT par le JS (classe .reveals), pour que
     le contenu reste visible sans JS. */
  .hrn-offers__grid.reveals .hrn-offers__item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .hrn-offers__grid.reveals .hrn-offers__item.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-offers__grid.reveals .hrn-offers__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;

  function teardownOffers() {
    io?.disconnect();
    io = undefined;
  }

  // Nombre de series completes 0-9 traversees avant de se poser sur le bon
  // chiffre. Deux tours suffisent a lire le mouvement sans le faire trainer.
  const TOURS = 2;
  const DECALAGE = 60; // ms entre deux chiffres voisins

  // Construit les rouleaux a partir du texte deja affiche. Idempotent.
  function construireRouleaux(prix: HTMLElement) {
    if (prix.dataset.rouleaux === 'ok') return;

    const texte = prix.textContent ?? '';
    if (!texte) return;

    const ghost = document.createElement('span');
    ghost.className = 'hrn-offers__price-ghost';
    ghost.textContent = texte;

    const reels = document.createElement('span');
    reels.className = 'hrn-offers__price-reels';
    reels.setAttribute('aria-hidden', 'true');

    let rang = 0;
    for (const caractere of texte) {
      const fenetre = document.createElement('span');
      fenetre.className = 'hrn-offers__reel';

      const bande = document.createElement('span');
      bande.className = 'hrn-offers__reel-strip';

      if (caractere >= '0' && caractere <= '9') {
        // La bande va de 0 jusqu'au chiffre vise, en repassant TOURS fois par
        // la serie complete. Sa position finale est son dernier index.
        const arrivee = TOURS * 10 + Number(caractere);
        for (let i = 0; i <= arrivee; i++) {
          const cellule = document.createElement('span');
          cellule.textContent = String(i % 10);
          bande.appendChild(cellule);
        }
        bande.style.setProperty('--n', String(arrivee));
        bande.style.setProperty('--d', `${rang * DECALAGE}ms`);
        rang++;
      } else {
        // Espaces et symbole euro : une seule cellule, la bande ne bouge pas.
        const cellule = document.createElement('span');
        cellule.textContent = caractere;
        bande.appendChild(cellule);
      }

      fenetre.appendChild(bande);
      reels.appendChild(fenetre);
    }

    prix.textContent = '';
    prix.append(ghost, reels);
    prix.dataset.rouleaux = 'ok';
    prix.classList.add('is-odometer');
  }

  function lancerRouleaux(carte: Element) {
    const prix = carte.querySelector<HTMLElement>('.hrn-offers__price-main');
    if (!prix || prix.classList.contains('is-rolling')) return;

    construireRouleaux(prix);
    // Une transition ne peut pas partir d'un etat pose dans la meme frame :
    // sans ce reflow, les bandes sauteraient directement a leur chiffre.
    void prix.offsetHeight;
    prix.classList.add('is-rolling');
  }

  function initOffers() {
    teardownOffers();

    const grid = document.querySelector<HTMLElement>('#offers-grid');
    if (!grid) return;
    const items = [...grid.children] as HTMLElement[];
    if (!items.length) return;

    // Sans animation : on laisse tout visible (pas de classe .reveals).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    grid.classList.add('reveals');

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          lancerRouleaux(entry.target);
          io?.unobserve(entry.target); // reveal unique
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );

    items.forEach((item) => io!.observe(item));
  }

  document.addEventListener('astro:page-load', initOffers);
  document.addEventListener('astro:before-swap', teardownOffers);
</script>
