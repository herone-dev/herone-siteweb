---
/* Couvertures d'articles, dessinées en SVG.
 *
 * Aucune image à produire ni à charger : chaque motif est une composition de
 * formes simples peintes avec les jetons --blog-*, donc elle suit la palette
 * du blog sans retouche.
 *
 * Deux variantes :
 *   card  400 x 260, dans les cartes de la liste et de « À lire ensuite » ;
 *   wide  1280 x 360, pour le bandeau qui ouvre une page article.
 *
 * Les motifs « agenda », « compte-rendu », « devis », « formulaire »,
 * « reporting » et « relances » sont repris au tracé près de la planche
 * B-EnBref des maquettes. Le bandeau large de « tri-mails » et celui de
 * « compte-rendu » viennent eux aussi des maquettes.
 *
 * Écarts assumés, faute de maquette pour ces cas :
 *   - les cinq autres bandeaux larges sont composés ici sur le gabarit commun
 *     aux deux bandeaux fournis (fond orange, demi-soleil sombre en bas à
 *     droite, deux lignes de sol, dessin du sujet à gauche) ;
 *   - la version carte de « tri-mails » reprend le dessin du bandeau large,
 *     réduit par une transformation plutôt que redessiné, pour que les deux
 *     formats restent rigoureusement identiques ;
 *   - le motif « soleil », repli des slugs sans entrée dans blog-covers.ts,
 *     reprend le demi-soleil rayé de la section 7.1 du cahier des charges.
 */
interface Props {
  motif?: string;
  variant?: 'card' | 'wide';
  class?: string;
}

const { motif = 'soleil', variant = 'card', class: classe } = Astro.props;
const viewBox = variant === 'wide' ? '0 0 1280 360' : '0 0 400 260';
