---
import { pointDe } from '../../data/blog-categories';

/* Carte d'article du blog (refonte du 22 septembre 2026).
 *
 * Carte crème sobre, sans illustration : point de catégorie, catégorie,
 * durée et date, titre, extrait, « Lire l'article ». La variante `compact`,
 * utilisée par les articles liés en bas de page, ne garde que les
 * métadonnées et le titre.
 *
 * Toute la carte est un lien : un seul élément dans l'arbre d'accessibilité,
 * un seul arrêt au clavier. Le titre reste un vrai <h3> à l'intérieur du lien,
 * pour la navigation par titres.
 *
 * La carte porte .hrn-zone-creme : posée sur le fond bleu du blog, elle
 * retrouve les encres sombres du site sans les redéclarer ici.
 */
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  readingTime: number;
  compact?: boolean;
}

const { slug, title, description, category, pubDate, readingTime, compact = false } = Astro.props;

const dateLisible = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(pubDate);
const dateMachine = pubDate.toISOString().slice(0, 10);

// Point médian des libellés, posé à l'exécution : écrit en clair, il
// survivrait mal aux outils d'édition (piège n°7 du projet).
const POINT = ` ${String.fromCodePoint(0x00b7)} `;
---

<article class:list={['hrn-card', 'hrn-zone-creme', compact && 'hrn-card--compact']}>
  <a class="hrn-card__lien" href={`/blog/${slug}`}>
    <p class="hrn-card__meta">
      <span class="hrn-card__point" style={`--point: ${pointDe(category)}`} aria-hidden="true"></span>
      <span class="hrn-card__cat">{category}</span>
      <span>{POINT}{readingTime} min{POINT}<time datetime={dateMachine}>{dateLisible}</time></span>
    </p>
    <h3 class="hrn-card__titre">{title}</h3>
    {!compact && <p class="hrn-card__desc">{description}</p>}
    {!compact && (
      <span class="hrn-card__lire">
        Lire l'article
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )}
  </a>
</article>

<style>
  .hrn-card {
    background: var(--surface);
    border: 1px solid var(--creme-bordure);
    border-radius: var(--radius-xl);
    transition:
      transform var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-standard);
  }

  .hrn-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .hrn-card:focus-within {
    box-shadow: 0 0 0 3px var(--amber-300);
  }

  .hrn-card__lien {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 22px 24px 24px;
    color: var(--text-strong);
    text-decoration: none;
  }

  .hrn-card__lien:focus-visible {
    outline: none;
  }

  /* Libellés en mono capitales. La date et la durée passent en encre
     secondaire et non en gris clair : sur le crème, le gris clair des maquettes
     (--ink-400) ne donne que 3,6:1, sous le seuil de 4,5:1 d'un texte de 11px. */
  .hrn-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 7px;
    row-gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .hrn-card__point {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--point);
  }

  .hrn-card__cat {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-600);
  }

  /* La règle « section h3 » n'existe pas, mais la carte peut être posée dans
     une section : on fixe tout ici. */
  .hrn-card__titre {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: var(--weight-titre);
    line-height: 1.18;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: pretty;
  }

  .hrn-card__desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* Poussé en bas de carte : sur une rangée, les liens s'alignent même quand
     les titres n'ont pas le même nombre de lignes. */
  .hrn-card__lire {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-texte);
  }

  .hrn-card__lire svg {
    transition: transform var(--dur-fast) var(--ease-standard);
  }

  .hrn-card:hover .hrn-card__lire svg {
    transform: translateX(3px);
  }

  /* ---------- Variante compacte (articles liés) ---------- */
  .hrn-card--compact .hrn-card__lien {
    padding: 18px 20px 20px;
  }

  .hrn-card--compact .hrn-card__titre {
    font-size: 18px;
  }

  @media (max-width: 759px) {
    .hrn-card__lien {
      padding: 18px 18px 20px;
    }

    .hrn-card__titre {
      font-size: 20px;
    }

    .hrn-card--compact .hrn-card__titre {
      font-size: 17px;
    }

    /* Trois lignes d'extrait au plus : la liste mobile reste lisible d'un
       coup de pouce. Le texte complet reste dans le DOM. */
    .hrn-card__desc {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-card,
    .hrn-card__lire svg {
      transition: none;
    }

    .hrn-card:hover,
    .hrn-card:hover .hrn-card__lire svg {
      transform: none;
    }
  }
</style>
