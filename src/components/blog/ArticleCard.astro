---
import BlogCover from './BlogCover.astro';
import { motifDe } from '../../data/blog-covers';

/* Carte d'article du blog.
 *
 * Un seul balisage pour deux mises en page, commutées par media query :
 *   - au dessus de 760px, une carte verticale, couverture en haut ;
 *   - en dessous, une ligne : vignette carrée de 96px à gauche, texte à
 *     droite, séparateur en bas, et la description est masquée faute de place.
 *
 * Toute la carte est un lien, comme avant la refonte : un seul élément dans
 * l'arbre d'accessibilité, un seul arrêt au clavier. Le titre reste un vrai
 * <h3> à l'intérieur du lien, pour la navigation par titres.
 */
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  readingTime: number;
  cover?: string;
}

const { slug, title, description, category, pubDate, readingTime, cover } = Astro.props;

const dateLisible = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(pubDate);
const dateMachine = pubDate.toISOString().slice(0, 10);

// Point médian des libellés meta, posé à l'exécution : écrit en clair, il
// survivrait mal aux outils d'édition (voir CLAUDE.md).
const POINT = ` ${String.fromCodePoint(0x00b7)} `;
---

<article class="hrn-card">
  <a class="hrn-card__lien" href={`/blog/${slug}`}>
    <div class="hrn-card__couverture">
      <BlogCover motif={motifDe(slug, cover)} variant="card" />
    </div>

    <div class="hrn-card__corps">
      <p class="hrn-card__meta">{category}{POINT}{readingTime} min</p>
      <time class="hrn-card__date" datetime={dateMachine}>{dateLisible}</time>
      <h3 class="hrn-card__titre">{title}</h3>
      <p class="hrn-card__desc">{description}</p>
    </div>
  </a>
</article>

<style>
  .hrn-card {
    background: var(--blog-surface);
    border: 1px solid var(--blog-line);
    border-radius: 24px;
    overflow: hidden;
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-standard);
  }

  .hrn-card:hover {
    transform: translateY(-3px);
    border-color: var(--blog-text-2);
  }

  .hrn-card:focus-within {
    border-color: var(--blog-accent-soft);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blog-accent-soft) 50%, transparent);
  }

  .hrn-card__lien {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--blog-text);
    text-decoration: none;
  }

  .hrn-card__lien:focus-visible {
    outline: none;
  }

  .hrn-card__couverture {
    display: flex;
    flex: none;
    /* Le parent peut resserrer la couverture : « À lire ensuite » la pose à
       200px, la grille de la liste à 220px. */
    height: var(--hauteur-couverture, 220px);
  }

  .hrn-card__corps {
    flex-grow: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px 12px;
    padding: 24px 26px 28px;
  }

  .hrn-card__meta,
  .hrn-card__date {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hrn-card__meta {
    grid-area: 1 / 1;
    color: var(--blog-accent-soft);
  }

  .hrn-card__date {
    grid-area: 1 / 2;
    justify-self: end;
    color: var(--blog-text-2);
  }

  .hrn-card__titre {
    grid-area: 2 / 1 / auto / 3;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hrn-card__desc {
    grid-area: 3 / 1 / auto / 3;
    font-size: 16px;
    line-height: 1.55;
    color: var(--blog-text-2);
    text-wrap: pretty;
  }

  /* Sous 760px, la carte devient une ligne : vignette carrée, texte à droite,
     séparateur en bas. Le fond et les angles de la carte disparaissent, la
     liste se lit comme une liste. */
  @media (max-width: 759px) {
    .hrn-card {
      background: none;
      border: none;
      border-bottom: 1px solid var(--blog-line);
      border-radius: 0;
      overflow: visible;
    }

    .hrn-card:hover {
      transform: none;
      border-color: var(--blog-line);
    }

    .hrn-card__lien {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: 16px;
      align-items: start;
      padding: 20px 0;
    }

    .hrn-card__couverture {
      width: 96px;
      height: 96px;
      border-radius: 16px;
      overflow: hidden;
    }

    .hrn-card__corps {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 0;
    }

    .hrn-card__meta {
      font-size: 11px;
    }

    .hrn-card__titre {
      grid-area: 2 / 1;
      font-size: 20px;
      line-height: 1.12;
      letter-spacing: -0.02em;
    }

    .hrn-card__date {
      grid-area: 3 / 1;
      justify-self: start;
      font-size: 11px;
      font-weight: 400;
    }

    .hrn-card__desc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-card:hover {
      transform: none;
    }
  }
</style>
