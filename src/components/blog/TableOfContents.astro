---
/* Sommaire d'un article.
 *
 * Ne retient que les titres de niveau 2, numérotés 01, 02, 03 comme dans la
 * prose. La section en cours de lecture est repérée par un IntersectionObserver
 * posé sur les titres eux mêmes, pas sur la position de défilement : c'est ce
 * qui permet de rester juste quand une section est plus courte que l'écran.
 *
 * Le composant est posé deux fois par page (la colonne de gauche en desktop,
 * le dépliant en mobile). Le script les met toutes les deux à jour.
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  avecTitre?: boolean;
  /** Libellé affiché en tête, « Sommaire · 3 parties » par exemple. */
  titre?: string;
}

const { headings, avecTitre = true, titre = 'Sommaire' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

{items.length > 0 && (
  <nav class="hrn-toc hrn-zone-creme" aria-labelledby={avecTitre ? 'sommaire' : undefined} aria-label={avecTitre ? undefined : 'Sommaire'}>
    {avecTitre && <h2 class="hrn-toc__titre" id="sommaire">{titre}</h2>}
    <ol class="hrn-toc__liste">
      {items.map((h, i) => (
        <li>
          <a class="hrn-toc__lien" href={`#${h.slug}`} data-toc={h.slug}>
            <span class="hrn-toc__numero">{numero(i)}</span>
            <span>{h.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  /* Refonte du 22 septembre 2026 : le sommaire est posé dans une carte crème
     (la colonne de gauche en desktop, le dépliant en mobile), d'où
     .hrn-zone-creme sur la balise. Le fond est porté par le conteneur. */
  .hrn-toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hrn-toc__titre {
    margin: 0;
    max-width: none;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hrn-toc__liste {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* 44px de cible au minimum, comme toutes les cibles du site (décision du
     cahier des charges de la précédente refonte, toujours valable). */
  .hrn-toc__lien {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: 8px;
    align-items: baseline;
    min-height: 44px;
    padding: 12px 10px;
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.3;
    text-decoration: none;
    transition:
      color var(--dur) var(--ease-standard),
      background-color var(--dur) var(--ease-standard);
  }

  .hrn-toc__numero {
    font-family: var(--font-mono);
    font-size: 11px;
    /* Pas --text-muted : 3,6:1 seulement sur le crème. */
    color: var(--text-secondary);
    transition: color var(--dur) var(--ease-standard);
  }

  .hrn-toc__lien:hover,
  .hrn-toc__lien:focus-visible {
    color: var(--text-strong);
  }

  .hrn-toc__lien:focus-visible {
    outline: 2px solid var(--accent-texte);
    outline-offset: 1px;
  }

  /* Section en cours de lecture : fond crème plus soutenu, gras, numéro
     turquoise. */
  .hrn-toc__lien[aria-current='true'] {
    background: var(--surface-2);
    color: var(--text-strong);
    font-weight: 700;
  }

  /* Le brief demande #0B7D76 (--amber-600), mais sur ce fond #E7E1CE il ne
     donne que 3,8:1, sous le seuil de 4,5:1. Un cran plus foncé de la même
     rampe (--amber-700, #095F5A) passe à 5,7:1. */
  .hrn-toc__lien[aria-current='true'] .hrn-toc__numero {
    color: var(--amber-700);
  }
</style>

<script>
  let io: IntersectionObserver | undefined;
  let ac: AbortController | undefined;

  function demonterSommaire() {
    io?.disconnect();
    io = undefined;
    ac?.abort();
    ac = undefined;
  }

  function initSommaire() {
    demonterSommaire();

    const liens = [...document.querySelectorAll<HTMLAnchorElement>('.hrn-toc__lien')];
    if (liens.length === 0) return;

    const titres = [...document.querySelectorAll<HTMLElement>('.hrn-prose h2')];
    if (titres.length === 0) return;

    const marquer = (slug: string) => {
      for (const lien of liens) {
        if (lien.dataset.toc === slug) lien.setAttribute('aria-current', 'true');
        else lien.removeAttribute('aria-current');
      }
    };

    // Le titre courant est le DERNIER dont le haut est passé au dessus de la
    // ligne de référence, à 40% de la hauteur de fenêtre. L'observateur ne
    // sert qu'à savoir quand recalculer : se contenter des titres qui
    // coupent la bande laisserait le sommaire figé sur la section précédente
    // dès qu'un titre a traversé la bande sans que le suivant y soit entré.
    const choisir = () => {
      const ligne = window.innerHeight * 0.4;
      let courant = titres[0];
      for (const titre of titres) {
        if (titre.getBoundingClientRect().top <= ligne) courant = titre;
      }
      if (courant?.id) marquer(courant.id);
    };

    choisir();

    io = new IntersectionObserver(choisir, { rootMargin: '-40% 0px -55% 0px' });
    titres.forEach((t) => io?.observe(t));

    // L'observateur ne se déclenche qu'au passage d'un titre dans la bande.
    // Un saut direct, tel un clic sur une entrée du sommaire, peut n'en
    // traverser aucune : le défilement sert alors de second déclencheur.
    // Le calcul est borné au nombre de titres et passe par une image
    // d'animation, il ne coûte rien au défilement.
    ac = new AbortController();
    let attente = 0;
    window.addEventListener(
      'scroll',
      () => {
        if (attente) return;
        attente = requestAnimationFrame(() => {
          attente = 0;
          choisir();
        });
      },
      { passive: true, signal: ac.signal },
    );
  }

  document.addEventListener('astro:page-load', initSommaire);
  document.addEventListener('astro:before-swap', demonterSommaire);
</script>
