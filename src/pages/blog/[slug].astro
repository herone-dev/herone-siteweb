---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import Button from '../../components/Button.astro';
import { auteurDe } from '../../data/authors';

/* Page article, refonte du 22 septembre 2026.
 *
 * Structure conservée : fil d'Ariane, sommaire collant à gauche, prose à
 * sections numérotées, encart rendez-vous posé par le plugin, bloc auteur,
 * bandeau final, articles liés. Design : fond bleu nuit, blocs crème,
 * turquoise, Manrope. La grande bannière illustrée sous l'en-tête est retirée.
 */

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Articles liés : même catégorie d'abord, puis les plus récents.
const tous = await getCollection('blog');
const memeCategorie = tous.filter((p) => p.id !== post.id && p.data.category === post.data.category);
const autres = tous.filter((p) => p.id !== post.id && p.data.category !== post.data.category);
const lies = [...memeCategorie, ...autres]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const parties = headings.filter((h) => h.depth === 2);
const auteur = auteurDe(post.data.author);

// Caractères invisibles posés à l'exécution, jamais écrits en clair.
const INSEC = String.fromCodePoint(0x00a0);
const POINT = ` ${String.fromCodePoint(0x00b7)} `;

const LIBELLE_LECTURE = `${post.data.readingTime} min de lecture${POINT}`;
const TITRE_BANDEAU = `Ce sujet vous concerne${INSEC}?`;
const LIBELLE_SOMMAIRE = `Sommaire${POINT}${parties.length} partie${parties.length > 1 ? 's' : ''}`;
const ROLE_AUTEUR = auteur.marque === false ? auteur.role : `${auteur.role}${POINT}Hérone`;

const dateLisible = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(post.data.pubDate);
const dateMachine = post.data.pubDate.toISOString().slice(0, 10);
---

<Layout
  title={`${post.data.title} · Blog Hérone`}
  description={post.data.description}
  headerTheme="light"
>
  <div class="hrn-blog hrn-zone-bleue">
    {/* Progression de lecture, mobile seulement : sur desktop le sommaire
        collant joue déjà ce rôle. */}
    <div class="hrn-progression" aria-hidden="true">
      <span class="hrn-progression__barre" id="progression"></span>
    </div>

    <header class="hrn-article-tete">
      <div class="hrn-section-inner">
        <div class="hrn-article-tete__ligne">
          <nav aria-label="Fil d'Ariane">
            <ol class="hrn-fil">
              <li>
                <a href="/blog">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  Blog
                </a>
              </li>
              <li aria-hidden="true">/</li>
              <li>{post.data.category}</li>
            </ol>
          </nav>

          <p class="hrn-article-tete__meta">
            {LIBELLE_LECTURE}<time datetime={dateMachine}>{dateLisible}</time>
          </p>
        </div>

        <h1>{post.data.title}</h1>
        <p class="hrn-article-tete__chapeau">{post.data.description}</p>
      </div>
    </header>

    {parties.length > 0 && (
      <details class="hrn-article-sommaire-mobile hrn-zone-creme">
        <summary>
          {LIBELLE_SOMMAIRE}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <TableOfContents headings={headings} avecTitre={false} />
      </details>
    )}

    <div class="hrn-section-inner hrn-article-corps">
      <aside class="hrn-article-cote" aria-label="Sommaire et rendez-vous">
        {parties.length > 0 && (
          <div class="hrn-article-cote__sommaire">
            <TableOfContents headings={headings} titre={LIBELLE_SOMMAIRE} />
          </div>
        )}

        <div class="hrn-article-cote__carte hrn-zone-creme">
          <p class="hrn-article-cote__titre">Récupérez des heures</p>
          <p class="hrn-article-cote__phrase">Trente minutes pour voir ce qu'on peut automatiser chez vous.</p>
          <Button variant="accent" size="md" href="/#reserver" block>Réserver 30 minutes</Button>
        </div>
      </aside>

      <article class="hrn-prose">
        {post.data.summary && post.data.summary.length > 0 && (
          <aside class="hrn-enbref hrn-zone-creme" aria-label="En bref">
            <p class="hrn-enbref__libelle">En bref</p>
            <ol class="hrn-enbref__liste">
              {post.data.summary.map((phrase) => (
                <li>{phrase}</li>
              ))}
            </ol>
          </aside>
        )}

        <Content />
      </article>

      <aside class="hrn-auteur hrn-zone-creme" aria-label="Auteur">
        <div class="hrn-auteur__rond">
          {auteur.photo ? (
            <Image src={auteur.photo} alt="" width={112} height={112} />
          ) : (
            <span aria-hidden="true">H</span>
          )}
        </div>

        <div class="hrn-auteur__texte">
          <p class="hrn-auteur__nom">{auteur.nom}</p>
          <p class="hrn-auteur__role">{ROLE_AUTEUR}</p>
          <p class="hrn-auteur__phrase">{auteur.phrase}</p>
        </div>
      </aside>
    </div>

    <section class="hrn-article-final hrn-zone-creme" aria-labelledby="bandeau-titre">
      <div class="hrn-section-inner hrn-article-final__inner">
        <h2 id="bandeau-titre">{TITRE_BANDEAU}</h2>
        <div class="hrn-article-final__droite">
          <p>
            Nous regardons votre situation ensemble et nous vous disons, sans engagement,
            ce qui s'automatise chez vous et dans quel ordre.
          </p>
          <div class="hrn-article-final__actions">
            <Button variant="accent" size="lg" href="/#reserver" class="hrn-article-final__bouton">Réserver 30 minutes en visio</Button>
            <a class="hrn-article-final__tel" href="tel:+33663710598">ou 06 63 71 05 98</a>
          </div>
        </div>
      </div>
    </section>

    <section class="hrn-article-lies" aria-labelledby="ensuite">
      <div class="hrn-section-inner">
        <div class="hrn-article-lies__tete">
          <div>
            <p class="hrn-article-lies__libelle">À lire ensuite</p>
            <h2 id="ensuite">Sur le même sujet</h2>
          </div>
          <a href="/blog">
            Tous les articles
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        <div class="hrn-article-lies__grille">
          {lies.map((p) => (
            <ArticleCard
              slug={p.id}
              title={p.data.title}
              description={p.data.description}
              category={p.data.category}
              pubDate={p.data.pubDate}
              readingTime={p.data.readingTime}
              compact
            />
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Fond bleu nuit, encres claires (.hrn-zone-bleue), texte courant en
     Hanken Grotesk : l'ancienne version mettait toute la page en police de
     titre. */
  .hrn-blog {
    background: var(--paper);
    font-family: var(--font-sans);
  }

  /* ============ Progression de lecture ============ */

  .hrn-progression {
    display: none;
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    z-index: 5;
    height: 3px;
    background: var(--border);
  }

  .hrn-progression__barre {
    display: block;
    width: 0;
    height: 3px;
    background: var(--amber-300);
  }

  /* ============ En-tête ============ */

  .hrn-article-tete {
    padding-top: calc(68px + clamp(28px, 4vw, 48px));
    padding-bottom: clamp(32px, 4vw, 52px);
    border-bottom: 1px solid var(--border);
  }

  .hrn-article-tete__ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 16px;
  }

  .hrn-fil {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* 44px de cible : la hauteur est gagnée par le remplissage, la marge
     négative garde le mot aligné sur le titre. */
  .hrn-fil a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 5px;
    margin: 0 -5px;
    color: var(--amber-300);
  }

  .hrn-fil a:hover {
    color: var(--text-strong);
  }

  .hrn-article-tete__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Grand titre de page : 500 à -0.04em, comme le titre de l'accueil du blog. */
  .hrn-article-tete h1 {
    margin-top: 14px;
    max-width: 16em;
    font-family: var(--font-display);
    font-size: clamp(38px, 5.4vw, 64px);
    font-weight: var(--weight-medium);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-strong);
    text-wrap: pretty;
  }

  .hrn-article-tete__chapeau {
    margin-top: 20px !important;
    max-width: 40em;
    font-size: clamp(18px, 1.7vw, 21px);
    line-height: 1.5;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* ============ Sommaire mobile ============ */

  .hrn-article-sommaire-mobile {
    display: none;
    margin: 28px clamp(20px, 5vw, 48px) 0;
    padding: 0 16px;
    border: 1px solid var(--creme-bordure);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .hrn-article-sommaire-mobile summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hrn-article-sommaire-mobile summary svg {
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease-standard);
  }

  .hrn-article-sommaire-mobile[open] summary svg {
    transform: rotate(180deg);
  }

  .hrn-article-sommaire-mobile :global(.hrn-toc) {
    padding-bottom: 12px;
  }

  /* ============ Corps en deux colonnes ============
     Jamais le raccourci `padding` ici : cet élément porte aussi
     .hrn-section-inner, dont il écraserait les marges latérales (piège n°2). */
  .hrn-article-corps {
    display: grid;
    grid-template-columns: 280px minmax(0, 720px);
    column-gap: clamp(40px, 5vw, 72px);
    align-items: start;
    padding-top: clamp(40px, 5vw, 56px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }

  .hrn-article-cote {
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: 96px;
  }

  .hrn-article-cote__sommaire {
    padding: 18px 16px 12px;
    border: 1px solid var(--creme-bordure);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .hrn-article-cote__carte {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  .hrn-article-cote__titre {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: var(--weight-titre);
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
  }

  .hrn-article-cote__phrase {
    margin-bottom: 8px !important;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ============ Prose ============ */

  .hrn-prose {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* Les sections numérotées sont comptées par CSS : le Markdown ne produit
       aucun numéro, et les h2 gardent leur id pour les ancres du sommaire. */
    counter-reset: section;
  }

  .hrn-prose :global(p) {
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-100);
    text-wrap: pretty;
  }

  /* Premier paragraphe : chapeau de lecture, plus grand et plus clair. */
  .hrn-prose :global(> p:first-of-type) {
    font-size: 21px;
    line-height: 1.55;
    color: var(--text-strong);
  }

  .hrn-prose :global(h2) {
    counter-increment: section;
    margin: 28px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: var(--weight-titre);
    line-height: 1.15;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    scroll-margin-top: 96px;
  }

  .hrn-prose :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--amber-300);
  }

  .hrn-prose :global(h3) {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: var(--weight-titre);
    line-height: 1.25;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
  }

  .hrn-prose :global(a) {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--amber-300);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .hrn-prose :global(a:hover) {
    color: var(--amber-300);
  }

  .hrn-prose :global(strong) {
    font-weight: 700;
    color: var(--text-strong);
  }

  /* Puces rondes turquoise. Les listes numérotées gardent leur numéro, en
     mono turquoise. */
  .hrn-prose :global(ul),
  .hrn-prose :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-100);
    counter-reset: puce;
  }

  .hrn-prose :global(li) {
    position: relative;
    padding-left: 24px;
  }

  .hrn-prose :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber-300);
  }

  .hrn-prose :global(ol > li) {
    counter-increment: puce;
    padding-left: 34px;
  }

  .hrn-prose :global(ol > li::before) {
    content: counter(puce, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--amber-300);
  }

  /* Citation : trait turquoise, Manrope 700, crème, sans guillemets ajoutés
     ni point final. */
  .hrn-prose :global(blockquote) {
    margin: 12px 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--accent);
  }

  .hrn-prose :global(blockquote p) {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.3vw, 28px);
    font-weight: var(--weight-titre);
    line-height: 1.25;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  /* ============ Encart « En bref » (aucun article ne l'utilise encore) ============ */

  .hrn-enbref {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 26px;
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }

  /* Préfixées par .hrn-prose : sans cela, les règles génériques de la prose,
     plus spécifiques, écraseraient celles de l'encart (piège n°4 quater). */
  .hrn-prose .hrn-enbref__libelle {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hrn-prose .hrn-enbref__liste {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .hrn-prose .hrn-enbref__liste li::before {
    color: var(--accent-texte);
  }

  /* ============ Encart rendez-vous inséré dans la prose ============
     Posé par src/plugins/rehype-encart-rdv.mjs. Il n'a pas de balise
     Astro, d'où :global(). Couleurs du crème reprises à la main : la classe
     .hrn-zone-creme n'est pas posée par le plugin. */
  .hrn-prose :global(.hrn-article-cta) {
    margin: 12px 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: clamp(22px, 3vw, 30px) clamp(22px, 3vw, 32px);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }

  .hrn-prose :global(.hrn-article-cta__titre) {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: var(--weight-titre);
    line-height: 1.2;
    letter-spacing: var(--tracking-titre);
    color: var(--ink-950);
  }

  .hrn-prose :global(.hrn-article-cta__phrase) {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  .hrn-prose :global(.hrn-article-cta__lien) {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 24px;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--dur) var(--ease-standard);
  }

  .hrn-prose :global(.hrn-article-cta__lien:hover) {
    background: var(--accent-hover);
    color: var(--text-on-accent);
  }

  /* ============ Bloc auteur ============ */

  .hrn-auteur {
    grid-column: 2;
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border-radius: var(--radius-xl);
    background: var(--surface);
  }

  /* Rond bleu nuit, initiale turquoise quand l'auteur n'a pas de photo. */
  .hrn-auteur__rond {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--paper);
    color: var(--amber-300);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: var(--weight-titre);
  }

  .hrn-auteur__rond :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hrn-auteur__texte {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hrn-auteur__nom {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: var(--weight-titre);
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
  }

  .hrn-auteur__role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hrn-auteur__phrase {
    margin-top: 4px !important;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ============ Bandeau final crème ============ */

  .hrn-article-final {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(40px, 5vw, 64px);
    background: var(--surface);
  }

  .hrn-article-final__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 20px;
    align-items: center;
  }

  .hrn-article-final h2 {
    margin: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: var(--weight-titre);
    line-height: 1.05;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-article-final__droite {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hrn-article-final__droite p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-article-final__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .hrn-article-final__tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
  }

