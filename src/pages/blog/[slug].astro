<script>
  // Barre de progression de lecture, mobile seulement. Elle mesure la
  // position du lecteur dans la prose : 0 % en haut de l'article, 100 % à la
  // fin du texte, et non sur la hauteur totale de la page, qui inclut le
  // bandeau final et les articles liés.
  let ac: AbortController | undefined;

  function demonterProgression() {
    ac?.abort();
    ac = undefined;
  }

  function initProgression() {
    demonterProgression();
    ac = new AbortController();

    const barre = document.querySelector<HTMLElement>('#progression');
    const prose = document.querySelector<HTMLElement>('.hrn-prose');
    if (!barre || !prose) return;

    const mesurer = () => {
      const haut = prose.offsetTop;
      const course = prose.offsetHeight - window.innerHeight * 0.5;
      const avance = window.scrollY - haut;
      const part = course > 0 ? Math.min(1, Math.max(0, avance / course)) : 0;
      barre.style.width = `${part * 100}%`;
    };

    mesurer();
    window.addEventListener('scroll', mesurer, { passive: true, signal: ac.signal });

    // Sur mobile, l'apparition de la barre d'adresse émet un resize alors que
    // seule la HAUTEUR change : on ne remesure que sur un vrai changement de
    // largeur, sinon la barre saute à chaque défilement.
    let derniereLargeur = window.innerWidth;
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth === derniereLargeur) return;
        derniereLargeur = window.innerWidth;
        mesurer();
      },
      { signal: ac.signal },
    );
  }

  document.addEventListener('astro:page-load', initProgression);
  document.addEventListener('astro:before-swap', demonterProgression);
</script>
