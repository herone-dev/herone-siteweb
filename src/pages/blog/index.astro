---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import BlogCover from '../../components/blog/BlogCover.astro';
import { motifDe } from '../../data/blog-covers';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// L'article à la une est le plus récent ; les autres alimentent la grille.
const une = posts[0];
const suite = posts.slice(1);

// Les filtres sont dérivés des articles réellement publiés : aucune catégorie
// vide ne peut apparaître dans la barre. Le compteur est sur deux chiffres,
// comme dans la maquette.
const categories = [
  { nom: 'Tout', nombre: posts.length },
  ...[...new Set(posts.map((p) => p.data.category))]
    .sort((a, b) => a.localeCompare(b, 'fr'))
    .map((nom) => ({ nom, nombre: posts.filter((p) => p.data.category === nom).length })),
];
const deuxChiffres = (n: number) => String(n).padStart(2, '0');

// Caractères invisibles posés à l'exécution plutôt qu'écrits en clair : les
// outils d'édition les transforment en espaces ordinaires sans prévenir.
const INSEC = String.fromCodePoint(0x00a0);
const POINT = ` ${String.fromCodePoint(0x00b7)} `;

const LIBELLE_HERO = `Le blog Hérone${POINT}${posts.length} article${posts.length > 1 ? 's' : ''}`;
const LIBELLE_TRI = `Tri${INSEC}: du plus récent`;
const TITRE_APPEL = `Un de ces cas ressemble au vôtre${INSEC}?`;

const dateLisible = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---

<Layout
  title="Blog Hérone · Automatiser, concrètement."
  description="Des cas réels, des méthodes, des systèmes qui font gagner des heures aux TPE et PME de Vendée."
  headerTheme="dark"
>
  <div class="hrn-blog">
    <section class="hrn-blog-hero">
      <div class="hrn-blog-hero__soleil" aria-hidden="true">
        <svg viewBox="0 0 400 200" aria-hidden="true" focusable="false">
          <path d="M0 200A200 200 0 0 1 400 200Z" fill="var(--blog-accent)" />
          <rect x="0" y="112" width="400" height="8" fill="var(--blog-bg)" />
          <rect x="0" y="140" width="400" height="12" fill="var(--blog-bg)" />
          <rect x="0" y="170" width="400" height="16" fill="var(--blog-bg)" />
        </svg>
      </div>

      <div class="hrn-section-inner hrn-blog-hero__contenu">
        <p class="hrn-blog-hero__libelle">{LIBELLE_HERO}</p>
        <h1>Automatiser,<br /><span>concrètement.</span></h1>
        <p class="hrn-blog-hero__chapeau">
          Des cas réels, des méthodes, des systèmes qui font gagner des heures aux TPE et PME.
        </p>
      </div>
    </section>

    <div class="hrn-blog-filtres">
      <div class="hrn-section-inner hrn-blog-filtres__inner">
        <div class="hrn-blog-filtres__groupe" role="group" aria-label="Filtrer par thème">
          {categories.map((cat, i) => (
            <button
              type="button"
              class="hrn-blog-filtre"
              data-category={cat.nom}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {cat.nom}
              <span class="hrn-blog-filtre__compteur">{deuxChiffres(cat.nombre)}</span>
            </button>
          ))}
        </div>

        {/* Indication de tri, volontairement non interactive : il n'y a qu'un
            ordre de tri, un bouton qui n'ouvrirait aucun menu serait un arrêt
            mort au clavier. */}
        <p class="hrn-blog-tri">
          {LIBELLE_TRI}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </p>
      </div>
    </div>

    {une && (
      <section class="hrn-blog-une" aria-label="À la une">
        <div class="hrn-section-inner">
          <article class="hrn-une" data-category={une.data.category} data-une>
            <a class="hrn-une__lien" href={`/blog/${une.id}`}>
              <div class="hrn-une__couverture">
                <BlogCover motif={motifDe(une.id, une.data.cover)} variant="card" />
                <span class="hrn-une__pastille">À la une</span>
              </div>

              <div class="hrn-une__corps">
                <p class="hrn-une__meta">
                  <span>{une.data.category}{POINT}{une.data.readingTime} min</span>
                  <time datetime={une.data.pubDate.toISOString().slice(0, 10)}>
                    {dateLisible(une.data.pubDate)}
                  </time>
                </p>
                <h2 class="hrn-une__titre">{une.data.title}</h2>
                <p class="hrn-une__chapeau">{une.data.description}</p>
                <div class="hrn-une__lire">
                  Lire l'article
                  <span class="hrn-une__rond">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </article>
        </div>
      </section>
    )}

    <section class="hrn-blog-tous" aria-labelledby="tous">
      <div class="hrn-section-inner">
        <div class="hrn-blog-tous__tete">
          <h2 id="tous">Tous les articles</h2>
          <p>Du plus récent au plus ancien</p>
        </div>

        <div class="hrn-blog-grille">
          {suite.map((post) => (
            <div class="hrn-blog-grille__item" data-category={post.data.category}>
              <ArticleCard
                slug={post.id}
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                pubDate={post.data.pubDate}
                readingTime={post.data.readingTime}
                cover={post.data.cover}
              />
            </div>
          ))}

          <div class="hrn-blog-vide" id="blog-vide" hidden>
            <p><strong>Aucun article pour ce thème.</strong></p>
            <p>Choisissez un autre thème, ou revenez à tous les articles.</p>
            <button type="button" id="blog-reset">Voir tous les articles</button>
          </div>

          {/* Toujours visible, même quand le filtre ne laisse aucun article. */}
          <aside class="hrn-blog-appel" aria-label="Réserver un appel">
            <svg class="hrn-blog-appel__cercles" width="300" height="300" viewBox="0 0 300 300" aria-hidden="true" focusable="false">
              <circle cx="300" cy="300" r="60" fill="none" stroke="var(--blog-bg)" stroke-width="4" opacity="0.18" />
              <circle cx="300" cy="300" r="110" fill="none" stroke="var(--blog-bg)" stroke-width="4" opacity="0.18" />
              <circle cx="300" cy="300" r="160" fill="none" stroke="var(--blog-bg)" stroke-width="4" opacity="0.18" />
              <circle cx="300" cy="300" r="210" fill="none" stroke="var(--blog-bg)" stroke-width="4" opacity="0.18" />
            </svg>

            <p class="hrn-blog-appel__libelle">Réserver un appel</p>
            <h2 class="hrn-blog-appel__titre">{TITRE_APPEL}</h2>
            <p class="hrn-blog-appel__phrase">
              Trente minutes pour repérer, chez vous, ce qu'on peut automatiser.
            </p>

            <div class="hrn-blog-appel__bas">
              <a class="hrn-blog-appel__bouton" href="/#reserver">
                Réserver 30 minutes
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="hrn-blog-appel__tel" href="tel:+33663710598">ou 06 63 71 05 98</a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Le blog passe entièrement sur fond sombre, avec sa palette propre. */
  .hrn-blog {
    background: var(--blog-bg);
    color: var(--blog-text);
    font-family: var(--font-display);
  }

  /* ============ Hero ============ */

  .hrn-blog-hero {
    position: relative;
    /* 68px pour le header fixe, puis les 72px de la maquette. La zone visible
       sous le header mesure donc bien 560px. */
    min-height: calc(560px + 68px);
    padding-top: calc(68px + 72px);
    padding-bottom: 40px;
    overflow: hidden;
    border-bottom: 1px solid var(--blog-line);
  }

  /* Le décor vient en premier dans le DOM et le contenu porte position:
     relative : il passe donc devant sans qu'aucun z-index soit nécessaire.
     Déplacer le soleil après le texte le ferait passer par dessus le titre. */
  .hrn-blog-hero__soleil {
    position: absolute;
    right: 60px;
    bottom: 0;
    display: flex;
    /* 340px à 1280px comme la maquette desktop, 260px en petit écran comme la
       maquette mobile, sans palier visible entre les deux. */
    width: clamp(260px, 26.6vw, 340px);
  }

  .hrn-blog-hero__soleil svg {
    width: 100%;
    height: auto;
  }

  .hrn-blog-hero__contenu {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }

  .hrn-blog-hero__libelle {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* La maquette pose ici l'orange vif. Le cahier des charges interdit
       --blog-accent sous 24px et réserve les petits libellés mono à
       --blog-accent-soft : c'est la règle qui l'emporte, et cela aligne ce
       libellé sur tous les autres libellés mono de la page. */
    color: var(--blog-accent-soft);
  }

  .hrn-blog-hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(50px, 11vw, 144px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--blog-text);
  }

  .hrn-blog-hero h1 span {
    color: var(--blog-accent);
  }

  .hrn-blog-hero__chapeau {
    margin-top: 8px;
    max-width: 540px;
    font-size: 22px;
    line-height: 1.45;
    color: var(--blog-text-2);
    text-wrap: pretty;
  }

  /* ============ Barre de filtres ============ */

  .hrn-blog-filtres {
    position: sticky;
    top: 68px;
    z-index: 5;
    background: var(--blog-bg);
  }

  .hrn-blog-filtres__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .hrn-blog-filtres__groupe {
    display: flex;
    gap: 10px;
    /* Le nombre de thèmes suit les articles publiés : le groupe se resserre et
       défile plutôt que de passer sous le libellé de tri, qui est à sa droite. */
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hrn-blog-filtres__groupe::-webkit-scrollbar {
    display: none;
  }

  .hrn-blog-filtre {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--blog-line);
    background: transparent;
    color: var(--blog-text);
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-blog-filtre:hover {
    border-color: var(--blog-text-2);
  }

  .hrn-blog-filtre:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blog-accent-soft) 50%, transparent);
  }

  .hrn-blog-filtre[aria-pressed='true'] {
    background: var(--blog-accent);
    border-color: var(--blog-accent);
    color: var(--blog-on-accent);
    font-weight: 700;
  }

  /* Le compteur n'a pas de graisse propre : il suit celle de la pastille,
     500 au repos et 700 quand elle est active. */
  .hrn-blog-filtre__compteur {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--blog-text-2);
  }

  .hrn-blog-filtre[aria-pressed='true'] .hrn-blog-filtre__compteur {
    color: var(--blog-on-accent);
  }

  .hrn-blog-tri {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--blog-line);
    border-radius: 999px;
    background: var(--blog-surface);
    color: var(--blog-text);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ============ Article à la une ============ */

  .hrn-blog-une {
    padding-top: 8px;
  }

  .hrn-une {
    overflow: hidden;
    border: 1px solid var(--blog-line);
    border-radius: 28px;
    background: var(--blog-surface);
    transition: border-color var(--dur) var(--ease-standard);
  }

  .hrn-une:hover {
    border-color: var(--blog-text-2);
  }

  .hrn-une:focus-within {
    border-color: var(--blog-accent-soft);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blog-accent-soft) 50%, transparent);
  }

  .hrn-une__lien {
    display: grid;
    /* Hauteur de la maquette, en plancher : un titre plus long que celui de la
       maquette allonge la carte, et la couverture s'étire avec elle plutôt que
       de laisser un fond nu sous elle. */
    min-height: 520px;
    /* Sans gouttière : la couverture colle au bord gauche de la carte et la
       colonne de texte démarre exactement aux sept douzièmes. */
    grid-template-columns: repeat(12, minmax(0, 1fr));
    color: var(--blog-text);
    text-decoration: none;
  }

  .hrn-une__lien:focus-visible {
    outline: none;
  }

  .hrn-une__couverture {
    position: relative;
    grid-column: span 7;
    display: flex;
    min-height: 0;
  }

  .hrn-une__pastille {
    position: absolute;
    left: 22px;
    top: 22px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--blog-bg);
    color: var(--blog-text);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hrn-une__corps {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 48px 48px 48px 44px;
  }

  .hrn-une__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blog-accent-soft);
  }

  .hrn-une__meta time {
    color: var(--blog-text-2);
  }

  /* La règle « section h2 » de global.css impose ici une couleur sombre et une
     mesure de 20ch : on les recouvre, le titre de la une occupe sa colonne. */
  .hrn-une__titre {
    margin: 0;
    max-width: none;
    color: var(--blog-text);
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hrn-une__chapeau {
    font-size: 18px;
    line-height: 1.55;
    color: var(--blog-text-2);
    text-wrap: pretty;
  }

  .hrn-une__lire {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 16px;
    font-weight: 700;
  }

  .hrn-une__rond {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--blog-accent);
    color: var(--blog-on-accent);
    transition: transform var(--dur) var(--ease-out);
  }

  .hrn-une__lien:hover .hrn-une__rond {
    transform: translateX(4px);
  }

  /* ============ Tous les articles ============ */

  .hrn-blog-tous {
    padding-top: 96px;
    padding-bottom: 120px;
  }

  .hrn-blog-tous__tete {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  /* La règle de global.css vise « section h2 » : on la recouvre ici pour
     retrouver le titre de section de la maquette. */
  .hrn-blog-tous__tete h2 {
    margin: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: 64px;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--blog-text);
  }

  .hrn-blog-tous__tete p {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blog-text-2);
  }

  .hrn-blog-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hrn-blog-grille__item {
    display: flex;
  }

  /* Un `display` posé par une règle d'auteur l'emporte sur l'attribut hidden,
     qui n'est traité que par la feuille du navigateur : sans cette ligne, le
     filtre masque les articles dans le DOM sans rien changer à l'écran. */
  .hrn-blog-grille__item[hidden] {
    display: none;
  }

  .hrn-blog-grille__item > :global(*) {
    width: 100%;
  }

  .hrn-blog-vide {
    grid-column: 1 / -1;
    padding: 48px 24px;
    text-align: center;
    border: 1px dashed var(--blog-line);
    border-radius: 24px;
    background: var(--blog-surface);
    color: var(--blog-text-2);
  }

  .hrn-blog-vide strong {
    color: var(--blog-text);
  }

  .hrn-blog-vide button {
    margin-top: 14px;
    height: 48px;
    padding: 0 22px;
    border: none;
    border-radius: 999px;
    background: var(--blog-accent);
    color: var(--blog-on-accent);
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--dur) var(--ease-standard);
  }

  .hrn-blog-vide button:hover {
    background: var(--blog-accent-hover);
  }

  /* ============ Carte d'appel à l'action ============ */

  .hrn-blog-appel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px 32px 22px;
    border-radius: 24px;
    background: var(--blog-accent);
    color: var(--blog-on-accent);
  }

  .hrn-blog-appel__cercles {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .hrn-blog-appel__libelle,
  .hrn-blog-appel__titre,
  .hrn-blog-appel__phrase,
  .hrn-blog-appel__bas {
    position: relative;
  }

  .hrn-blog-appel__libelle {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hrn-blog-appel__titre {
    margin: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--blog-on-accent);
  }

  .hrn-blog-appel__phrase {
    font-size: 17px;
    line-height: 1.5;
  }

  .hrn-blog-appel__bas {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hrn-blog-appel__bouton {
    align-self: flex-start;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--blog-bg);
    color: var(--blog-text);
    font-size: 16px;
    font-weight: 700;
    white-space: nowrap;
    transition: background var(--dur) var(--ease-standard);
  }

  .hrn-blog-appel__bouton:hover {
    background: var(--blog-surface-2);
    color: var(--blog-text);
  }

  .hrn-blog-appel__tel {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--blog-on-accent);
  }

  .hrn-blog-appel__tel:hover {
    color: var(--blog-on-accent);
  }

  /* ============ Réactivité ============ */

  @media (max-width: 1099px) {
    .hrn-blog-grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Indication seulement décorative : elle cède la place aux thèmes. */
    .hrn-blog-tri {
      display: none;
    }

    .hrn-une__lien {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .hrn-une__couverture,
    .hrn-une__corps {
      grid-column: auto;
    }

    .hrn-une__couverture {
      height: 220px;
      align-self: start;
    }

    .hrn-une__corps {
      padding: 22px 22px 18px;
    }
  }

  @media (max-width: 759px) {
    .hrn-blog-hero {
      min-height: calc(450px + 68px);
      padding-top: calc(68px + 40px);
      padding-bottom: 28px;
    }

    .hrn-blog-hero__soleil {
      right: -30px;
      width: 260px;
    }

    .hrn-blog-hero__contenu {
      gap: 18px;
    }

    .hrn-blog-hero__libelle {
      font-size: 12px;
    }

    .hrn-blog-hero h1 {
      line-height: 0.92;
      letter-spacing: -0.045em;
    }

    .hrn-blog-hero__chapeau {
      font-size: 18px;
      line-height: 1.5;
    }

    /* Les pastilles défilent horizontalement, sans barre visible, et le
       libellé de tri disparaît. */
    .hrn-blog-filtres__inner {
      padding-top: 18px;
      padding-bottom: 18px;
    }

    .hrn-blog-filtres__groupe {
      gap: 8px;
      /* La gouttière de .hrn-section-inner est annulée puis rendue au contenu :
         la dernière pastille peut ainsi défiler jusqu'au bord de l'écran. */
      margin: 0 calc(-1 * clamp(20px, 5vw, 48px));
      padding: 0 clamp(20px, 5vw, 48px);
    }

    .hrn-blog-une {
      padding-top: 4px;
    }

    .hrn-une__titre {
      font-size: 32px;
    }

    .hrn-une__chapeau {
      font-size: 16px;
    }

    .hrn-une__pastille {
      font-size: 11px;
    }

    .hrn-blog-tous {
      padding-top: 52px;
      padding-bottom: 72px;
    }

    .hrn-blog-tous__tete {
      display: block;
      margin-bottom: 6px;
    }

    .hrn-blog-tous__tete h2 {
      font-size: 40px;
    }

    .hrn-blog-tous__tete p {
      display: none;
    }

    /* Les cartes deviennent des lignes (voir ArticleCard), la carte orange
       vient après la liste. */
    .hrn-blog-grille {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .hrn-blog-appel {
      margin-top: 28px;
      padding: 28px 24px 20px;
    }

    .hrn-blog-appel__titre {
      font-size: 38px;
    }

    .hrn-blog-appel__bouton {
      align-self: stretch;
    }

    .hrn-blog-vide {
      margin: 24px 0;
    }
  }

  /* Sous 360px, « concrètement. » ne tient pas sur une ligne à 50px : le mot
     mesure environ 6,4 fois la taille de police et la gouttière laisse
     (100vw - 40px). Le titre suit donc la largeur disponible plutôt que d'être
     rogné par l'overflow du hero. À revoir si ce mot change. */
  @media (max-width: 359px) {
    .hrn-blog-hero h1 {
      font-size: calc((100vw - 40px) / 6.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-une__lien:hover .hrn-une__rond {
      transform: none;
    }
  }
</style>

<script>
  // Filtrage par thème. Le champ de recherche a disparu avec la refonte :
  // six articles, les pastilles suffisent.
  let ac: AbortController | undefined;

  function initListeBlog() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const filtres = [...document.querySelectorAll<HTMLButtonElement>('.hrn-blog-filtre')];
    const items = [...document.querySelectorAll<HTMLElement>('.hrn-blog-grille__item')];
    const une = document.querySelector<HTMLElement>('[data-une]');
    const vide = document.querySelector<HTMLElement>('#blog-vide');
    const reprise = document.querySelector<HTMLButtonElement>('#blog-reset');
    if (filtres.length === 0 || !vide) return;

    let theme = 'Tout';

    const appliquer = () => {
      let visibles = 0;

      for (const item of items) {
        const garde = theme === 'Tout' || item.dataset.category === theme;
        item.hidden = !garde;
        if (garde) visibles++;
      }

      // L'article à la une suit le filtre lui aussi. Quand il disparaît,
      // aucun article ne prend sa place : la grille suffit.
      if (une) {
        const gardeUne = theme === 'Tout' || une.dataset.category === theme;
        const section = une.closest('section');
        if (section) section.hidden = !gardeUne;
        if (gardeUne) visibles++;
      }

      // La carte d'appel à l'action reste visible en toutes circonstances.
      vide.hidden = visibles > 0;
    };

    filtres.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          theme = btn.dataset.category ?? 'Tout';
          filtres.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          appliquer();
        },
        { signal },
      );
    });

    reprise?.addEventListener(
      'click',
      () => {
        theme = 'Tout';
        filtres.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.category === 'Tout')));
        appliquer();
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', initListeBlog);
  document.addEventListener('astro:before-swap', () => ac?.abort());
</script>
