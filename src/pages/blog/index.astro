---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import Button from '../../components/Button.astro';
import { pointDe } from '../../data/blog-categories';

/* Accueil du blog, refonte du 22 septembre 2026.
 *
 * Structure conservée de la version « Plein soleil » (filtres, article à la
 * une, grille, encart d'appel). Design repris de la maquette
 * « Maquette site Hérone/Blog Hérone.dc.html » (bandeau en haut, cartes
 * sobres, champ de recherche), avec l'identité actuelle du site : fond bleu
 * nuit, blocs crème, turquoise, Manrope. La palette prune et orange propre au
 * blog n'est plus utilisée, ni les illustrations de BlogCover.
 */

// Les brouillons (draft: true) sont retirés ici, une fois pour toutes : le
// compteur du hero, les compteurs de la barre de filtres, l'article à la une
// et la grille se calculent tous sur `posts`.
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// L'article à la une est le plus récent ; les autres alimentent la grille.
const une = posts[0];
const suite = posts.slice(1);

// Les filtres sont dérivés des articles réellement publiés : aucune catégorie
// vide ne peut apparaître dans la barre. Compteur sur deux chiffres.
const categories = [
  { nom: 'Tout', nombre: posts.length },
  ...[...new Set(posts.map((p) => p.data.category))]
    .sort((a, b) => a.localeCompare(b, 'fr'))
    .map((nom) => ({ nom, nombre: posts.filter((p) => p.data.category === nom).length })),
];
const deuxChiffres = (n: number) => String(n).padStart(2, '0');

// Caractères invisibles posés à l'exécution plutôt qu'écrits en clair : les
// outils d'édition les transforment en espaces ordinaires sans prévenir.
const INSEC = String.fromCodePoint(0x00a0);
const POINT = ` ${String.fromCodePoint(0x00b7)} `;

const LIBELLE_HERO = `Le blog Hérone${POINT}${posts.length} article${posts.length > 1 ? 's' : ''}`;
const LIBELLE_TRI = `Tri${POINT}du plus récent`;
const TITRE_APPEL = `Un de ces cas ressemble au vôtre${INSEC}?`;

const dateLisible = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---

<Layout
  title="Blog Hérone · Automatiser, concrètement"
  description="Des cas réels, des méthodes, des systèmes qui font gagner des heures aux TPE et PME de Vendée."
  headerTheme="light"
>
  <div class="hrn-blog hrn-zone-bleue">
    <section class="hrn-blog-hero hrn-zone-creme">
      <div class="hrn-section-inner hrn-blog-hero__contenu">
        <p class="hrn-blog-hero__libelle">{LIBELLE_HERO}</p>
        <h1>Automatiser,<br />concrètement</h1>
        <p class="hrn-blog-hero__chapeau">
          Des cas réels, des méthodes, des systèmes qui font gagner des heures aux TPE et PME.
          Cherchez un sujet ou parcourez par thème.
        </p>

        <div class="hrn-blog-recherche" role="search">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7.5" stroke="currentColor" stroke-width="1.75" />
            <path d="m21 21-4.3-4.3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
          <input
            id="blog-recherche"
            type="search"
            placeholder="Rechercher un sujet, un outil, un métier…"
            aria-label="Rechercher un article par son titre"
            autocomplete="off"
            enterkeyhint="search"
          />
        </div>
      </div>
    </section>

    <div class="hrn-blog-filtres">
      <div class="hrn-section-inner hrn-blog-filtres__inner">
        <div class="hrn-blog-filtres__groupe" role="group" aria-label="Filtrer par thème">
          {categories.map((cat, i) => (
            <button
              type="button"
              class="hrn-blog-filtre"
              data-category={cat.nom}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {cat.nom}
              <span class="hrn-blog-filtre__compteur">{deuxChiffres(cat.nombre)}</span>
            </button>
          ))}
        </div>

        {/* Indication de tri, volontairement non interactive : il n'y a qu'un
            ordre de tri, un bouton qui n'ouvrirait aucun menu serait un arrêt
            mort au clavier. */}
        <p class="hrn-blog-tri">{LIBELLE_TRI}</p>
      </div>
    </div>

    {une && (
      <section class="hrn-blog-une" aria-label="À la une">
        <div class="hrn-section-inner">
          <article class="hrn-une hrn-zone-creme" data-category={une.data.category} data-titre={une.data.title} data-une>
            <a class="hrn-une__lien" href={`/blog/${une.id}`}>
              <div class="hrn-une__gauche">
                <p class="hrn-une__meta">
                  <span class="hrn-une__badge">À la une</span>
                  <span class="hrn-une__point" style={`--point: ${pointDe(une.data.category)}`} aria-hidden="true"></span>
                  <span class="hrn-une__cat">{une.data.category}</span>
                  <span>
                    {POINT}{une.data.readingTime} min{POINT}
                    <time datetime={une.data.pubDate.toISOString().slice(0, 10)}>{dateLisible(une.data.pubDate)}</time>
                  </span>
                </p>
                <h2 class="hrn-une__titre">{une.data.title}</h2>
              </div>

              <div class="hrn-une__droite">
                <p class="hrn-une__chapeau">{une.data.description}</p>
                <span class="hrn-une__lire">
                  Lire l'article
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        </div>
      </section>
    )}

    <section class="hrn-blog-tous" aria-labelledby="tous">
      <div class="hrn-section-inner">
        <div class="hrn-blog-tous__tete">
          <h2 id="tous">Tous les articles</h2>
          <p>Du plus récent au plus ancien</p>
        </div>

        <div class="hrn-blog-grille">
          {suite.map((post) => (
            <div class="hrn-blog-grille__item" data-category={post.data.category} data-titre={post.data.title}>
              <ArticleCard
                slug={post.id}
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                pubDate={post.data.pubDate}
                readingTime={post.data.readingTime}
              />
            </div>
          ))}

          <div class="hrn-blog-vide" id="blog-vide" hidden>
            <p class="hrn-blog-vide__titre" id="blog-vide-titre">Aucun article pour ce thème</p>
            <p>Essayez un autre mot, choisissez un autre thème, ou revenez à tous les articles.</p>
            <button type="button" class="hrn-blog-vide__bouton" id="blog-reset">Voir tous les articles</button>
          </div>
        </div>

        {/* Toujours visible, même quand le filtre ne laisse aucun article. */}
        <aside class="hrn-blog-appel hrn-zone-creme" aria-labelledby="appel-titre">
          <div class="hrn-blog-appel__texte">
            <p class="hrn-blog-appel__libelle">Réserver un appel</p>
            <h2 class="hrn-blog-appel__titre" id="appel-titre">{TITRE_APPEL}</h2>
            <p class="hrn-blog-appel__phrase">
              Trente minutes pour repérer, chez vous, ce que nous pouvons automatiser. Ou appelez le
              <a class="hrn-blog-appel__tel" href="tel:+33663710598">06 63 71 05 98</a>
            </p>
          </div>
          <Button variant="accent" size="lg" href="/#reserver" class="hrn-blog-appel__bouton">Réserver 30 minutes</Button>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Fond bleu nuit et encres claires (.hrn-zone-bleue), texte courant en
     Hanken Grotesk : l'ancienne version mettait toute la page en police de
     titre. */
  .hrn-blog {
    background: var(--paper);
    font-family: var(--font-sans);
  }

  /* ============ Bandeau du haut ============
     Il démarre SOUS l'en-tête fixe, et non derrière : l'en-tête garde ainsi
     son bleu nuit au lieu de prendre une teinte grise sur le crème. */
  .hrn-blog-hero {
    position: relative;
    margin-top: 68px;
    padding-top: clamp(44px, 6vw, 72px);
    padding-bottom: clamp(36px, 4vw, 48px);
    background-color: var(--surface);
    /* Trame de points discrète : 1px d'encre à 8 %, tous les 26px. */
    background-image: radial-gradient(color-mix(in srgb, var(--ink-950) 8%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    background-position: -13px -13px;
  }

  .hrn-blog-hero__contenu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hrn-blog-hero__libelle {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  /* Seul titre de la page en 500 : les grands titres de page du blog sont
     plus fins, à -0.04em. */
  .hrn-blog-hero h1 {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: var(--weight-medium);
    font-size: clamp(40px, 5.4vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--text-strong);
  }

  .hrn-blog-hero__chapeau {
    margin-top: 20px !important;
    max-width: 620px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-blog-recherche {
    margin-top: 32px;
    width: min(520px, 100%);
    height: 50px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    border: 1px solid var(--creme-bordure);
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--text-secondary);
    transition: border-color var(--dur) var(--ease-standard), box-shadow var(--dur) var(--ease-standard);
  }

  .hrn-blog-recherche:focus-within {
    border-color: var(--accent-texte);
    box-shadow: var(--focus-ring-accent);
  }

  .hrn-blog-recherche svg {
    flex: none;
  }

  /* 16px au moins : en dessous, Safari sur iPhone zoome la page au toucher. */
  .hrn-blog-recherche input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-strong);
  }

  .hrn-blog-recherche input::placeholder {
    color: var(--text-secondary);
  }

  /* ============ Barre de filtres ============ */

  .hrn-blog-filtres {
    position: sticky;
    top: 68px;
    z-index: 5;
    background: var(--paper);
  }

  .hrn-blog-filtres__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .hrn-blog-filtres__groupe {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hrn-blog-filtres__groupe::-webkit-scrollbar {
    display: none;
  }

  .hrn-blog-filtre {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-standard),
      background-color var(--dur) var(--ease-standard);
  }

  .hrn-blog-filtre:hover {
    border-color: var(--border-strong);
  }

  .hrn-blog-filtre:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--amber-300);
  }

  .hrn-blog-filtre[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-on-accent);
  }

  .hrn-blog-filtre__compteur {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .hrn-blog-filtre[aria-pressed='true'] .hrn-blog-filtre__compteur {
    color: var(--text-on-accent);
  }

  .hrn-blog-tri {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ============ Article à la une ============ */

  .hrn-blog-une {
    padding-top: 8px;
  }

  .hrn-une {
    background: var(--surface);
    border: 1px solid var(--creme-bordure);
    border-radius: var(--radius-xl);
    transition: transform var(--dur) var(--ease-out);
  }

  .hrn-une:hover {
    transform: translateY(-2px);
  }

  .hrn-une:focus-within {
    box-shadow: 0 0 0 3px var(--amber-300);
  }

  .hrn-une__lien {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(32px, 5vw, 64px);
    row-gap: 18px;
    padding: clamp(24px, 3.4vw, 42px);
    color: var(--text-strong);
    text-decoration: none;
  }

  .hrn-une__lien:focus-visible {
    outline: none;
  }

  .hrn-une__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 8px;
    row-gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  /* Petit élément bleu nuit sur le crème, texte turquoise clair. */
  .hrn-une__badge {
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: var(--paper);
    color: var(--amber-300);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hrn-une__point {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--point);
  }

  .hrn-une__cat {
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-600);
  }

  /* La règle « section h2 » de global.css impose une mesure de 20ch et une
     marge : on les reprend ici. */
  .hrn-une__titre {
    margin: 22px 0 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.9vw, 38px);
    font-weight: var(--weight-titre);
    line-height: 1.1;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-une__droite {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .hrn-une__chapeau {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-une__lire {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-texte);
  }

  .hrn-une__lire svg {
    transition: transform var(--dur-fast) var(--ease-standard);
  }

  .hrn-une:hover .hrn-une__lire svg {
    transform: translateX(3px);
  }

  /* ============ Tous les articles ============ */

  .hrn-blog-tous {
    padding-top: clamp(56px, 7vw, 80px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }

  .hrn-blog-tous__tete {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .hrn-blog-tous__tete h2 {
    margin: 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 40px);
    font-weight: var(--weight-titre);
    line-height: 1.05;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
  }

  .hrn-blog-tous__tete p {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hrn-blog-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .hrn-blog-grille__item {
    display: flex;
  }

  /* Un `display` posé par une règle d'auteur l'emporte sur l'attribut hidden,
     qui n'est traité que par la feuille du navigateur : sans cette ligne, le
     filtre masque les articles dans le DOM sans rien changer à l'écran
     (piège n°4 ter). */
  .hrn-blog-grille__item[hidden],
  .hrn-blog-une[hidden] {
    display: none;
  }

  .hrn-blog-grille__item > :global(*) {
    width: 100%;
  }

  .hrn-blog-vide {
    grid-column: 1 / -1;
    padding: 44px 24px;
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xl);
    color: var(--text-secondary);
  }

  .hrn-blog-vide[hidden] {
    display: none;
  }

  .hrn-blog-vide__titre {
    margin-bottom: 6px !important;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: var(--weight-titre);
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
  }

  .hrn-blog-vide__bouton {
    margin-top: 18px;
    height: 48px;
    padding: 0 24px;
    border: none;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur) var(--ease-standard);
  }

  .hrn-blog-vide__bouton:hover {
    background: var(--accent-hover);
  }

  /* ============ Encart d'appel ============ */

  .hrn-blog-appel {
    margin-top: clamp(40px, 5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(26px, 3.4vw, 44px);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }

  .hrn-blog-appel__libelle {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-texte);
  }

  .hrn-blog-appel__titre {
    margin: 10px 0 0;
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 32px);
    font-weight: var(--weight-titre);
    line-height: 1.1;
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-blog-appel__phrase {
    margin-top: 10px !important;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-blog-appel__tel {
    font-family: var(--font-mono);
    color: var(--text-strong);
    white-space: nowrap;
  }

  .hrn-blog-appel__tel:hover {
    color: var(--accent-texte);
  }

  .hrn-blog-appel :global(.hrn-blog-appel__bouton) {
    flex-shrink: 0;
  }

  /* ============ Réactivité ============ */

  @media (max-width: 1023px) {
    .hrn-blog-grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 759px) {
    /* Les pastilles défilent horizontalement, sans barre visible, et le
       libellé de tri disparaît. La gouttière est annulée puis rendue au
       contenu : la dernière pastille défile jusqu'au bord de l'écran. */
    .hrn-blog-tri {
      display: none;
    }

    .hrn-blog-filtres__inner {
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .hrn-blog-filtres__groupe {
      margin: 0 calc(-1 * clamp(20px, 5vw, 48px));
      padding: 0 clamp(20px, 5vw, 48px);
    }

    .hrn-une__lien {
      grid-template-columns: minmax(0, 1fr);
    }

    .hrn-une__titre {
      margin-top: 16px;
    }

    .hrn-une__chapeau {
      font-size: 16px;
    }

    .hrn-blog-tous__tete p {
      display: none;
    }

    .hrn-blog-grille {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .hrn-blog-appel {
      flex-direction: column;
      align-items: stretch;
    }

    .hrn-blog-appel :global(.hrn-blog-appel__bouton) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrn-une,
    .hrn-une__lire svg {
      transition: none;
    }

    .hrn-une:hover,
    .hrn-une:hover .hrn-une__lire svg {
      transform: none;
    }
  }
</style>

<script>
  // Filtrage par thème et recherche sur les titres, combinés : un article
  // s'affiche s'il est du thème choisi ET que son titre contient la saisie.
  // La recherche ignore les accents et la casse (« reunion » trouve
  // « réunion »).
  let ac: AbortController | undefined;

  const normaliser = (texte: string) => texte.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();

  function initListeBlog() {
    ac?.abort();
    ac = new AbortController();
    const { signal } = ac;

    const filtres = [...document.querySelectorAll<HTMLButtonElement>('.hrn-blog-filtre')];
    const items = [...document.querySelectorAll<HTMLElement>('.hrn-blog-grille__item')];
    const une = document.querySelector<HTMLElement>('[data-une]');
    const sectionUne = une?.closest<HTMLElement>('section') ?? null;
    const vide = document.querySelector<HTMLElement>('#blog-vide');
    const titreVide = document.querySelector<HTMLElement>('#blog-vide-titre');
    const reprise = document.querySelector<HTMLButtonElement>('#blog-reset');
    const champ = document.querySelector<HTMLInputElement>('#blog-recherche');
    if (filtres.length === 0 || !vide) return;

    let theme = 'Tout';
    let recherche = '';

    const garde = (el: HTMLElement) =>
      (theme === 'Tout' || el.dataset.category === theme) &&
      (recherche === '' || normaliser(el.dataset.titre ?? '').includes(recherche));

    const appliquer = () => {
      let dansLaGrille = 0;
      for (const item of items) {
        const visible = garde(item);
        item.hidden = !visible;
        if (visible) dansLaGrille++;
      }

      // L'article à la une suit les deux filtres lui aussi.
      const uneVisible = une ? garde(une) : false;
      if (sectionUne) sectionUne.hidden = !uneVisible;

      // L'état vide se décide sur la seule grille. Le compter avec la une le
      // rendrait inatteignable quand la une est le seul résultat (piège n°10).
      vide.hidden = dansLaGrille > 0;
      if (titreVide) {
        titreVide.textContent = uneVisible
          ? "Le seul article correspondant est en haut de page"
          : recherche
            ? 'Aucun article ne correspond à cette recherche'
            : 'Aucun article pour ce thème';
      }
    };

    const choisirTheme = (nom: string) => {
      theme = nom;
      filtres.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.category === nom)));
    };

    filtres.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          choisirTheme(btn.dataset.category ?? 'Tout');
          appliquer();
        },
        { signal },
      );
    });

    champ?.addEventListener(
      'input',
      () => {
        recherche = normaliser(champ.value);
        appliquer();
      },
      { signal },
    );

    reprise?.addEventListener(
      'click',
      () => {
        choisirTheme('Tout');
        recherche = '';
        if (champ) champ.value = '';
        appliquer();
      },
      { signal },
    );
  }

  document.addEventListener('astro:page-load', initListeBlog);
  document.addEventListener('astro:before-swap', () => ac?.abort());
</script>
