---
// Page « Automatisation IA ». Sous-page d'offre, jumelle de /formation : même
// hero, même déroulé en étapes, même bloc de tarif, même pont vers l'autre
// offre. Ne restent propres à cette page que les tâches visées et le choix
// des outils.
//
// Cette page remplace l'ancienne /systemes, qui n'était liée que depuis le
// pied de page et couvrait le même sujet sans jamais parler du prix. Les deux
// auraient été en concurrence sur les mêmes recherches. La grille des trois
// systèmes est reprise telle quelle ici, et netlify.toml renvoie /systemes en
// 301 vers cette adresse (règle placée AVANT l'attrape-tout, sinon elle ne
// s'appliquerait jamais, voir le piège n°8 bis).
//
// Aucun contenu inventé : les six tâches viennent du carrousel « Le constat »
// de l'accueil, le déroulé vient de la FAQ et des points de la carte d'offre,
// les prix sont ceux affichés sur l'accueil. Le moteur d'automatisation est
// n8n, auto-hébergé sur le serveur d'Hérone : c'est ce qui permet de dire
// qu'aucun éditeur ne voit passer les données du client, et c'est l'argument
// le plus fort de la page. Make et Zapier restent cités comme solutions de
// repli quand les outils du client l'imposent, mais ce sont des services en
// ligne : ils verraient les données. L'ordre des deux phrases n'est donc pas
// cosmétique.
//
// Le seul JavaScript de la page est celui des témoignages (façade YouTube),
// porté par le composant lui-même.
import Layout from '../layouts/Layout.astro';
import OffreHero from '../components/offre/OffreHero.astro';
import OffreEtapes from '../components/offre/OffreEtapes.astro';
import OffreTarif from '../components/offre/OffreTarif.astro';
import OffreFaq from '../components/offre/OffreFaq.astro';
import OffrePont from '../components/offre/OffrePont.astro';
import ConstatCarousel from '../components/home/ConstatCarousel.astro';
import LogosMarquee from '../components/home/LogosMarquee.astro';
import SystemsGrid from '../components/home/SystemsGrid.astro';
import ProofSection from '../components/home/ProofSection.astro';

// Espaces insécables construits par leur point de code, jamais posés en clair
// dans le fichier (piège n°7). Voir l'en-tête de formation.astro pour le
// détail de la mesure qui a fait choisir la fine avant « HT ».
const F = String.fromCodePoint(0x202f);
const EUR = String.fromCodePoint(0x20ac);

const PRIX_MISE_EN_PLACE = `2${F}000${F}${EUR}${F}HT`;
const PRIX_FORMATION = `1${F}500${F}${EUR}${F}HT`;

// Les six tâches visées, reprises mot pour mot du carrousel « Le constat » de
// la page d'accueil : c'est un contenu déjà validé, il ne doit pas diverger
// entre les deux endroits.
const taches = [
  {
    quand: 'chaque jour',
    titre: "Ressaisie d'un logiciel à l'autre",
    texte: "Les mêmes informations recopiées d'un outil à un autre, avec le risque d'erreur à chaque fois.",
  },
  {
    quand: 'à chaque variante',
    titre: 'Devis recalculés dans Excel',
    texte: "Des feuilles dupliquées, une formule oubliée, et la marge qui saute sans qu'on le voie.",
  },
  {
    quand: 'après chaque réunion',
    titre: 'Comptes rendus retapés à la main',
    texte: 'Une à deux heures de rédaction après le rendez-vous, et des détails qui filent.',
  },
  {
    quand: 'chaque fin de mois',
    titre: 'Reporting mensuel refait',
    texte: 'Une journée à rassembler des chiffres épars, prêts trop tard pour décider.',
  },
  {
    quand: 'dossier par dossier',
    titre: 'Documents envoyés un par un',
    texte: 'Le même envoi répété à la main, client après client, sans traçabilité.',
  },
  {
    quand: 'au quotidien',
    titre: 'Mails et pièces à trier',
    texte: 'Des heures à ranger, transférer et classer ce qui arrive dans la boîte.',
  },
];

// Questions propres à l'automatisation. Les deux premières lèvent le frein de
// la dépendance, qui est le vrai sujet d'un dirigeant devant un prestataire
// technique : à qui appartient le système, et que se passe-t-il si on arrête.
const questions = [
  {
    q: 'À qui appartient le système ?',
    r: "À vous. Le jour où nous arrêtons de travailler ensemble, nous installons le système chez vous, en local, et il continue de tourner. Les évolutions sont alors à votre charge, mais vous ne repartez pas les mains vides. C'est voulu : personne ne devrait rester chez un prestataire faute de pouvoir en partir.",
  },
  {
    q: 'Le suivi mensuel est-il un engagement ?',
    r: "Au mois, non : ni vous ni nous ne sommes tenus, chacun peut arrêter. À l'année, oui, et dans les deux sens : nous nous engageons à rester à vos côtés douze mois, et vous ne pouvez pas vous retrouver sans interlocuteur du jour au lendemain. C'est ce que choisissent les entreprises pour qui le système est devenu critique. Nous en parlons au moment d'écrire le périmètre.",
  },
  {
    q: 'Et si je change de logiciel ?',
    r: "Un changement courant est absorbé par le suivi mensuel : nous rebranchons le système sur le nouvel outil. Une refonte lourde sort de ce cadre et fait l'objet d'un périmètre à part, écrit et chiffré comme le premier. La limite est posée par écrit avant de démarrer, elle ne se découvre pas en route.",
  },
  {
    q: 'Mes données passent-elles par un prestataire extérieur ?',
    r: "Le moteur qui fait tourner vos automatisations est une solution open source hébergée sur notre propre serveur : aucun éditeur d'automatisation ne voit passer vos données, et nous ne sous-traitons à personne. Quand une étape fait appel à l'intelligence artificielle, en revanche, le contenu traité est transmis au moteur d'IA retenu. Nous vous disons lequel et ce qui lui est envoyé avant de démarrer, et c'est écrit dans le périmètre.",
  },
];

// Le déroulé d'un projet, repris de la réponse « Comment se déroule un projet »
// de la FAQ et des trois points de la carte d'offre.
const deroule = [
  {
    num: '01',
    titre: "L'échange découverte",
    meta: '30 minutes, gratuit',
    texte: `Vous décrivez votre quotidien, nous repérons ce qui peut être retiré des mains de vos équipes. Sans engagement, et sans que rien ne soit encore décidé. C'est aussi là que nous disons quand une automatisation ne vaut pas le coup.`,
  },
  {
    num: '02',
    titre: 'Le périmètre écrit',
    meta: 'avant de démarrer',
    texte: `Nous posons noir sur blanc ce que le système fera, ce qu'il ne fera pas, et son prix. Ferme. Rien ne commence avant votre accord sur ce document, et il ne bouge plus ensuite.`,
  },
  {
    num: '03',
    titre: 'La conception, validée par vous',
    texte: `Nous vous montrons le fonctionnement prévu avant de construire quoi que ce soit. Un système validé sur le papier ne se découvre pas le jour de la livraison, et les corrections coûtent une conversation au lieu d'une semaine.`,
  },
  {
    num: '04',
    titre: "L'installation et la prise en main",
    meta: 'chez vous',
    texte: `Nous venons brancher le système sur vos outils, puis nous formons les personnes qui s'en serviront, jusqu'à ce que ça tourne sans nous. Comptez 1 à 4 semaines entre le périmètre signé et le système en service.`,
  },
  {
    num: '05',
    titre: 'Le suivi mensuel',
    meta: 'une fois en service',
    texte: `Surveillance du système, correctifs en cas de dysfonctionnement, améliorations quand vos outils évoluent, et notre présence dans les meilleurs délais dès qu'un besoin surgit. Vos équipes gardent toujours la possibilité de reprendre la main.`,
  },
];
---

<Layout
  title="Automatisation IA pour TPE et PME, en Vendée | Hérone"
  description={`Nous relions les logiciels que vous utilisez déjà pour supprimer les ressaisies. Périmètre écrit, prix ferme, livré en 1 à 4 semaines. À partir de ${PRIX_MISE_EN_PLACE}. Les Herbiers, Vendée.`}
  headerTheme="dark"
>
  <OffreHero
    eyebrow="Automatisation IA"
    titre="Vos logiciels se parlent. Plus aucune ressaisie"
    lede="Nous relions les outils que vous utilisez déjà pour que l'information circule seule, d'un logiciel à l'autre. Rien à remplacer, rien à réapprendre, et un périmètre écrit avec son prix ferme avant que nous démarrions."
    faits={[
      { cle: 'Sans changer vos logiciels', valeur: 'Nous connectons ceux que vous avez déjà.' },
      { cle: 'Livré en 1 à 4 semaines', valeur: 'Périmètre écrit et prix ferme avant de démarrer.' },
      { cle: 'Chez vous', valeur: 'Dans un rayon de 45 minutes autour des Herbiers.' },
      { cle: `À partir de ${PRIX_MISE_EN_PLACE}`, valeur: 'Un suivi mensuel prend ensuite le relais, chiffré avec vous.' },
    ]}
    lienHref="#tarif"
    lienLabel="Voir le tarif"
  />

  {/* « Le constat » ouvre la page depuis le 22 septembre 2026 : les six tâches
      faites à la main viennent avant celles que nous visons. La section était
      sur la page d'accueil. Elle est posée sur fond surface pour tenir
      l'alternance : le hero est sombre, la section suivante est sur papier. */}
  <ConstatCarousel fond="surface" />

  <section class="hrn-auto-taches hrn-zone-bleue">
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">Ce que nous visons</div>
      <h2>Les tâches que quelqu'un fait encore à la main</h2>
      <p class="hrn-lede">
        Vous en reconnaissez au moins une chez vous. Ce sont celles qui reviennent, qui ne demandent
        aucun jugement, et qui coûtent des heures chaque semaine.
      </p>

      <ul class="hrn-auto-taches__grid" role="list">
        {taches.map((t) => (
          <li class="hrn-auto-tache">
            <span class="hrn-auto-tache__quand">{t.quand}</span>
            <h3>{t.titre}</h3>
            <p>{t.texte}</p>
          </li>
        ))}
      </ul>

      <p class="hrn-auto-note">
        Une tâche qui demande du jugement, la relation client, ou la responsabilité de ce qui sort de
        l'entreprise, nous ne l'automatisons pas. Nous le disons dès l'échange découverte.
      </p>
    </div>
  </section>

  <SystemsGrid fond="surface" />

  <OffreEtapes
    eyebrow="Comment ça se passe"
    titre="Du premier appel au système en service"
    lede="Cinq étapes, dans cet ordre, et vous validez chacune avant de passer à la suivante."
    etapes={deroule}
    fond="paper"
    id="deroule"
  />

  <section class="hrn-auto-outils">
    <div class="hrn-section-inner">
      <div class="hrn-auto-outils__grid">
        <div class="hrn-auto-outils__col">
          <div class="hrn-eyebrow">Nos outils</div>
          <h2>Avec quoi nous construisons</h2>
          <p class="hrn-lede">
            Nous construisons vos automatisations sur n8n, une solution open source que nous
            hébergeons sur notre propre serveur. Aucun éditeur d'automatisation ne voit donc passer
            vos données. Quand vos outils l'imposent, nous savons aussi travailler avec Make ou
            Zapier : le choix est discuté avec vous et écrit dans le périmètre. Pas de frais cachés,
            pas d'abonnement captif.
          </p>
        </div>
        <div class="hrn-auto-outils__col">
          <div class="hrn-eyebrow">Vos outils</div>
          <h2>Ce que nous connectons</h2>
          <p class="hrn-lede">
            Nous construisons autour de l'existant : CRM, tableur, messagerie, comptabilité,
            logiciel métier. Le système les relie plutôt que de les remplacer.
          </p>
          <a href="#logiciels" class="hrn-auto-outils__link">
            Voir les logiciels que nous connectons
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* La liste des logiciels vient de la page d'accueil, et se pose ici juste
      après « Ce que nous connectons », qui y renvoyait déjà par un lien. Fond
      papier, entre deux sections sur surface. */}
  <LogosMarquee fond="paper" />

  <ProofSection fond="surface" eyebrow="La preuve" titre="Deux systèmes, filmés chez nos clients" />

  <OffreTarif
    titre="Affiché, comme tout le reste"
    regles={[
      { label: 'Mise en place', prix: PRIX_MISE_EN_PLACE, detail: "À partir de. Conception, installation et formation de l'équipe. Le montant dépend du nombre de flux et des logiciels à relier." },
    ]}
    inclus="Le périmètre et le prix sont écrits avant que nous démarrions, et le prix est ferme. Un suivi mensuel prend ensuite le relais, pour la surveillance et les correctifs : nous le chiffrons avec vous au rendez-vous, il dépend de ce que le système demande. En fonction de la complexité, du nombre d'outils à relier et de la taille de l'entreprise, un projet peut monter à plusieurs milliers d'euros : c'est justement ce que l'échange de trente minutes permet de savoir, sans engagement."
  />

  <OffreFaq
    titre="Ce que les dirigeants nous demandent avant de signer"
    questions={questions}
    fond="surface"
  />

  <OffrePont
    titre="Et si vos équipes savaient déjà quoi automatiser&#8239;?"
    texte={`Une journée de formation à l'IA leur apprend à repérer elles-mêmes les tâches qui valent la peine, et à s'en servir au quotidien. Beaucoup commencent par là : les automatisations qui suivent sont mieux ciblées. À partir de ${PRIX_FORMATION} la journée.`}
    liens={[
      { href: '/formation', label: "Voir l'offre de formation IA" },
      { href: '/#offres', label: 'Comparer les deux offres et leurs prix' },
    ]}
  />
</Layout>

<style>
  /* --------------------------------------------------- Tâches visées */
  .hrn-auto-taches {
    padding: var(--section-y) 0;
    background: var(--paper);
  }

  .hrn-auto-taches .hrn-lede {
    margin-top: 16px !important;
  }

  /* minmax(min(…, 100%), 1fr) et non minmax(280px, 1fr) : sur un écran de
     320px, une piste fixe plus large que le conteneur déborde et pousse toute
     la page en défilement horizontal (piège n°1 du projet). */
  .hrn-auto-taches__grid {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 28px;
  }

  .hrn-auto-tache {
    min-width: 0;
    padding-top: 18px;
    border-top: 2px solid var(--amber-500);
  }

  .hrn-auto-tache__quand {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hrn-auto-tache h3 {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-weight: var(--weight-titre);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    letter-spacing: var(--tracking-titre);
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-auto-tache p {
    margin-top: 10px !important;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-auto-note {
    margin-top: 34px !important;
    max-width: 78ch;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------- Outils */
  .hrn-auto-outils {
    padding: var(--section-y) 0;
    background: var(--surface);
  }

  .hrn-auto-outils__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .hrn-auto-outils__col {
    min-width: 0;
  }

  .hrn-auto-outils__col h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .hrn-auto-outils__col .hrn-lede {
    margin-top: 14px !important;
  }

  .hrn-auto-outils__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-weight: 600;
    font-size: 15px;
    color: var(--label);
  }
</style>
