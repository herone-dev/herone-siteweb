---
// Page « Formation IA en entreprise ».
//
// Contenu repris du curriculum interne (Formation IA Claude, version 2 du
// 8 septembre 2026) : durées, nombre d'ateliers, six livrables et cadre des
// quatre D viennent tous de ce document. Rien n'y est inventé. Le curriculum
// étant en cours de révision, les chiffres précis (7 h 15, 4 h 15, les durées
// de section) sont regroupés dans le tableau `deroule` ci-dessous et dans la
// constante DUREE_* : une révision du programme ne demande de toucher qu'ici.
//
// Aucun JavaScript sur cette page : pas de carrousel, pas d'apparition au
// défilement. C'est une page de lecture, elle doit être instantanée.
//
// Espaces insécables écrits en échappement explicite, jamais en littéral : le
// shell et certains éditeurs les reconvertissent en espaces ordinaires, et le
// prix perdrait alors sa typographie (piège n°7 du projet).
//   F = U+202F, espace FINE insécable : séparateur de milliers, avant l'euro
//       et avant « HT ». Mesurée à 8,7px dans IBM Plex Mono à 30px, contre
//       17,7px pour l'insécable ordinaire : avec cette dernière, « HT » se
//       détachait visiblement du montant.
//   I = U+00A0, espace insécable : durées seulement (« 7 h 15 », « 30 min »)
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const F = '\u202f';
const I = '\u00a0';

const PRIX_JOUR = `1${F}500${F}€${F}HT`;
const PRIX_PERSONNE = `500${F}€${F}HT`;
const DUREE_NETTE = `7${I}h${I}15`;
const DUREE_ATELIER = `4${I}h${I}15`;
const DUREE_TOTALE = `8${I}h${I}45`;

// Les trois règles qui commandent le découpage de la journée.
const principes = [
  {
    titre: 'La main d\'abord',
    texte: `Chacun exécute sa tâche à la main dans la première demi-heure, chronomètre en marche, avant d'avoir vu l'outil. Ce résultat et ce temps sont l'étalon de la journée. Le soir, la même tâche est refaite avec l'IA et les deux se comparent. Sans cette mesure de départ, la comparaison finale n'existe pas.`,
  },
  {
    titre: 'La méthode avant le paramétrage',
    texte: `Les projets, les compétences et les connecteurs sont la partie la plus lourde de la journée. Ils n'arrivent qu'après, une fois que chacun a trié ses tâches et écrit un prompt qui tient. Configurer avant d'avoir un usage produit une visite guidée du produit, pas une compétence.`,
  },
  {
    titre: 'Un livrable par section',
    texte: `Chaque bloc se termine par une chose écrite que le participant emporte. Ce qui n'est pas écrit ne survit pas à la semaine suivante.`,
  },
];

// Le déroulé, tel qu'il est minuté dans le curriculum. Les durées sont celles
// du contenu net, pauses exclues.
const deroule = [
  {
    num: '01',
    titre: 'Ouverture',
    duree: `30${I}min`,
    texte: `Chacun choisit la tâche qu'il refait le plus souvent, celle qui lui pèse le plus, et l'exécute à la main pendant quinze minutes chrono. Le résultat est conservé : c'est l'étalon auquel la fin de journée sera comparée.`,
  },
  {
    num: '02',
    titre: 'Fondamentaux de l\'IA',
    duree: `30${I}min`,
    texte: `Comment elle fonctionne, en quoi elle diffère des logiciels habituels, ce qu'elle fait bien et où elle casse. Les quatre limites sont posées ici, une fois pour toutes, et un axe affiché au mur sert de repère toute la journée.`,
  },
  {
    num: '03',
    titre: 'Prise en main de l\'outil',
    duree: `35${I}min`,
    texte: `Chacun sur son poste. L'interface, le premier message envoyé, les différentes portes d'entrée selon les métiers présents. Les comptes sont créés et les accès distribués avant la session : la journée commence sur du travail, pas sur de l'installation.`,
  },
  {
    num: '04',
    titre: 'Les quatre D',
    duree: `3${I}h`,
    texte: `Déléguer, décrire, discerner, être diligent. Le cœur de la journée : trier ses tâches réelles entre ce qu'on garde et ce qu'on confie, écrire un prompt qui tient en quatre passes successives, repérer ce qui doit être vérifié, puis décider ce qui entre dans l'outil et ce qui n'y entre jamais. La présence du dirigeant est nécessaire sur ce dernier point : c'est lui qui tranche.`,
  },
  {
    num: '05',
    titre: 'Mise en pratique',
    duree: `2${I}h${I}05`,
    texte: `Tout le paramétrage est ici, et nulle part ailleurs : les projets et leur base de connaissances, les livrables retravaillés en direct, les connecteurs branchés sur vos propres outils, et le point de bascule de la journée, la transformation de son prompt en compétence réutilisable. Puis les tâches qui peuvent être automatisées, classées par gain de temps.`,
  },
  {
    num: '06',
    titre: 'Clôture et évaluation',
    duree: `35${I}min`,
    texte: `La tâche du matin, refaite avec l'IA, même chronomètre. Les deux résultats sont posés côte à côte. Puis un quiz noté de quinze questions, corrigé en salle, question par question : c'est le dernier moment d'apprentissage de la journée, et il sert d'évaluation des acquis.`,
  },
];

const livrables = [
  'La fiche fil rouge, avec la mesure avant et après',
  'Le continuum de capacités, commun à la salle',
  'La carte de délégation, en quatre colonnes',
  'Le prompt écrit et testé sur sa propre tâche',
  'La règle de vérification personnelle, en trois lignes',
  'La charte d\'usage de l\'entreprise, signée par le dirigeant',
];

// Trois exemples de facturation, calculés depuis la grille : plancher à
// 1 500 € HT jusqu'à trois personnes, puis 500 € HT par personne.
const exemples = [
  { qui: '3 personnes', prix: `1${F}500${F}€${F}HT` },
  { qui: '5 personnes', prix: `2${F}500${F}€${F}HT` },
  { qui: '10 personnes', prix: `5${F}000${F}€${F}HT` },
];
---

<Layout
  title="Formation IA en entreprise, en Vendée | Hérone"
  description={`Une journée de formation à l'IA dans vos locaux, animée à deux, sur vos vrais dossiers et sans prérequis technique. Six livrables emportés. À partir de ${PRIX_JOUR} la journée. Les Herbiers, Vendée.`}
  headerTheme="dark"
>
  <section class="hrn-fmt-hero">
    <div class="hrn-fmt-hero__dots" aria-hidden="true"></div>
    <div class="hrn-section-inner hrn-fmt-hero__content">
      <div class="hrn-eyebrow">Formation IA</div>
      <h1>Une journée pour rendre votre équipe autonome avec l'IA</h1>
      <p class="hrn-fmt-hero__lede">
        Nous venons dans vos locaux, à deux, et nous travaillons sur vos vrais dossiers. Pas de cas
        d'école, aucun prérequis technique. Le soir, chacun repart avec sa méthode écrite et sa
        première tâche à automatiser identifiée.
      </p>

      <ul class="hrn-fmt-facts" role="list">
        <li>
          <span class="hrn-fmt-facts__key">Une journée</span>
          <span class="hrn-fmt-facts__val">{DUREE_NETTE} net, environ {DUREE_TOTALE} avec les pauses</span>
        </li>
        <li>
          <span class="hrn-fmt-facts__key">Animée à deux</span>
          <span class="hrn-fmt-facts__val">Deux formateurs présents toute la journée</span>
        </li>
        <li>
          <span class="hrn-fmt-facts__key">Chez vous</span>
          <span class="hrn-fmt-facts__val">Dans un rayon de 45 minutes autour des Herbiers</span>
        </li>
        <li>
          <span class="hrn-fmt-facts__key">À partir de {PRIX_JOUR}</span>
          <span class="hrn-fmt-facts__val">La journée, jusqu'à 3 personnes</span>
        </li>
      </ul>

      <div class="hrn-fmt-hero__actions">
        <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
        <a href="#tarif" class="hrn-fmt-hero__link">
          Voir le tarif
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="hrn-fmt-principes">
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">Notre parti pris</div>
      <h2>Trois règles commandent cette journée</h2>
      <p class="hrn-lede">
        Une formation à l'IA qui se contente de faire visiter l'outil ne change rien au lundi
        suivant. Celle-ci est construite à l'envers.
      </p>

      <div class="hrn-fmt-principes__grid">
        {principes.map((p, i) => (
          <article class="hrn-fmt-principe">
            <span class="hrn-fmt-principe__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
          </article>
        ))}
      </div>

      <p class="hrn-fmt-note">
        La journée s'adresse à des professionnels en entreprise, sans prérequis technique. Elle est
        construite autour de Claude, l'assistant d'Anthropic, et s'appuie sur le cadre AI Fluency
        publié par Anthropic, cité comme tel en salle.
      </p>
    </div>
  </section>

  <section class="hrn-fmt-deroule" id="deroule">
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">Le déroulé</div>
      <h2>Ce qui se passe, heure par heure</h2>
      <p class="hrn-lede">
        {DUREE_NETTE} de contenu net, dont {DUREE_ATELIER} d'atelier sur vos propres dossiers. Plus
        de la moitié de la journée se passe donc les mains sur le clavier.
      </p>

      <ol class="hrn-fmt-steps" role="list">
        {deroule.map((etape) => (
          <li class="hrn-fmt-step">
            <div class="hrn-fmt-step__head">
              <span class="hrn-fmt-step__num">{etape.num}</span>
              <h3>{etape.titre}</h3>
              <span class="hrn-fmt-step__duree">{etape.duree}</span>
            </div>
            <p>{etape.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="hrn-fmt-livrables">
    <div class="hrn-section-inner">
      <div class="hrn-fmt-livrables__grid">
        <div class="hrn-fmt-livrables__intro">
          <div class="hrn-eyebrow">Ce que vous gardez</div>
          <h2>Six choses écrites, emportées le soir</h2>
          <p class="hrn-lede">
            Une journée de formation s'oublie. Une procédure écrite, non. Chaque participant repart
            avec ces six documents, produits par lui, sur son poste, pendant la journée.
          </p>
          <p class="hrn-fmt-note hrn-fmt-note--tight">
            L'entreprise, elle, repart avec deux listes de plus : les compétences restant à rédiger,
            avec un responsable et une date pour chacune, et les tâches à automatiser, classées par
            gain de temps.
          </p>
        </div>

        <ol class="hrn-fmt-livrables__list" role="list">
          {livrables.map((item, i) => (
            <li>
              <span class="hrn-fmt-livrables__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="hrn-fmt-tarif" id="tarif">
    <div class="hrn-section-inner">
      <div class="hrn-eyebrow">Le tarif</div>
      <h2>Affiché, comme tout le reste</h2>

      <div class="hrn-fmt-tarif__grid">
        <div class="hrn-fmt-tarif__regle">
          <p class="hrn-fmt-tarif__prix">{PRIX_JOUR}</p>
          <p class="hrn-fmt-tarif__detail">la journée, jusqu'à 3 personnes à former</p>
        </div>
        <div class="hrn-fmt-tarif__regle">
          <p class="hrn-fmt-tarif__prix">{PRIX_PERSONNE}</p>
          <p class="hrn-fmt-tarif__detail">par personne et par jour, dès 4 personnes</p>
        </div>
      </div>

      <ul class="hrn-fmt-tarif__exemples" role="list">
        {exemples.map((ex) => (
          <li>
            <span class="hrn-fmt-tarif__qui">{ex.qui}</span>
            <span class="hrn-fmt-tarif__montant">{ex.prix}</span>
          </li>
        ))}
      </ul>

      <p class="hrn-fmt-tarif__inclus">
        La préparation est comprise. Avant de venir, nous travaillons sur vos dossiers et sur vos
        métiers, pour que les exemples de la journée soient les vôtres.
      </p>

      <div class="hrn-fmt-tarif__actions">
        <Button variant="accent" size="lg" href="/#reserver">Réserver 30 minutes</Button>
        <span class="hrn-fmt-tarif__gratuit">Trente minutes d'échange, gratuit et sans engagement.</span>
      </div>
    </div>
  </section>

  <section class="hrn-fmt-suite">
    <div class="hrn-section-inner hrn-fmt-suite__inner">
      <div>
        <h2>Et ce que la journée aura identifié&#8239;?</h2>
        <p>
          Nous le construisons. Les tâches repérées comme automatisables deviennent des systèmes qui
          relient vos logiciels existants, à partir de 1&#8239;000&#8239;&euro;&#8239;HT, avec un
          suivi mensuel. Vous décidez après la formation, pas avant.
        </p>
      </div>
      <div class="hrn-fmt-suite__actions">
        <a href="/#offres" class="hrn-fmt-suite__link">
          Voir nos deux offres et leurs prix
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
        <a href="/systemes" class="hrn-fmt-suite__link">
          Les systèmes que nous installons
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero : même motif que /systemes et /blog, pour que les pages intérieures
     se ressemblent. Le padding haut laisse passer le header fixe de 68px. */
  .hrn-fmt-hero {
    position: relative;
    padding: clamp(104px, 11vw, 128px) 0 clamp(40px, 5vw, 56px);
    background: var(--slate-900);
    color: var(--ink-200);
    overflow: hidden;
  }

  .hrn-fmt-hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, #fff 7%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  .hrn-fmt-hero__content {
    position: relative;
  }

  .hrn-fmt-hero :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-fmt-hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--text-inverse);
    max-width: 18ch;
    margin: 14px 0 0;
    text-wrap: balance;
  }

  .hrn-fmt-hero__lede {
    margin-top: 18px !important;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-300);
    text-wrap: pretty;
  }

  /* minmax(min(…, 100%), 1fr) et non minmax(200px, 1fr) : sur un écran de
     320px, une piste fixe plus large que le conteneur déborde et pousse toute
     la page en défilement horizontal (piège n°1 du projet). */
  .hrn-fmt-facts {
    list-style: none;
    margin: 34px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--border-inverse);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 22px;
  }

  .hrn-fmt-facts li {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .hrn-fmt-facts__key {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text-inverse);
  }

  .hrn-fmt-facts__val {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink-300);
    text-wrap: pretty;
  }

  .hrn-fmt-hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .hrn-fmt-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    color: var(--amber-300);
  }

  /* ------------------------------------------------------- Parti pris */
  .hrn-fmt-principes {
    padding: var(--section-y) 0;
    background: var(--paper);
  }

  .hrn-fmt-principes .hrn-lede {
    margin-top: 16px !important;
  }

  .hrn-fmt-principes__grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 28px;
  }

  .hrn-fmt-principe {
    min-width: 0;
    padding-top: 18px;
    border-top: 2px solid var(--amber-500);
  }

  .hrn-fmt-principe__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--ink-400);
  }

  .hrn-fmt-principe h3 {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.7vw, 1.35rem);
    letter-spacing: -0.015em;
    color: var(--text-strong);
    text-wrap: balance;
  }

  .hrn-fmt-principe p {
    margin-top: 10px !important;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hrn-fmt-note {
    margin-top: 34px !important;
    max-width: 78ch;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .hrn-fmt-note--tight {
    margin-top: 22px !important;
  }

  /* ---------------------------------------------------------- Déroulé */
  .hrn-fmt-deroule {
    padding: var(--section-y) 0;
    background: var(--surface);
    scroll-margin-top: 68px;
  }

  .hrn-fmt-deroule .hrn-lede {
    margin-top: 16px !important;
  }

  .hrn-fmt-steps {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .hrn-fmt-step {
    padding: 22px 0;
    border-top: 1px solid var(--border);
  }

  .hrn-fmt-step:last-child {
    border-bottom: 1px solid var(--border);
  }

  /* Pas de white-space: nowrap sur le titre ni sur la durée : c'est ce qui a
     déjà poussé la page en défilement horizontal ailleurs sur le site. La
     durée reste insécable par ses espaces U+00A0, ce qui suffit. */
  .hrn-fmt-step__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
  }

  .hrn-fmt-step__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--amber-600);
  }

  .hrn-fmt-step__head h3 {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }

  .hrn-fmt-step__duree {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--ink-500);
  }

  .hrn-fmt-step p {
    margin-top: 10px !important;
    max-width: 82ch;
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------- Livrables */
  .hrn-fmt-livrables {
    padding: var(--section-y) 0;
    background: var(--paper);
  }

  .hrn-fmt-livrables__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .hrn-fmt-livrables__intro {
    min-width: 0;
  }

  .hrn-fmt-livrables__intro .hrn-lede {
    margin-top: 16px !important;
  }

  .hrn-fmt-livrables__list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .hrn-fmt-livrables__list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  .hrn-fmt-livrables__num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--amber-600);
  }

  /* ------------------------------------------------------------ Tarif */
  .hrn-fmt-tarif {
    padding: var(--section-y) 0;
    background: var(--slate-900);
    scroll-margin-top: 68px;
  }

  .hrn-fmt-tarif :global(.hrn-eyebrow) {
    color: var(--amber-300);
  }

  .hrn-fmt-tarif h2 {
    color: var(--text-inverse);
  }

  .hrn-fmt-tarif__grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 24px;
  }

  .hrn-fmt-tarif__regle {
    min-width: 0;
    padding: 24px;
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Le montant ne casse jamais au milieu : ses espaces sont insécables. Il
     n'y a pas de white-space: nowrap, qui ferait déborder la carte en étroit. */
  .hrn-fmt-tarif__prix {
    margin: 0;
