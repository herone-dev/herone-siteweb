---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import ConstatCarousel from '../components/home/ConstatCarousel.astro';
import SystemsGrid from '../components/home/SystemsGrid.astro';
import LogosMarquee from '../components/home/LogosMarquee.astro';
import ProofSection from '../components/home/ProofSection.astro';
import ConvictionSection from '../components/home/ConvictionSection.astro';
import MethodSection from '../components/home/MethodSection.astro';
import FoundersSection from '../components/home/FoundersSection.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import BookingSection from '../components/home/BookingSection.astro';
---

<Layout
