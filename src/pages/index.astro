---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import PresentationVideo from '../components/home/PresentationVideo.astro';
// L'éventail de cartes a été remplacé par « les deux portes » (handoff Claude
// Design, bloc 1f). OffersSection.astro reste intact sur le disque : une ligne
// à réimporter ici suffit à le remettre, avec son compteur à rouleaux, son
// balayage tactile et son étape de comparaison.
// Les deux portes passent en écran partagé (22 septembre 2026, d'après la page
// d'accueil de Leed Agency). PortesSection.astro reste intact sur le disque :
// le réimporter ici à la place de PortesDuo remet les deux cartes avec prix.
import PortesDuo from '../components/home/PortesDuo.astro';
import ProofSection from '../components/home/ProofSection.astro';
import ReviewsSection from '../components/home/ReviewsSection.astro';
import ConvictionSection from '../components/home/ConvictionSection.astro';
import FoundersSection from '../components/home/FoundersSection.astro';
import FaqAccordion from '../components/home/FaqAccordion.astro';
import BookingSection from '../components/home/BookingSection.astro';

---

<Layout
  title="Hérone | Formation IA en entreprise et automatisation, Vendée"
  description="Nous formons vos équipes à l'IA en une journée, chez vous, et nous automatisons vos tâches répétitives. TPE et PME de Vendée. Prix affichés, à partir de 1 500 € HT."
  headerTheme="dark"
>
  <Hero />
  <PresentationVideo />
  <PortesDuo
    lede="Cliquez sur l'offre qui vous parle : vous y trouverez le déroulé complet, ce que vous obtenez, et le tarif affiché."
    portes={[
      {
        num: '01',
        titre: 'Formation IA',
        promesse: 'Nous formons votre équipe sur ses vrais dossiers, chez vous, en une journée.',
        href: '/formation',
        lien: 'Voir la journée en détail',
      },
      {
        num: '02',
        titre: 'Automatisation IA',
        promesse: 'Vos logiciels se parlent. Plus aucune ressaisie.',
        href: '/automatisation',
        lien: 'Voir le déroulé en détail',
      },
    ]}
  />
  <ProofSection />
  <ReviewsSection />
  <ConvictionSection />
  <FoundersSection />
  <FaqAccordion />
  <BookingSection />
</Layout>
